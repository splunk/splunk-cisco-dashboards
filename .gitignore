# Repository root allowlist.
#
# Root-level files are local unless explicitly listed here. Directories remain
# visible so their own tracked source files and the rules below still apply.
/*
!/*/
!/.gitignore
!/.npmrc
!/AGENTS.md
!/LICENSE
!/NOTICE
!/README.md
!/VERSION
!/build.sh
!/package.json
!/yarn.lock

# Local workspace and repository-only reference material.
/.claude/
/.cursor/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/reserve-build-number.yml
/.vscode/
/artifacts/
/docs/
/icons/
/packages/splunk-cisco-dashboards/docs/
/packages/splunk-cisco-dashboards/test/*
!/packages/splunk-cisco-dashboards/test/dashboardTimeInputs.test.cjs
!/packages/splunk-cisco-dashboards/test/operationsQualification.test.cjs
!/packages/splunk-cisco-dashboards/test/expandableSearchExample.test.cjs
!/packages/splunk-cisco-dashboards/test/catalystConsolidation.test.cjs
/tests/

# Operating-system, editor, and document artifacts.
.DS_Store
*.xlsx
*.pptx

# Splunk runtime and maintenance output.
local/
local.meta
*.conf.bak
backups/

# JavaScript dependencies, build output, and caches.
node_modules/
output/
dist/
build/
.cache/
.parcel-cache/
.eslintcache
coverage/
*.tsbuildinfo
yarn-error.log
npm-debug.log*

# Python environments, caches, and test output.
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# Local secrets, logs, installer state, and scratch output.
.env
.env.*
*.log
.pypirc
pip-log.txt
pip-delete-this-directory.txt
/.tmp/
/tmp/
/site/
/splunk-user-guide-builder
