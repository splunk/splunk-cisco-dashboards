# Track only the essential repository entry files at the root.
/*
!/*/
!/.gitignore
!/.npmrc
!/LICENSE
!/NOTICE
!/README.md
!/VERSION
!/build.sh
!/package.json
!/yarn.lock

# Local editor, automation, documentation, and generated content.
.DS_Store
/.vscode/
/.cursor/
/.github/
/docs/
/packages/splunk-cisco-dashboards/docs/
/tests/
/packages/splunk-cisco-dashboards/test/
/artifacts/
/icons/
*.xlsx
*.pptx

# Keep non-build repository scripts local. build.sh requires these two.
/scripts/*
!/scripts/format_searchbase_conf.py
!/scripts/lint_spl_antipatterns.py

# Splunk runtime and maintenance output.
local/
local.meta
*.conf.bak
backups/

# JavaScript dependencies, build output, and caches.
node_modules/
output/
dist/
build/
.cache/
.parcel-cache/
.eslintcache
coverage/
*.tsbuildinfo
yarn-error.log
npm-debug.log*

# Python environments, caches, and test output.
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# Local secrets, logs, installer state, and scratch output.
.env
*.log
.pypirc
pip-log.txt
pip-delete-this-directory.txt
/.tmp/
/tmp/
/site/
