.DS_Store
.vscode

# Ignore Cursor local state (transcripts, history, settings) but keep
# project-shared rules and skills tracked so team guidance ships with
# the repo.
# NOTE: must use `.cursor/*` (not `.cursor/`) so git still descends
# into the directory and honors the negation patterns below. Parent-
# directory exclusion would otherwise block re-inclusion of children.
.cursor/*
!.cursor/rules/
!.cursor/rules/**
!.cursor/skills/
!.cursor/skills/**

### Splunk local folders
local/
local.meta

### Conf backups created by maintenance scripts (e.g. trueup_savedsearches.py)
*.conf.bak
backups/

### UCC UI extensions
yarn-error.log
node_modules/
output/

### React build artifacts
dist/
build/
.cache/
.parcel-cache/
*.tsbuildinfo
npm-debug.log*

### Webpack/Babel
.eslintcache
coverage/

### Python template
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# Django stuff:
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# Flask stuff:
instance/
.webassets-cache

# Sphinx documentation
docs/_build/

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/


# mkdocs documentation
/site

