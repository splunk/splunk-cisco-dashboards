# Operating-system, editor, and document artifacts.
.DS_Store
*.xlsx
*.pptx

# Splunk runtime and maintenance output.
local/
local.meta
*.conf.bak
backups/

# JavaScript dependencies, build output, and caches.
node_modules/
output/
dist/
build/
.cache/
.parcel-cache/
.eslintcache
coverage/
*.tsbuildinfo
yarn-error.log
npm-debug.log*

# Python environments, caches, and test output.
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# Local secrets, logs, installer state, and scratch output.
.env
.env.*
*.log
.pypirc
pip-log.txt
pip-delete-this-directory.txt
/.tmp/
/tmp/
/site/
