# Repository root allowlist.
#
# Root-level files are local unless explicitly listed here. Directories remain
# visible so their own tracked source files and the rules below still apply.
/*
!/*/
!/.gitignore
!/.npmrc
!/LICENSE
!/NOTICE
!/README.md
!/VERSION
!/build.sh
!/package.json
!/yarn.lock

# Local workspace and repository-only reference material.
/.claude/
/.cursor/
/.github/
/.vscode/
/artifacts/
/docs/
/icons/
/packages/splunk-cisco-dashboards/docs/
/packages/splunk-cisco-dashboards/test/*
!/packages/splunk-cisco-dashboards/test/agenticSocWorkspace.test.cjs
!/packages/splunk-cisco-dashboards/test/kpiPickerSearchContract.test.cjs
!/packages/splunk-cisco-dashboards/test/workspaceFocusRestoration.test.cjs
!/packages/splunk-cisco-dashboards/test/macroFieldPillsSui.test.cjs
!/packages/splunk-cisco-dashboards/test/kpiPickerOptionHelpContract.test.cjs
!/packages/splunk-cisco-dashboards/test/searchbaseSelfContainedAnomalies.test.cjs
!/packages/splunk-cisco-dashboards/test/adaptiveSearchbaseSpans.test.cjs
!/packages/splunk-cisco-dashboards/test/mltkProjectionOptimization.test.cjs
!/packages/splunk-cisco-dashboards/test/secureNetworkingAssuranceScore.test.cjs
!/packages/splunk-cisco-dashboards/test/secureNetworkingReactPillars.test.cjs
!/packages/splunk-cisco-dashboards/test/workspaceDelegatedCapability.test.cjs
