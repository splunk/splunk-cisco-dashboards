{
    "name": "splunk-cisco-dashboards-workspace",
    "version": "1.0.0",
    "private": true,
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "build": "lerna run build",
        "setup": "yarn && lerna run build",
        "start": "cd packages/splunk-cisco-dashboards && yarn start",
        "lint": "lerna run lint",
        "clean": "lerna run clean --parallel",
        "clean:build": "lerna run clean:build"
    },
    "devDependencies": {
        "lerna": "^4.0.0"
    }
}
