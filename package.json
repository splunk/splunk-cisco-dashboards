{
    "name": "splunk-cisco-dashboards-workspace",
    "version": "1.0.0",
    "license": "Apache-2.0",
    "private": true,
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "build": "yarn workspaces run build",
        "setup": "yarn && yarn workspaces run build",
        "start": "cd packages/splunk-cisco-dashboards && yarn start",
        "lint": "yarn workspaces run lint",
        "clean": "yarn workspaces run clean",
        "clean:build": "yarn workspaces run clean:build",
        "package:app": "cd packages/splunk-cisco-dashboards && yarn package:app",
        "postinstall": "patch-package --error-on-fail",
        "test": "node --test packages/splunk-cisco-dashboards/test/*.test.cjs && node scripts/test_build_deploy_contract.cjs"
    },
    "resolutions": {
        "qs": "^6.16.0",
        "form-data": "^2.5.4",
        "dompurify": "^3.4.16",
        "fast-uri": "^3.1.8",
        "brace-expansion": "^1.1.21",
        "braces": "3.0.3",
        "source-map-js": "^1.2.2",
        "postcss-selector-parser": "^7.1.6",
        "@babel/plugin-transform-modules-systemjs": "^7.29.4",
        "serialize-javascript": "^7.0.5",
        "jspdf": "^4.2.1",
        "crypto-js": "^4.2.0",
        "d3-color": "^3.1.0",
        "react": "18.3.1",
        "react-dom": "18.3.1",
        "@types/react": "18.3.31",
        "@types/react-dom": "18.3.7",
        "react-router": "^7.18.2",
        "@xmldom/xmldom": "0.8.15",
        "colord": "^2.9.4",
        "**/js-yaml": "^4.3.2",
        "maplibre-gl": "6.4.1"
    },
    "devDependencies": {
        "patch-package": "8.0.1"
    }
}
