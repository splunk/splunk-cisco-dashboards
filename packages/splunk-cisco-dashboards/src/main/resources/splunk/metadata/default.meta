
[]
access = read : [ * ], write : [ admin, sc_admin, power ]
export = none

[macros/dnac_site_normalize%281%29]
access = read : [ * ], write : [ admin, power, sc_admin ]
export = system

[insights_workspaces]
access = read : [ * ], write : [ admin, power, sc_admin ]
export = system

# Overview tile settings that must read the same for every viewer
# (Thresholds, Data Mapping, Drilldown) live in searchbase.conf's
# viz_options / drilldown_search_name fields. Deliberately narrower
# than the app-wide default above: only the `admin` role (which holds
# `admin_all_objects` by default) may write here. Splunk's ACL model
# also lets any user explicitly granted the `admin_all_objects`
# capability write regardless of this list, which is the intended
# escape hatch for a custom role that shouldn't otherwise be `admin`.
[searchbase]
access = read : [ * ], write : [ admin, sc_admin ]
export = system

