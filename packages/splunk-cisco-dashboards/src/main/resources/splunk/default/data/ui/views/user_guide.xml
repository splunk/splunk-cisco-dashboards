<?xml version="1.0"?>
<!--
    User Guide view for splunk-cisco-dashboards.

    This view follows the same React-mounted Simple XML pattern as
    admin_macro_index_tuning.xml:
      - Simple XML owns only the Splunk view shell.
      - user_guide_bootstrap.js loads the webpack bundle.
      - the bundle mounts into #scan-root.

    Keep version="1.1" for Splunk 9.x custom-JS dashboard support.
-->
<dashboard version="1.1" theme="dark" hideEdit="true" hideExport="true" hideTitle="true"
           script="user_guide_bootstrap.js">
    <label>User Guide</label>
    <description>Setup, operations, macro tuning, and troubleshooting for Splunk App for Secure Networking.</description>
    <row>
        <panel>
            <html>
                <div id="scan-root">
                    <div style="padding: 24px; color: #a6adb6; background: #0f1117;">Loading User Guide...</div>
                </div>
            </html>
        </panel>
    </row>
</dashboard>
