| stats latest(state) as "Operational State" latest(admin_state) as "Admin State" values(desc) AS "Description" values(eth_speed) AS "Speed" sparkline(avg(eth_inrate1_pkts)) AS "Input Rate Trend" sparkline(avg(eth_indiscard)) AS "Input Discard Trend" sparkline(avg(eth_inerr)) AS "Input Error Trend" sparkline(avg(eth_outrate1_pkts)) AS "Output Rate Trend" sparkline(avg(eth_outdiscard)) AS "Output Discard Trend" sparkline(avg(eth_outerr)) AS "Output Error Trend" by Device,Hostname,Interface

[dc_networking_physical_inventory_fabric_module]
search_name = DC Networking - Physical Inventory - Fabric Module
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-07-30 00:00:00
date_updated = 2026-07-30 00:00:00
category = Data Center Networking
sub_category = Controller & Site Inventory
tags = Cisco DC Networking,Cisco Nexus 9000
dispatch_context = cisco_dc_networking_app_for_splunk
dispatch_context_force = 0
default_viz = splunk.table
description = <p>Reports fabric module from the Cisco DC Networking <code>Physical Inventory</code> dashboard.</p>
explanation = <p>Runs curated SPL from this app with app-owned index scoping and only the required exported source knowledge objects. Dashboard-only filters are neutralized so the search runs independently.</p>
solution = <p>Use the result to identify affected data-center entities and correlate changes with related operational events.</p>
related_info = <ul><li><b>Provenance</b><br><code>cisco_dc_networking_app_for_splunk</code> / <code>inventory.xml</code>.</li><li><b>Customize for sibling entities</b><br>Swap the like(productid,"%-FM%") filter for like(desc,"%Ethernet%Module%") (line cards), like(productid,"%-SUP-%") OR like(productid,"%-vSUP%") (supervisor modules), or like(productid,"%-SC-%") (system controllers) to inventory that physical component type.</li></ul>
search = `phy_inventory_details`\
| where like(productid,"%-FM%")\
| eval n=replace(name,"([\w]+)\s([\d]+)","\2")\
| table hostname,Device,name,n,desc,serialnum,productid,"Hardware Version","Software Version",Status\
| rename hostname as Hostname desc AS Description serialnum AS "Serial Number" productid AS "Product ID" name AS Name\
| fields - n

