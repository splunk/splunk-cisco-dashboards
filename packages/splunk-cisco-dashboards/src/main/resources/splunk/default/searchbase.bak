[dc_networking_vmware_network_packets_per_host]
search_name = Data Center Networking - Network Packets In/Out per Host
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-08-04 00:00:00
date_updated = 2026-08-04 00:00:00
category = Data Center Networking
sub_category = VMware Integration
tags = Cisco DC Networking,VMware,vSphere,Network
dispatch_context = cisco_dc_networking_app_for_splunk
dispatch_context_force = 0
default_viz = splunk.bar
description = <p>Reports total inbound and outbound packet counts per ESXi host.</p>
explanation = <p>Sums <code>p_summation_net_packetsRx_number</code> and <code>p_summation_net_packetsTx_number</code> per host, giving a packet-rate view of network load distinct from byte-throughput metrics -- useful for spotting hosts handling disproportionately many small packets (a CPU-interrupt-overhead concern even when byte throughput looks moderate).</p>
solution = <p>A host with a packet count far above its peers, without a matching rise in byte throughput, suggests small-packet-heavy traffic (e.g. VoIP, health-check floods) that may need dedicated NIC/queue tuning.</p>
related_info = <ul><li><b>Provenance</b><br>Acme Labs demo dashboard, panel &quot;Network Packets In/Out per Host&quot;.</li><li><b>Ranking not preserved</b><br>The source panel's trailing <code>result ranking</code> was removed because house style forbids <code>result ranking</code> in a pipeline that also contains <code>stats</code>.</li></ul>
search = `index_dc` sourcetype=vmware:perf:net instance=aggregated\
| stats sum(p_summation_net_packetsRx_number) as packets_in sum(p_summation_net_packetsTx_number) as packets_out by moid

[dc_networking_vmware_network_dropped_errors]
search_name = Data Center Networking - Network Dropped Packets and Errors
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-08-04 00:00:00
date_updated = 2026-08-04 00:00:00
category = Data Center Networking
sub_category = VMware Integration
tags = Cisco DC Networking,VMware,vSphere,Network
dispatch_context = cisco_dc_networking_app_for_splunk
dispatch_context_force = 0
default_viz = splunk.table
description = <p>Lists only the ESXi hosts that are actually experiencing dropped packets or interface errors, with per-direction counts.</p>
explanation = <p>Sums <code>droppedRx</code>/<code>droppedTx</code> and <code>errorsRx</code>/<code>errorsTx</code> counters per host, then <code>where</code>-filters to rows with at least one non-zero count -- an anomaly-filtered triage view rather than a raw dump of every host's counters, so the panel only surfaces hosts that need attention.</p>
solution = <p>Any host appearing here has real network-adapter-level packet loss or errors; check physical NIC health, driver/firmware versions, and switch-side port statistics for the affected host.</p>
related_info = <ul><li><b>Provenance</b><br>Acme Labs demo dashboard, panel &quot;Network Dropped Packets and Errors&quot;.</li><li><b>Ranking not preserved</b><br>The source panel's trailing <code>result ranking</code> was removed because house style forbids <code>result ranking</code> in a pipeline that also contains <code>stats</code>.</li></ul>
search = `index_dc` sourcetype=vmware:perf:net instance=aggregated\
| stats sum(p_summation_net_droppedRx_number) as dropped_rx sum(p_summation_net_droppedTx_number) as dropped_tx sum(p_summation_net_errorsRx_number) as errors_rx sum(p_summation_net_errorsTx_number) as errors_tx by moid\
| where dropped_rx > 0 OR dropped_tx > 0 OR errors_rx > 0 OR errors_tx > 0

[it_health_composite_service_health_score]
search_name = IT Health - Overall Service Health
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-08-04 00:00:00
date_updated = 2026-08-04 00:00:00
category = IT Health
sub_category = Network Health
tags = Composite KPI,Cross-Domain,Executive,Network Health
dispatch_context = splunk-cisco-dashboards
dispatch_context_force = 1
default_viz = splunk.singlevalueradial
description = <p>Rolls up ThousandEyes availability, BGP prefix health, core interface state, firewall throughput/block posture, VMware host health, and ACI fabric health into a single executive service-health score.</p>
explanation = <p>Builds a synthetic per-minute time axis with <code>makeresults</code>/<code>addinfo</code>/<code>mvexpand</code> spanning the dispatch window, then <code>append</code>s six independently-scored branches -- ThousandEyes HTTP availability (<code>tstats</code> on <code>Cisco_ThousandEyes.Test_Metrics</code>), BGP prefix-accept health (<code>mstats</code>), core interface up/down state, firewall throughput+deny-rate KPI (reusing the same percentile-banding logic as <code>network_intelligence_firewall_composite_kpi</code>), VMware sustained-CPU-hot-streak health (reusing the pattern from <code>dc_networking_vmware_esx_server_farm</code>), and the full ACI composite health score (reusing the same weighted fusion as <code>dc_networking_aci_composite_health_score</code>) -- normalizes each branch to a <code>kpi</code>/<code>value</code> row pair, pivots with <code>xyseries</code>, defaults any missing branch to 100 via <code>foreach ... coalesce</code>, and averages all six into <code>service_health</code>. No stanza anywhere else in this catalog fuses six independent domains into one SLA-style number; this is worth harvesting for the cross-domain scoring architecture alone even before considering the individual sub-scores.</p>
solution = <p>Treat this as the top-of-dashboard executive indicator; when it drops, drill into whichever domain-specific composite or per-metric stanza in this catalog covers the affected branch (ThousandEyes availability, BGP prefix health, firewall KPI, VMware health, or ACI health) to find the root cause.</p>
related_info = <ul><li><b>Provenance</b><br>Acme Labs demo dashboard, panel &quot;Overall Service Health&quot;.</li><li><b>interface_details macro not locally defined</b><br>The core-connectivity branch depends on an <code>interface_details</code> macro that does not exist in this app's own <code>macros.conf</code> (this stanza's <code>dispatch_context</code> is <code>splunk-cisco-dashboards</code> itself, unlike the ACI-side stanzas which dispatch into the external DC Networking app). This macro would need to be added here, or that branch reworked against a locally-available interface-state source, before the full search will run without error.</li><li><b>Hardcoded lab values kept</b><br>The BGP branch's <code>neighbor_address=10.30.4.137</code> is a specific lab peer IP, kept as-is per the &quot;preserve the full pattern&quot; instruction; in production this should be parameterized (e.g. driven by a lookup of monitored peers) rather than hardcoded to one address.</li><li><b>Presort removed in the VMware branch</b><br>Same caveat as <code>dc_networking_vmware_esx_server_farm</code>: the source panel's <code>result ranking</code> ahead of <code>streamstats</code> was removed per house style, which may affect strict chronological fidelity of the sustained-hot-streak check.</li></ul>
search = | makeresults count=1\
| addinfo\
| eval start_epoch = info_min_time\
| eval end_epoch = info_max_time + 60\
| eval num_intervals = ceil((end_epoch - start_epoch) / 60)\
| eval dummy_index = mvrange(0, num_intervals)\
| mvexpand dummy_index\
| eval _time = start_epoch + (dummy_index * 60)\
| eval kpi="__axis__", value=100\
| append [| tstats `scd_summariesonly` avg(Test_Metrics.metric_name:http.server.request.availability) as th_avail FROM datamodel="Cisco_ThousandEyes.Test_Metrics" WHERE Test_Metrics.metric_name:http.server.request.availability="*" Test_Metrics.thousandeyes.test.type="http-server" BY _time | timechart span=1m avg(th_avail) as th | eval kpi="th", value=round(th,0) | table _time kpi value]\
| append [| mstats max("Cisco-IOS-XR-ipv4-bgp-oper:bgp/instances/instance/instance-active/vrfs/vrf/afs/af/neighbor-af-table/neighbor.af_data/prefixes_accepted") as prefixes_accepted WHERE `index_network` AND af_name="ipv4-unicast" span=1m BY neighbor_address, source | search source=* neighbor_address=10.30.4.137 | fields _time, prefixes_accepted | timechart span=1m latest(prefixes_accepted) as prefixes_accepted | eval kpi="bgp", value=if(round(prefixes_accepted,0)>=4,100,0) | table _time kpi value]\
| append [`interface_details` | search Device=* state=* admin_state=* eth_speed="*" | eval core_kpi_score1 = case(admin_state="up" AND state="up",100,true(),0) | timechart span=1m avg(core_kpi_score1) as core_kpi_score1 | eval kpi="core", value=round(core_kpi_score1,0) | table _time kpi value]\
| append [search `index_firewall` sourcetype=cisco:sfw:estreamer | eval act=lower(coalesce(AC_RuleAction,action)) | timechart span=1m count(eval(act="allow" OR act="allowed")) as allowed count(eval(act="block" OR act="deny" OR act="denied")) as denied sum(coalesce(bytes_in,bytes_out,ResponderBytes,InitiatorBytes,0)) as bytes_total | eval allowed=coalesce(allowed,0), denied=coalesce(denied,0), bytes_total=coalesce(bytes_total,0) | eventstats perc5(bytes_total) as p5 perc50(bytes_total) as p50 perc90(bytes_total) as p90 | eval deny_rate = if(allowed+denied>0, round(100*denied/(allowed+denied),2), 0) | eval throughput_score = case(bytes_total>=p90,100, bytes_total>=p50,85, bytes_total>=p5,70, true(),50) | eval block_score = case(deny_rate<=2,100, deny_rate<=5,85, deny_rate<=10,70, true(),50) | eval fw_kpi = round(max(1,min(100,0.6*throughput_score+0.4*block_score)),0) | eval kpi="fw", value=fw_kpi | table _time kpi value]\
| append [search `index_dc` sourcetype=vmware:perf:cpu instance=aggregated | bin _time span=1m | stats avg(p_average_cpu_usage_percent) as cpu by moid _time | streamstats window=15 sum(eval(cpu>=95)) as cpu_hot_15 by moid | eval kpi_cpu = if(cpu_hot_15>=15,0,100) | eventstats avg(kpi_cpu) as kpi_cpu_site by _time | timechart span=1m avg(kpi_cpu_site) as vmw_health | eval kpi="vmw", value=round(coalesce(vmw_health,100),0) | table _time kpi value]\
| append [search `index_dc` sourcetype="cisco:dc:aci:health" | bin _time span=1m | eval sev=lower(coalesce(aseverity,"")) | eval k_fabric = if(component="fabricHealthTotal" AND dn="topology/health", cur, null()) | eval k_tenant_cur = if(component="fvTenant" AND like(dn,"uni/%"), cur, null()) | eval t_crit = if(component="fvTenant" AND sev="critical",1,0) | eval t_maj = if(component="fvTenant" AND sev="major",1,0) | eval t_min = if(component="fvTenant" AND sev="minor",1,0) | eval t_warn = if(component="fvTenant" AND sev="warning",1,0) | eval k_bd_cur = if(component="fvBD" AND like(dn,"uni/%"), cur, null()) | eval k_epg_cur = if(component="fvAEPg" AND like(dn,"uni/%"), cur, null()) | eval l3_crit = if(component="l3extOut" AND sev="critical",1,0) | eval l3_maj = if(component="l3extOut" AND sev="major",1,0) | eval l3_min = if(component="l3extOut" AND sev="minor",1,0) | eval l3_warn = if(component="l3extOut" AND sev="warning",1,0) | eval leaf_cur = if(component="fabricNode" AND Role="leaf", cur, null()) | eval spine_cur = if(component="fabricNode" AND Role="spine", cur, null()) | stats latest(k_fabric) as k_fabric avg(k_tenant_cur) as k_tenant_cur sum(t_crit) as t_crit sum(t_maj) as t_maj sum(t_min) as t_min sum(t_warn) as t_warn avg(k_bd_cur) as k_bd_cur avg(k_epg_cur) as k_epg_cur sum(l3_crit) as l3_crit sum(l3_maj) as l3_maj sum(l3_min) as l3_min sum(l3_warn) as l3_warn avg(leaf_cur) as leaf_cur avg(spine_cur) as spine_cur by _time | eval kpi0_fabric=case(k_fabric>=99,100, k_fabric<=80,80, true(), round(coalesce(k_fabric,100))) | eval kpi1_tenant_calc = 100 - (coalesce(t_crit,0)*50 + coalesce(t_maj,0)*30 + coalesce(t_min,0)*15 + coalesce(t_warn,0)*5) | eval kpi1_tenant = max(0, coalesce(round(k_tenant_cur), kpi1_tenant_calc, 100)) | eval kpi2_bd = round(coalesce(k_bd_cur, 100)) | eval kpi3_epg = round(coalesce(k_epg_cur, 100)) | eval kpi4_l3 = max(0, 100 - (coalesce(l3_crit,0)*50 + coalesce(l3_maj,0)*30 + coalesce(l3_min,0)*15 + coalesce(l3_warn,0)*5)) | eval kpi5_leaf = round(coalesce(leaf_cur, 100)) | eval kpi6_spine = round(coalesce(spine_cur, 100)) | eval aci_health_kpi = round(0.10*kpi0_fabric + 0.20*kpi1_tenant + 0.20*kpi2_bd + 0.15*kpi3_epg + 0.15*kpi4_l3 + 0.10*kpi5_leaf + 0.10*kpi6_spine, 0) | timechart span=1m avg(aci_health_kpi) as aci_health_kpi | eval kpi="aci", value=aci_health_kpi | table _time kpi value]\
| bin _time span=1m\
| stats last(value) as value by _time kpi\
| xyseries _time kpi value\
| foreach th bgp core fw vmw aci [eval <<FIELD>>=coalesce(<<FIELD>>,100)]\
| eval service_health = round(max(1, min(100, (th + bgp + core + fw + vmw + aci) / 6)), 0)\
| stats min(service_health) as avg_service_health

[dc_networking_vmware_esx_host_error_logs]
search_name = DC Networking - VMware - ESX host Error Logs
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-07-30 00:00:00
date_updated = 2026-07-30 00:00:00
category = Data Center Networking
sub_category = VMware Integration
tags = Cisco DC Networking,Cisco ACI,VMware,Data Model,TStats
dispatch_context = cisco_dc_networking_app_for_splunk
dispatch_context_force = 0
default_viz = splunk.table
description = <p>Reports esx host error logs from the Cisco DC Networking <code>VMware</code> dashboard.</p>
explanation = <p>Runs the dashboard panel SPL against the <code>Cisco_DCN_Systems</code> data model. Preserves source data-model usage: <code>Cisco_DCN_Systems</code>. Dashboard-only filters are neutralized so the search runs independently.</p>
solution = <p>Investigate degraded or high-volume entities and correlate them with recent faults and configuration changes.</p>
related_info = <ul><li><b>Provenance</b><br><code>cisco_dc_networking_app_for_splunk</code> / <code>vmware.xml</code>.</li></ul>
search = | tstats `scd_summariesonly` latest(classInfo.VM_Relation.Tenant) AS Tenant latest(classInfo.VM_Relation.Application) AS Application latest(classInfo.VM_Relation.EPG) AS EPG latest(classInfo.VM_Relation.ESXHost) AS host from datamodel=Cisco_DCN_Systems where classInfo.component=fvRsVm groupby classInfo.VM_Relation.mac_addr,classInfo.apic_host\
| join type=inner max=0 host [search sourcetype="vmware:esxlog:*" | search Level=error | eval Time = strftime(_time,"%Y-%m-%d %H:%M:%S.%f") | table Time,host,Object,Message]\
| table Time,host,Object,Message\
| rename host AS Host

[dc_networking_vmware_virtual_machine_alarms]
search_name = DC Networking - VMware - Virtual Machine Alarms
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-07-30 00:00:00
date_updated = 2026-07-30 00:00:00
category = Data Center Networking
sub_category = VMware Integration
tags = Cisco DC Networking,Cisco ACI,VMware,Data Model,TStats
dispatch_context = cisco_dc_networking_app_for_splunk
dispatch_context_force = 0
default_viz = splunk.table
description = <p>Reports virtual machine alarms from the Cisco DC Networking <code>VMware</code> dashboard.</p>
explanation = <p>Runs the dashboard panel SPL against the <code>Cisco_DCN_Systems</code> data model. Preserves source data-model usage: <code>Cisco_DCN_Systems</code>. Dashboard-only filters are neutralized so the search runs independently.</p>
solution = <p>Use the result to identify affected data-center entities and correlate changes with related operational events.</p>
related_info = <ul><li><b>Provenance</b><br><code>cisco_dc_networking_app_for_splunk</code> / <code>vmware.xml</code>.</li></ul>
search = | tstats `scd_summariesonly` latest(classInfo.VM_Relation.Tenant) AS Tenant latest(classInfo.VM_Relation.Application) AS Application latest(classInfo.VM_Relation.EPG) AS EPG latest(classInfo.VM_Relation.VirtualMachine) AS VirtualMachine from datamodel=Cisco_DCN_Systems where classInfo.component=fvRsVm groupby classInfo.VM_Relation.mac_addr,classInfo.apic_host\
| join type=inner max=0 VirtualMachine [search sourcetype="vmware:events" | spath alarm | spath entity.name output=VirtualMachine | spath fullFormattedMessage output="Alarm-message" | spath createdTime output="Created Time" | spath alarm.name output=Type | table "Created Time",VirtualMachine,Type, Alarm-message]\
| table "Created Time",VirtualMachine,Type,Alarm-message\
| rename VirtualMachine AS "Virtual Machine" "Alarm-message" AS "Alarm Message"

[dc_networking_vmware_host_power_state]
search_name = Data Center Networking - Host Power State
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-08-04 00:00:00
date_updated = 2026-08-04 00:00:00
category = Data Center Networking
sub_category = VMware Integration
tags = Cisco DC Networking,VMware,vSphere,Inventory
dispatch_context = cisco_dc_networking_app_for_splunk
dispatch_context_force = 0
default_viz = splunk.table
description = <p>Reports hostname, cluster, datacenter, and current power state for every ESXi host in inventory.</p>
explanation = <p>Reads <code>vmware:inv:hostsystem</code> inventory telemetry and takes the latest <code>changeSet.summary.runtime.powerState</code>/cluster/datacenter per host <code>moid</code>. This surfaces the full host power-state inventory -- despite the source panel's title implying an already-filtered &quot;not powered on&quot; view, the underlying query does not filter by state, so every host (poweredOn, standBy, maintenance, poweredOff, unknown) is included.</p>
solution = <p>Scan for any <code>host_state</code> other than <code>poweredOn</code> to find hosts that are down or in maintenance; add <code>| where host_state!="poweredOn"</code> to this search if a pre-filtered down-hosts-only view is preferred.</p>
related_info = <ul><li><b>Provenance</b><br>Acme Labs demo dashboard, panel &quot;Host Power State (Not Powered On)&quot;.</li><li><b>Ranking not preserved</b><br>The source panel's trailing <code>result ranking</code> was removed because house style forbids <code>result ranking</code> in a pipeline that also contains <code>stats</code>.</li></ul>
search = `index_dc` sourcetype=vmware:inv:hostsystem\
| stats latest(changeSet.summary.runtime.powerState) as host_state latest(hypervisor_name) as hostname latest(cluster_name) as cluster latest(datacenter) as datacenter by moid\
| table hostname cluster datacenter host_state

[admin_cache_hit_summary]
search_name = Admin - Cache Hit Summary
search_author = akhamis
updated_author = akhamis
version = 1.0.1
date_created = 2026-04-19
date_updated = 2026-07-28 00:00:00
category = Admin
sub_category = Troubleshooting
tags = Cache,Performance
dispatch_context = splunk-cisco-dashboards
dispatch_context_force = 1
search_hidden = 1
default_viz = splunk.table
viz_options = {"seriesColors":["#0284C7","#16A34A","#F59E0B","#DC2626"],"legendDisplay":"off"}
description = <p>Measures <b>scheduler cache effectiveness</b> for <b>dashboards</b> by classifying each in-flight job as a <b>cache hit</b> or <b>miss</b>, then rolls <b>hit rate</b> up per <b>dashboard</b>.</p>
explanation = <p><code>| rest /services/search/jobs</code> enumerates jobs the search head currently knows about, keeping only rows whose <code>provenance</code> indicates a dashboard-driven UI panel (<code>provenance="UI:dashboard:*"</code>) while excluding the admin guide dashboard itself so the panel does not measure its own recursion. Each row is scored as a cache hit when its <code>sid</code> carries the <code>scheduler__</code> prefix (a previously scheduled, warmed artifact was reused) versus a fresh ad-hoc dispatch, then joined against the app's saved views to resolve friendly dashboard titles before hit/miss counts are rolled up per dashboard.</p>
solution = <p><b>Operational insight:</b> Chronic <b>0% hit rates</b> mean users wait on <b>cold searches every refresh</b>, which stresses SH CPUs and undermines executive SLAs.</p>
related_info = <ul><li><b>scheduler__ sid prefix</b><br>Heuristic that distinguishes warmed artifacts from ad-hoc runs.</li><li><b>join to views</b><br>Translates internal dashboard IDs to titles stakeholders recognize.</li><li><b>stats per search</b><br>Stops duplicate REST rows from inflating denominators.</li></ul>
search = | rest /services/search/jobs splunk_server=local\
| search (provenance="UI:dashboard:*") NOT provenance="UI:dashboard:admin_guide"\
| eval is_hit = if(match(sid, "^scheduler__"), 1, 0)\
| eval dashboard_id = case(match(provenance, "^UI:dashboard:"), replace(provenance, "^UI:dashboard:", ""), match(label, "^Executive Dashboard"), "home_launchpad", match(label, "^Executive Summary"), "home_launchpad", match(label, "^Security Resilience"), "security", match(label, "^IT - Critical"), "it_health", match(label, "^Asset Inventory"), "asset_inventory", match(label, "^Building"), "building", match(label, "^Statewide"), "statewide_exercise", match(label, "^Client Summary"), "statewide_exercise", 1==1, "unknown")\
| eval search_name = if(isnotnull(label) AND label!="", label, "(inline search)")\
| join type=left dashboard_id\
 [| rest /servicesNS/-/-/data/ui/views splunk_server=local\
 | search eai:acl.app="splunk-cisco-dashboards"\
 | rename title as dashboard_id, label as dashboard_label\
 | table dashboard_id, dashboard_label]\
| eval Dashboard = if(isnotnull(dashboard_label), dashboard_label, dashboard_id)\
| stats max(is_hit) as is_hit by Dashboard, search_name\
| stats count as Total, sum(is_hit) as "Cache Hits", sum(eval(if(is_hit=0,1,0))) as "Cache Misses", avg(is_hit) as hit_rate by Dashboard\
| eval "Hit Rate %" = round(hit_rate*100, 1)\
| fields - hit_rate\
| eval Summary = 'Cache Hits'."/".Total." cached (".'Hit Rate %'."%)"\
| table Dashboard, Total, "Cache Hits", "Cache Misses", "Hit Rate %", Summary


[admin_schedule_health_advisor]
search_name = Admin - Schedule Health Advisor
search_author = akhamis
updated_author = akhamis
version = 1.0.1
date_created = 2026-04-19
date_updated = 2026-07-28 00:00:00
category = Admin
sub_category = Troubleshooting
tags = Schedule,Optimization
dispatch_context = splunk-cisco-dashboards
dispatch_context_force = 1
search_hidden = 1
default_viz = splunk.table
viz_options = {"seriesColors":["#0284C7","#16A34A","#F59E0B","#DC2626"],"legendDisplay":"off"}
description = <p>Audits <b>saved searches</b> for <b>risky schedules</b>-surfacing <b>unscheduled reports</b>, <b>over-tight crons</b>, and <b>runtime versus interval</b> mismatches with a <b>suggested cron</b> and <b>plain-language action</b>.</p>
explanation = <p><code>rest /servicesNS/-/-/saved/searches</code> pulls definitions where <code>eai:acl.app="splunk-cisco-dashboards"</code>. Each <code>title</code> becomes <code>search_name</code> for joins. The first join hits <code>index=_audit</code> for completed searches, taking <code>latest(total_run_time)</code> as historical runtime; the second join grabs live <code>runDuration</code> from <code>/services/search/jobs</code> for active jobs. A saved search is flagged as risky when it is not scheduled at all, when its measured runtime exceeds 120 seconds on a sub-minute (<code>*/1</code>-style) cron, or when any tight cron is present regardless of runtime; a title-keyword heuristic (trend/timechart/history, detail/table/inventory/gap, status/pipeline/score/health/kpi) then proposes a staggered replacement cron, and only the non-OK rows survive the final filter.</p>
solution = <p><b>Operational insight:</b> <b>Concurrent heavy searches</b> with <b>*/1</b> style crons are a top cause of <b>skipped schedules</b> and <b>incomplete dashboards</b>-this panel tells you which titles to calm first.</p>
related_info = <ul><li><b>Dual runtime join</b><br>Combines audit history with live job duration.</li><li><b>Title-driven cron hints</b><br>Encodes opinionated but consistent staggering.</li><li><b>Filter non-OK only</b><br>Keeps operators focused on exceptions.</li></ul>
search = | rest /servicesNS/-/-/saved/searches splunk_server=local\
| search eai:acl.app="splunk-cisco-dashboards"\
| eval search_name = title\
| join type=left search_name\
 [| search index=_audit action=search info=completed savedsearch_name!=""\
 | stats latest(total_run_time) as last_runtime by savedsearch_name\
 | rename savedsearch_name as search_name]\
| join type=left search_name\
 [| rest /services/search/jobs splunk_server=local count=0\
 | search label!=""\
 | eval search_name = label\
 | eval _time=strptime(substr(updated, 1, 19), "%Y-%m-%dT%H:%M:%S")\
 | stats latest(runDuration) as job_runtime by search_name]\
| eval last_runtime = round(coalesce(last_runtime, job_runtime), 1)\
| eval current_schedule = if(is_scheduled="1", cron_schedule, "NOT SCHEDULED")\
| eval suggested_schedule = case(match(title, "(?i)(trend|timechart|history)"), "7 */12 * * *", match(title, "(?i)(detail|table|inventory|gap)"), "22 */6 * * *", match(title, "(?i)(status|pipeline|score|health|kpi)"), "37 */4 * * *", 1==1, "52 */4 * * *")\
| eval suggested_reason = case(is_scheduled!="1", "Not scheduled - enable via Settings > Searches, Reports, and Alerts > Edit Schedule", last_runtime > 120 AND match(cron_schedule, "^\*/[1-9] "), "Runs > 2 min on a tight schedule - reduce frequency", match(cron_schedule, "^\*/[1-9] "), "Schedule too aggressive - stagger to reduce concurrency", 1==1, "OK")\
| where suggested_reason != "OK"\
| rename search_name as "Saved Search", current_schedule as "Current", last_runtime as "Runtime (sec)", suggested_schedule as "Suggested", suggested_reason as "Action"\
| table "Saved Search", "Current", "Runtime (sec)", "Suggested", "Action"

[network_iosxr_cpu_utilization_status]
search_name = Network - CPU Utilization Status
search_author = akhamis
updated_author = akhamis
version = 1.0.1
date_created = 2026-08-04 00:00:00
date_updated = 2026-08-05 00:00:00
category = Network
sub_category = Device Health
tags = Cisco IOS-XR,Streaming Telemetry,CPU,Device Health
dispatch_context = splunk-cisco-dashboards
dispatch_context_force = 1
default_viz = splunk.table
description = <p>Reports the <b>latest 5-minute CPU utilization</b> for every IOS-XR <b>source and node</b>, combined into a single <code>source_nodename</code> key with a <b>Warning/High</b> status tier per row.</p>
explanation = <p>Pulls <code>total_cpu_five_minute</code> from the <code>Cisco-IOS-XR-wdsysmon-fd-oper:system-monitoring/cpu-utilization</code> model-driven telemetry path via <code>mstats</code>, grouped <code>BY source,node_name</code>. A <code>case()</code> tier flags <b>&gt;=80% as Warning</b> and <b>&gt;=90% as High</b> so operators can spot control-plane or line-card CPUs approaching saturation before they impact convergence or packet forwarding.</p>
solution = <p>Investigate any node flagged <b>High</b> first: check for a runaway process, a routing/BGP convergence storm, or a scheduled maintenance job. Sustained <b>Warning</b>-tier nodes across many devices may indicate a fleet-wide software defect or a telemetry collection interval that is too aggressive.</p>
related_info = <ul><li><b>source_nodename key</b><br>Concatenates <code>source</code> and <code>node_name</code> so multi-node chassis (RSP/line-card) report distinctly.</li><li><b>Pairs with network_iosxr_cpu_utilization_trend</b><br>The trend panel drills down into this table for point-in-time detail.</li></ul>
search = | mstats latest("Cisco-IOS-XR-wdsysmon-fd-oper:system-monitoring/cpu-utilization.total_cpu_five_minute") AS total_cpu_five_minute WHERE `index_network` span=5m BY source,node_name\
| eval source_nodename = source . "-" . node_name\
| eval status = case(total_cpu_five_minute >= 90, "High", total_cpu_five_minute >= 80, "Warning", true(), "Normal")\
| stats latest(total_cpu_five_minute) AS cpu_utilization latest(status) AS status BY source_nodename

[network_iosxr_cpu_utilization_trend]
search_name = Network - CPU Utilization Trend
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-08-04 00:00:00
date_updated = 2026-08-04 00:00:00
category = Network
sub_category = Device Health
tags = Cisco IOS-XR,Streaming Telemetry,CPU,Trend
dispatch_context = splunk-cisco-dashboards
dispatch_context_force = 1
default_viz = splunk.line
drilldown_search_name = Network - CPU Utilization Status
drilldown_button_title = View CPU status detail
description = <p>Trends <b>5-minute CPU utilization</b> for every IOS-XR <b>source and node</b> as a multi-series timechart, one series per <code>source_nodename</code>.</p>
explanation = <p>Same <code>total_cpu_five_minute</code> metric from <code>Cisco-IOS-XR-wdsysmon-fd-oper:system-monitoring/cpu-utilization</code> as the status table, but rendered with <code>timechart latest(...) BY source_nodename</code> so operators can see whether a device is trending toward saturation, spiking transiently, or holding steady across the dispatch window.</p>
solution = <p>Look for <b>sustained upward slopes</b> rather than single spikes -- those are the ones worth paging on. Use the drilldown into the status table to see the current Warning/High tier for any node whose line is climbing.</p>
related_info = <ul><li><b>Drilldown target</b><br><code>network_iosxr_cpu_utilization_status</code> is the natural table-shaped detail view for any series selected here.</li><li><b>Dead-code removed</b><br>The source panel computed an unused numeric <code>status</code> bucket that was never projected by the final <code>timechart</code>; it was dropped since it had no effect on the output.</li></ul>
search = | mstats latest("Cisco-IOS-XR-wdsysmon-fd-oper:system-monitoring/cpu-utilization.total_cpu_five_minute") AS total_cpu_five_minute WHERE `index_network` span=5m BY source,node_name\
| eval source_nodename = source . "-" . node_name\
| timechart latest(total_cpu_five_minute) AS cpu_utilization BY source_nodename useother=false

[network_iosxr_memory_utilization_status]
search_name = Network - Memory Utilization Status
search_author = akhamis
updated_author = akhamis
version = 1.0.1
date_created = 2026-08-04 00:00:00
date_updated = 2026-08-05 00:00:00
category = Network
sub_category = Device Health
tags = Cisco IOS-XR,Streaming Telemetry,Memory,Device Health
dispatch_context = splunk-cisco-dashboards
dispatch_context_force = 1
default_viz = splunk.table
description = <p>Reports the <b>current memory utilization percentage</b> per IOS-XR <b>source</b>, computed from total system RAM minus free physical memory, with a <b>Warning/High</b> status tier.</p>
explanation = <p><code>mstats</code> pulls <code>system_ram_memory</code> and <code>free_physical_memory</code> from <code>Cisco-IOS-XR-nto-misc-oper:memory-summary/nodes/node/summary</code>, then <code>eval memory_utilization = ((system_ram_memory - free_physical_memory) / system_ram_memory) * 100</code> derives the true used-memory percentage. A <code>case()</code> tier flags <b>&gt;=80% as Warning</b> and <b>&gt;=90% as High</b>, mirroring the CPU status pattern for a consistent device-health view.</p>
solution = <p>A device flagged <b>High</b> is at risk of process restarts or forced garbage collection under IOS-XR memory pressure. Check for memory leaks in long-running processes or recent feature/config changes that increased table sizes (routes, ACLs, NetFlow entries) before the condition worsens.</p>
related_info = <ul><li><b>ranking removed</b><br>The source panel ranked by descending value by <code>memory_utilization</code> after a <code>stats</code> aggregation; removed per house convention since a downstream <code>stats</code>/<code>mstats</code> pipeline already controls row order deterministically.</li><li><b>Pairs with network_iosxr_memory_utilization_trend</b><br>Same metric rendered as a timechart.</li></ul>
search = | mstats latest("Cisco-IOS-XR-nto-misc-oper:memory-summary/nodes/node/summary.system_ram_memory") AS system_ram_memory latest("Cisco-IOS-XR-nto-misc-oper:memory-summary/nodes/node/summary.free_physical_memory") AS free_physical_memory WHERE `index_network` span=5m BY source\
| eval memory_utilization = ((system_ram_memory - free_physical_memory) / system_ram_memory) * 100\
| eval memory_utilization = round(memory_utilization, 0)\
| eval status = case(memory_utilization >= 90, "High", memory_utilization >= 80, "Warning", true(), "Normal")\
| bin _time span=5m\
| stats latest(memory_utilization) AS memory_utilization values(status) AS status BY source

[network_iosxr_memory_utilization_trend]
search_name = Network - Memory Utilization Trend
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-08-04 00:00:00
date_updated = 2026-08-04 00:00:00
category = Network
sub_category = Device Health
tags = Cisco IOS-XR,Streaming Telemetry,Memory,Trend
dispatch_context = splunk-cisco-dashboards
dispatch_context_force = 1
default_viz = splunk.line
drilldown_search_name = Network - Memory Utilization Status
drilldown_button_title = View memory status detail
description = <p>Trends <b>memory utilization percentage</b> per IOS-XR <b>source</b> over the dispatch window, one series per device.</p>
explanation = <p>Same derivation as the status table -- <code>((system_ram_memory - free_physical_memory) / system_ram_memory) * 100</code> from <code>Cisco-IOS-XR-nto-misc-oper:memory-summary</code> -- rendered with <code>timechart span=5m values(memory_utilization) BY source</code> so a slow memory-utilization climb is visible before it crosses the Warning/High thresholds.</p>
solution = <p>Investigate any series with a persistent upward trend rather than a flat or sawtooth pattern; a sawtooth is normal garbage-collection behavior, a monotonic climb suggests a leak. Cross-reference the drilldown status table to confirm current tier.</p>
related_info = <ul><li><b>Drilldown target</b><br><code>network_iosxr_memory_utilization_status</code> gives the point-in-time Warning/High tier for any source trending upward here.</li></ul>
search = | mstats latest("Cisco-IOS-XR-nto-misc-oper:memory-summary/nodes/node/summary.system_ram_memory") AS system_ram_memory latest("Cisco-IOS-XR-nto-misc-oper:memory-summary/nodes/node/summary.free_physical_memory") AS free_physical_memory WHERE `index_network` span=5m BY source\
| fields source, system_ram_memory, free_physical_memory\
| eval memory_utilization = ((system_ram_memory - free_physical_memory) / system_ram_memory) * 100\
| eval memory_utilization = round(memory_utilization, 0)\
| timechart span=5m values(memory_utilization) AS memory_utilization BY source

[network_iosxr_interface_input_utilization]
search_name = Network - Interface Input Utilization
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-08-04 00:00:00
date_updated = 2026-08-04 00:00:00
category = Network
sub_category = Device Health
tags = Cisco IOS-XR,Streaming Telemetry,Interface,Utilization
dispatch_context = splunk-cisco-dashboards
dispatch_context_force = 1
default_viz = splunk.line
description = <p>Trends <b>inbound interface utilization percentage</b> for every IOS-XR <b>source/interface</b> pair over the dispatch window.</p>
explanation = <p><code>mstats</code> reads <code>input_load</code> from <code>Cisco-IOS-XR-infra-statsd-oper:infra-statistics/interfaces/interface/data-rate</code>, an IOS-XR load gauge scaled 0-255; <code>eval input_utilization = (input_load / 255) * 100</code> converts it to a percentage, then <code>timechart</code> plots one series per <code>source_iface</code>. Sustained high input utilization on an interface is an early indicator of ingress congestion.</p>
solution = <p>Interfaces trending toward 100% input utilization are candidates for a bandwidth upgrade, traffic-engineering change, or QoS policy review. Correlate spikes with the drop-rate and throughput panels for the same interface to confirm whether congestion is actually causing loss.</p>
related_info = <ul><li><b>0-255 load scale</b><br>IOS-XR reports interface load on a legacy 0-255 gauge rather than a native percentage; the <code>/255*100</code> conversion is required to interpret it correctly.</li><li><b>Related</b><br><code>network_iosxr_interface_output_utilization</code> is the egress counterpart.</li></ul>
search = | mstats latest("Cisco-IOS-XR-infra-statsd-oper:infra-statistics/interfaces/interface/data-rate.input_load") AS input_load WHERE `index_network` span=5m BY source,interface_name\
| eval input_utilization = (input_load / 255) * 100\
| eval source_iface = source . "-" . interface_name\
| timechart span=5m latest(input_utilization) AS input_utilization BY source_iface useother=false

[network_iosxr_interface_output_utilization]
search_name = Network - Interface Output Utilization
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-08-04 00:00:00
date_updated = 2026-08-04 00:00:00
category = Network
sub_category = Device Health
tags = Cisco IOS-XR,Streaming Telemetry,Interface,Utilization
dispatch_context = splunk-cisco-dashboards
dispatch_context_force = 1
default_viz = splunk.line
description = <p>Trends <b>outbound interface utilization percentage</b> for every IOS-XR <b>source/interface</b> pair over the dispatch window.</p>
explanation = <p><code>mstats</code> reads <code>output_load</code> from <code>Cisco-IOS-XR-infra-statsd-oper:infra-statistics/interfaces/interface/data-rate</code>, the same 0-255 load gauge used on ingress; <code>eval output_utilization = (output_load / 255) * 100</code> converts it to a percentage, then <code>timechart</code> plots one series per <code>source_iface</code>. High sustained egress utilization is the leading indicator of output queue drops.</p>
solution = <p>Interfaces climbing toward 100% output utilization are candidates for capacity upgrade or egress QoS shaping. Cross-check with <code>network_iosxr_output_drop_rate</code> for the same interface to see whether the congestion is already producing packet loss.</p>
related_info = <ul><li><b>0-255 load scale</b><br>Same legacy IOS-XR gauge conversion as the input-utilization panel.</li><li><b>Related</b><br><code>network_iosxr_output_drop_rate</code> shows whether this utilization is translating into egress drops.</li></ul>
search = | mstats latest("Cisco-IOS-XR-infra-statsd-oper:infra-statistics/interfaces/interface/data-rate.output_load") AS output_load WHERE `index_network` span=5m BY source,interface_name\
| eval output_utilization = (output_load / 255) * 100\
| eval source_iface = source . "-" . interface_name\
| timechart span=5m latest(output_utilization) AS output_utilization BY source_iface useother=false

[network_iosxr_peak_interface_throughput]
search_name = Network - Peak Interface Throughput
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-08-04 00:00:00
date_updated = 2026-08-04 00:00:00
category = Network
sub_category = Interface Utilization
tags = Cisco IOS-XR,Streaming Telemetry,Interface,Throughput,Capacity Planning
dispatch_context = splunk-cisco-dashboards
dispatch_context_force = 1
default_viz = splunk.area
description = <p>Trends <b>peak real throughput in bits per second</b> per IOS-XR <b>source/interface</b>, computed from the byte-delta between consecutive telemetry samples rather than a raw cumulative counter.</p>
explanation = <p>Unlike the utilization panels, which read a pre-computed load gauge, this search derives actual throughput from <code>bytes_received</code> (<code>Cisco-IOS-XR-infra-statsd-oper:infra-statistics/interfaces/interface/generic-counters</code>), a monotonically increasing counter. <code>streamstats window=2 range(bytes_received) AS delta_bytes_received BY source,interface_name</code> takes the difference between consecutive 5-minute samples, and <code>eval throughput_bps = (delta_bytes_received * 8) / 300</code> converts the byte-delta over the 300-second span into bits per second. <code>timechart max(throughput_bps) AS peak_throughput</code> then surfaces the peak bps observed per bucket -- a genuinely distinct calculation from the load-based utilization percentage panels, useful for real capacity-planning conversations in actual bps/Gbps terms.</p>
solution = <p>Use peak throughput alongside link speed to compute true headroom; an interface repeatedly peaking near its provisioned speed needs an upgrade or traffic redistribution even if the load-gauge utilization percentage looks moderate on average.</p>
related_info = <ul><li><b>streamstats byte-delta, not raw counter</b><br>Reading <code>bytes_received</code> directly would show an ever-increasing counter; the <code>range()</code> delta over a 2-sample window is what makes this a rate.</li><li><b>Complements</b><br><code>network_iosxr_interface_input_utilization</code> reports the load-gauge percentage; this panel reports actual bps.</li></ul>
search = | mstats latest("Cisco-IOS-XR-infra-statsd-oper:infra-statistics/interfaces/interface/generic-counters.bytes_received") AS bytes_received WHERE `index_network` span=5m BY source,interface_name\
| streamstats window=2 global=false range(bytes_received) AS delta_bytes_received BY source,interface_name\
| eval throughput_bps = if(delta_bytes_received > 0, (delta_bytes_received * 8) / 300, 0)\
| eval source_interface = source . ":" . interface_name\
| timechart span=5m max(throughput_bps) AS peak_throughput BY source_interface useother=false

[network_iosxr_down_interface_pct]
search_name = Network - Down Interface Percentage
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-08-04 00:00:00
date_updated = 2026-08-04 00:00:00
category = Network
sub_category = Interface Stability
tags = Cisco IOS-XR,Streaming Telemetry,Interface,Availability
dispatch_context = splunk-cisco-dashboards
dispatch_context_force = 1
default_viz = splunk.singlevalue
description = <p>Single fleet-wide <b>percentage of down interfaces</b> across all monitored IOS-XR devices in the dispatch window.</p>
explanation = <p><code>mstats</code> reads <code>down_interface_count</code> and <code>interface_count</code> per <code>source</code> from <code>Cisco-IOS-XR-pfi-im-cmd-oper:interfaces/interface-summary.interface_counts</code>, then <code>stats sum(...)</code> rolls the per-device counts up to fleet totals before computing <code>down_interface_percentage = (down_interface_count / interface_count) * 100</code>. A rising fleet-wide percentage means interfaces are going administratively or operationally down faster than they are being restored.</p>
solution = <p>A nonzero or climbing value warrants checking per-device interface state (e.g. via IOS-XR <code>show interfaces summary</code>) to separate planned maintenance from unplanned link failures, and to catch a bad software push or optics batch causing correlated interface flaps.</p>
related_info = <ul><li><b>Reshaped for a single value</b><br>The source panel rendered this as a per-source timechart; it was re-aggregated with <code>stats sum()</code> across sources to produce the single fleet-wide value the assigned <code>splunk.singlevalue</code> visualization expects. Use a per-source breakdown if device-level granularity is needed.</li></ul>
search = | mstats latest("Cisco-IOS-XR-pfi-im-cmd-oper:interfaces/interface-summary.interface_counts/down_interface_count") AS down_interface_count latest("Cisco-IOS-XR-pfi-im-cmd-oper:interfaces/interface-summary.interface_counts/interface_count") AS interface_count WHERE `index_network` span=5m BY source\
| stats sum(down_interface_count) AS down_interface_count sum(interface_count) AS interface_count\
| eval down_interface_percentage = if(interface_count > 0, (down_interface_count / interface_count) * 100, 0)\
| eval down_interface_percentage = round(down_interface_percentage, 2)

[network_iosxr_input_drop_rate]
search_name = Network - Input Drop Rate
search_author = akhamis
updated_author = akhamis
version = 1.0.1
date_created = 2026-08-04 00:00:00
date_updated = 2026-08-05 00:00:00
category = Network
sub_category = Interface Stability
tags = Cisco IOS-XR,Streaming Telemetry,Interface,Packet Drops
dispatch_context = splunk-cisco-dashboards
dispatch_context_force = 1
default_viz = splunk.table
description = <p>Per-interface <b>ingress packet drop rate</b> for every IOS-XR <b>source/interface</b>, with a <b>High/Critical</b> status tier.</p>
explanation = <p><code>mstats</code> reads <code>packets_received</code> and <code>input_drops</code> from <code>Cisco-IOS-XR-infra-statsd-oper:infra-statistics/interfaces/interface/generic-counters</code>; <code>eval input_drop_rate = (input_drops / packets_received) * 100</code> derives the drop percentage, tiered <b>&gt;=5% as High</b> and <b>&gt;=10% as Critical</b>. Ingress drops indicate the device is discarding frames before they can be processed -- typically buffer exhaustion, a duplex mismatch, or a saturated link.</p>
solution = <p>Any interface flagged <b>Critical</b> should be checked immediately for a duplex/speed mismatch, a failing SFP, or ingress congestion; correlate with <code>network_iosxr_interface_input_utilization</code> for the same interface to see if utilization is also elevated.</p>
related_info = <ul><li><b>Typo cleanup</b><br>The source panel's status literal contained a stray trailing pipe character (<code>"Normal|"</code>); corrected to <code>"Normal"</code> with no change to the threshold logic.</li><li><b>Related</b><br><code>network_iosxr_output_drop_rate</code> is the egress counterpart.</li></ul>
search = | mstats latest("Cisco-IOS-XR-infra-statsd-oper:infra-statistics/interfaces/interface/generic-counters.packets_received") AS packets_received latest("Cisco-IOS-XR-infra-statsd-oper:infra-statistics/interfaces/interface/generic-counters.input_drops") AS input_drops WHERE `index_network` span=5m BY source,interface_name\
| fields source, interface_name, packets_received, input_drops\
| eval input_drop_rate = (input_drops / packets_received) * 100\
| eval status = case(input_drop_rate >= 10, "Critical", input_drop_rate >= 5, "High", true(), "Normal")\
| table source, interface_name, packets_received, input_drop_rate, status\
| search input_drop_rate=*

[network_iosxr_output_drop_rate]
search_name = Network - Output Drop Rate
search_author = akhamis
updated_author = akhamis
version = 1.0.1
date_created = 2026-08-04 00:00:00
date_updated = 2026-08-05 00:00:00
category = Network
sub_category = Interface Stability
tags = Cisco IOS-XR,Streaming Telemetry,Interface,Packet Drops
dispatch_context = splunk-cisco-dashboards
dispatch_context_force = 1
default_viz = splunk.table
description = <p>Per-interface <b>egress packet drop rate</b> for every IOS-XR <b>source/interface</b>, with a <b>High/Critical</b> status tier.</p>
explanation = <p><code>mstats</code> reads <code>packets_sent</code> and <code>output_drops</code> from <code>Cisco-IOS-XR-infra-statsd-oper:infra-statistics/interfaces/interface/generic-counters</code>; <code>eval output_drop_rate = (output_drops / packets_sent) * 100</code> derives the drop percentage, tiered <b>&gt;=5% as High</b> and <b>&gt;=10% as Critical</b>. Egress drops typically mean the outbound queue is overflowing faster than it can be serviced -- a direct symptom of oversubscription on that link.</p>
solution = <p>An interface flagged <b>Critical</b> should be checked for output-queue saturation; correlate with <code>network_iosxr_interface_output_utilization</code> and <code>network_iosxr_peak_interface_throughput</code> for the same interface to confirm whether the link is actually oversubscribed and needs a capacity or QoS remediation.</p>
related_info = <ul><li><b>Typo cleanup</b><br>The source panel's status literal contained a stray trailing pipe character (<code>"Normal|"</code>); corrected to <code>"Normal"</code> with no change to the threshold logic.</li><li><b>Related</b><br><code>network_iosxr_input_drop_rate</code> is the ingress counterpart.</li></ul>
search = | mstats latest("Cisco-IOS-XR-infra-statsd-oper:infra-statistics/interfaces/interface/generic-counters.packets_sent") AS packets_sent latest("Cisco-IOS-XR-infra-statsd-oper:infra-statistics/interfaces/interface/generic-counters.output_drops") AS output_drops WHERE `index_network` span=5m BY source,interface_name\
| fields source, interface_name, packets_sent, output_drops\
| eval output_drop_rate = (output_drops / packets_sent) * 100\
| eval status = case(output_drop_rate >= 10, "Critical", output_drop_rate >= 5, "High", true(), "Normal")\
| table source, interface_name, packets_sent, output_drop_rate, status\
| search output_drop_rate=*

[network_iosxr_disk_utilization]
search_name = Network - Disk Utilization
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-08-04 00:00:00
date_updated = 2026-08-04 00:00:00
category = Network
sub_category = Device Health
tags = Cisco IOS-XR,Streaming Telemetry,Storage,Device Health
dispatch_context = splunk-cisco-dashboards
dispatch_context_force = 1
default_viz = splunk.table
description = <p>Per-device <b>local storage (harddisk/bootflash) utilization percentage</b> for every IOS-XR <b>source</b>, with an inline sparkline and a <b>Warning/Critical</b> status tier.</p>
explanation = <p><code>mstats</code> reads <code>harddisk_size</code> and <code>harddisk_free</code> from <code>Cisco-IOS-XR-shellutil-filesystem-oper:file-system/node.file_system</code>; <code>eval harddisk_utilization = (used_space / harddisk_size) * 100</code> derives the percentage used, tiered <b>&gt;=80% as WARNING</b> and <b>&gt;=99% as CRITICAL</b>. <code>stats sparkline values(harddisk_utilization)</code> keeps a per-source trend visible inline alongside the current status.</p>
solution = <p>A device flagged <b>CRITICAL</b> is at risk of failing to write crash dumps, install images, or config checkpoints -- clear old cores/images or expand storage before the next code upgrade or RP failover attempts to write there.</p>
related_info = <ul><li><b>Distinct entity from other disk stanzas</b><br>This measures local flash/harddisk storage on an IOS-XR router chassis, a different entity from the catalog's existing ISE-node disk utilization search (<code>security_resilience_ise_disk_utilization</code>) or any ACI-fabric filesystem search -- do not conflate the three when reasoning about storage-health coverage.</li><li><b>ranking removed</b><br>The source panel ranked by descending value by utilization after a <code>stats</code> aggregation; removed per house convention.</li></ul>
search = | mstats latest("Cisco-IOS-XR-shellutil-filesystem-oper:file-system/node.file_system/size") AS harddisk_size latest("Cisco-IOS-XR-shellutil-filesystem-oper:file-system/node.file_system/free") AS harddisk_free WHERE `index_network` span=5m BY source\
| eval used_space = harddisk_size - harddisk_free\
| eval harddisk_utilization = if(harddisk_size > 0, (used_space / harddisk_size) * 100, 0)\
| eval harddisk_utilization = round(harddisk_utilization, 2)\
| eval status = case(harddisk_utilization >= 99, "CRITICAL", harddisk_utilization >= 80, "WARNING", true(), "OK")\
| bin _time span=5m\
| stats sparkline values(harddisk_utilization) AS harddisk_utilization values(status) AS status BY source

[network_iosxr_mltk_cpu_anomaly]
search_name = Network - CPU Anomalies (MLTK)
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-08-04 00:00:00
date_updated = 2026-08-04 00:00:00
category = Network
sub_category = Device Health
tags = Cisco IOS-XR,Streaming Telemetry,CPU,Machine Learning,Anomaly Detection
dispatch_context = splunk-cisco-dashboards
dispatch_context_force = 1
default_viz = splunk.table
description = <p>Scores per-device <b>CPU utilization</b> against a pre-trained MLTK anomaly-detection model and flags rows whose anomaly score exceeds <b>0.8</b>.</p>
explanation = <p>Builds the same <code>total_cpu_five_minute</code> timechart used by <code>network_iosxr_cpu_utilization_trend</code> (from <code>Cisco-IOS-XR-wdsysmon-fd-oper:system-monitoring/cpu-utilization</code>), reshapes it with <code>untable</code> into <code>_time, source_nodename, cpu_utilization</code> rows, and scores each row with <code>apply cpu_anomaly_model_all_routers</code> -- an MLTK DensityFunction model. <code>eval is_anomaly = if(anomaly_score > 0.8, "Yes", "No")</code> flags statistical outliers that a static threshold would miss, e.g. a device whose CPU is elevated relative to its own historical baseline even if it has not crossed the 80/90 percent tiers used elsewhere.</p>
solution = <p>Treat <b>is_anomaly=Yes</b> rows as a prioritized triage list even when the raw CPU percentage looks moderate -- the model is flagging a deviation from that specific device's normal pattern, which can surface an early-stage problem before it becomes a threshold breach.</p>
related_info = <ul><li><b>Requires a pre-trained model artifact</b><br>This search depends on <code>cpu_anomaly_model_all_routers</code>, an MLTK DensityFunction model that does <b>not yet exist</b> in this environment. It must be trained in the Splunk Machine Learning Toolkit app (via <code>fit DensityFunction</code> over historical <code>cpu_utilization</code> data, saved under that model name) before this search will return meaningful <code>anomaly_score</code>/<code>is_anomaly</code> values -- until then <code>apply</code> will error or return empty. The SPL pattern (reshape-then-apply for streaming-telemetry anomaly scoring) is what is being harvested here.</li><li><b>Read-only apply</b><br>The <code>apply</code> command here only scores data against an existing model; it performs no training or write.</li><li><b>Related</b><br>Shares its source metric with <code>network_iosxr_cpu_utilization_status</code> and <code>network_iosxr_cpu_utilization_trend</code>.</li></ul>
search = | mstats latest("Cisco-IOS-XR-wdsysmon-fd-oper:system-monitoring/cpu-utilization.total_cpu_five_minute") AS total_cpu_five_minute WHERE `index_network` earliest=-24h@h latest=now span=5m BY source,node_name\
| eval source_nodename = replace(source . "-" . node_name, ",", "_")\
| timechart span=5m latest(total_cpu_five_minute) AS cpu_utilization BY source_nodename\
| untable _time source_nodename cpu_utilization\
| apply cpu_anomaly_model_all_routers\
| eval is_anomaly = if(anomaly_score > 0.8, "Yes", "No")\
| eval status = case(cpu_utilization <= 80, "Low", cpu_utilization <= 90, "Moderate", true(), "High")\
| fields _time, source_nodename, cpu_utilization, anomaly_score, is_anomaly, status

[network_iosxr_bgp_established_pct]
search_name = Network - Percentage of Established BGP Neighbors
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-08-04 00:00:00
date_updated = 2026-08-04 00:00:00
category = Network
sub_category = Routing
tags = Cisco IOS-XR,BGP,Streaming Telemetry,BGP Neighbors,Availability
dispatch_context = splunk-cisco-dashboards
dispatch_context_force = 1
default_viz = splunk.line
description = <p>Tracks the <b>percentage of BGP neighbors in Established state</b> per IOS-XR device, flagging <b>WARNING</b> whenever fewer than 95% of configured neighbors are up.</p>
explanation = <p>Queries model-driven streaming telemetry under <code>Cisco-IOS-XR-ipv4-bgp-oper:bgp/instances/instance/instance-active/default-vrf/process-info.global</code> via <code>mstats</code>, pulling <code>established_neighbors_count_total</code> and <code>neighbors_count_total</code> per device (<code>source</code>) on a 5-minute cadence. <code>established_percentage</code> is the simple ratio, and <code>status</code> flips to WARNING below the 95% threshold. This is genuinely new coverage: the catalog's only prior "BGP" content is ThousandEyes synthetic external path-change monitoring, plus IOS syslog adjacency-change events - there is no existing internal BGP process-telemetry from IOS-XR model-driven streaming telemetry anywhere else in the catalog. The source dashboard paired this trend line with a separate annotation datasource that shades sub-95% windows on the chart; that logic is already fully captured here by the inline <code>status</code> eval, so no separate annotation stanza is needed.</p>
solution = <p>Investigate any device trending below 95% established immediately - it means one or more configured BGP sessions are stuck outside Established (Idle/Active/Connect/OpenSent/OpenConfirm). Cross-reference with <code>network_iosxr_bgp_session_uptime</code> and <code>network_iosxr_bgp_session_state_trend</code> to identify which specific neighbor is flapping or down before it affects route propagation.</p>
related_info = <ul><li><b>established_neighbors_count_total / neighbors_count_total</b><br>IOS-XR global BGP process counters exposing configured vs. Established neighbor counts.</li><li><b>95% threshold</b><br>Matches the source dashboard's WARNING gate; a small number of transient flaps below this line is expected, sustained sub-95% is not.</li><li><b>See also</b><br><code>network_iosxr_bgp_session_state_trend</code> for per-neighbor FSM detail behind an aggregate drop.</li></ul>
search = | mstats latest("Cisco-IOS-XR-ipv4-bgp-oper:bgp/instances/instance/instance-active/default-vrf/process-info.global/established_neighbors_count_total") AS established_neighbors latest("Cisco-IOS-XR-ipv4-bgp-oper:bgp/instances/instance/instance-active/default-vrf/process-info.global/neighbors_count_total") AS total_neighbors WHERE `index_network` span=5m BY source\
| eval established_percentage = if(total_neighbors > 0, (established_neighbors / total_neighbors) * 100, 0)\
| eval established_percentage = round(established_percentage, 2)\
| eval status = if(established_percentage < 95, "WARNING", "OK")\
| timechart span=5m latest(established_percentage) AS established_percentage BY source

[network_iosxr_bgp_memory_use]
search_name = Network - BGP Memory Use
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-08-04 00:00:00
date_updated = 2026-08-04 00:00:00
category = Network
sub_category = Routing
tags = Cisco IOS-XR,BGP,Streaming Telemetry,Memory,Capacity Planning
dispatch_context = splunk-cisco-dashboards
dispatch_context_force = 1
default_viz = splunk.line
description = <p>Sums the three largest <b>BGP process memory pools</b> - AS-path, path-attribute, and next-hop - per IOS-XR device, flagging <b>CRITICAL above 80MB</b> and <b>WARNING above 50MB</b>.</p>
explanation = <p><code>mstats</code> pulls <code>as_path_entries_memory</code>, <code>path_attribute_memory</code>, and <code>nexthop_memory</code> from <code>Cisco-IOS-XR-ipv4-bgp-oper:bgp/instances/instance/instance-active/default-vrf/process-info.global</code> streaming telemetry every 5 minutes per <code>source</code>, then <code>total_memory</code> adds all three. This is internal BGP process-memory telemetry with no equivalent anywhere else in the catalog today - the only existing BGP content is ThousandEyes' external synthetic path-change monitoring, which has no visibility into router-side control-plane resource consumption.</p>
solution = <p>A device sustaining CRITICAL (&gt;80MB) BGP memory is at risk of process restarts or route-table churn under further table growth - correlate with <code>network_iosxr_bgp_total_paths</code> to see whether route-count growth is driving the memory pressure, and plan a maintenance-window process restart or route-reflector rebalance before the process hits a hard limit.</p>
related_info = <ul><li><b>as_path_entries_memory / path_attribute_memory / nexthop_memory</b><br>The three largest allocatable BGP RIB memory pools on IOS-XR.</li><li><b>See also</b><br><code>network_iosxr_bgp_total_paths</code> - path-count growth is the most common driver of rising BGP memory use.</li></ul>
search = | mstats latest("Cisco-IOS-XR-ipv4-bgp-oper:bgp/instances/instance/instance-active/default-vrf/process-info.global/as_path_entries_memory") AS as_path_memory latest("Cisco-IOS-XR-ipv4-bgp-oper:bgp/instances/instance/instance-active/default-vrf/process-info.global/path_attribute_memory") AS path_attr_memory latest("Cisco-IOS-XR-ipv4-bgp-oper:bgp/instances/instance/instance-active/default-vrf/process-info.global/nexthop_memory") AS nexthop_memory WHERE `index_network` span=5m BY source\
| eval total_memory = as_path_memory + path_attr_memory + nexthop_memory\
| eval status = if(total_memory > 80000000, "CRITICAL", if(total_memory > 50000000, "WARNING", "OK"))\
| timechart span=5m values(total_memory) AS total_memory BY source

[network_iosxr_bgp_update_rate]
search_name = Network - BGP Update Message Rate
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-08-04 00:00:00
date_updated = 2026-08-04 00:00:00
category = Network
sub_category = Routing
tags = Cisco IOS-XR,BGP,Streaming Telemetry,Update Messages,Control Plane
dispatch_context = splunk-cisco-dashboards
dispatch_context_force = 1
default_viz = splunk.table
description = <p>Computes the combined <b>BGP UPDATE message rate</b> (received + sent, per minute) per IOS-XR device with a sparkline trend, flagging <b>HIGH above 100</b>.</p>
explanation = <p><code>mstats</code> reads <code>update_messages_received</code> and <code>update_messages_sent</code> from <code>Cisco-IOS-XR-ipv4-bgp-oper:...process-info.vrf</code> streaming telemetry on a 5-minute cadence per <code>source</code>; <code>update_rate</code> divides the combined total by 5 to normalize to a per-minute rate, and <code>status</code> flags HIGH above 100/min. The source panel's title referenced a 15-minute window but its pipeline actually buckets and normalizes on 5-minute spans - this stanza's title and logic follow the pipeline, not the mislabeled panel title. Internal BGP UPDATE-rate telemetry from model-driven streaming data is new to the catalog; the only prior BGP-adjacent content is ThousandEyes' external path-change trend.</p>
solution = <p>Sustained HIGH update rates indicate active route churn - possibly a flapping neighbor, a large route-reflector re-advertisement, or an upstream reconvergence event. Correlate with <code>network_iosxr_bgp_flap_detection</code> and <code>network_iosxr_bgp_session_state_trend</code> to identify the specific neighbor generating the churn.</p>
related_info = <ul><li><b>update_messages_received / update_messages_sent</b><br>IOS-XR VRF-level BGP UPDATE message counters.</li><li><b>See also</b><br><code>network_iosxr_bgp_flap_detection</code> for the neighbor-level anomaly signal behind a device-wide rate spike.</li></ul>
search = | mstats latest("Cisco-IOS-XR-ipv4-bgp-oper:bgp/instances/instance/instance-active/default-vrf/process-info.vrf/update_messages_received") AS updates_received latest("Cisco-IOS-XR-ipv4-bgp-oper:bgp/instances/instance/instance-active/default-vrf/process-info.vrf/update_messages_sent") AS updates_sent WHERE `index_network` span=5m BY source\
| eval total_updates = updates_received + updates_sent\
| eval update_rate = total_updates / 5\
| eval status = if(update_rate > 100, "HIGH", "OK")\
| bin _time span=5m\
| stats sparkline latest(update_rate) AS update_rate values(status) AS status BY source

[network_iosxr_bgp_throttled_neighbors]
search_name = Network - Number of Throttled BGP Neighbors
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-08-04 00:00:00
date_updated = 2026-08-04 00:00:00
category = Network
sub_category = Routing
tags = Cisco IOS-XR,BGP,Streaming Telemetry,Neighbor Throttling,Control Plane
dispatch_context = splunk-cisco-dashboards
dispatch_context_force = 1
default_viz = splunk.line
description = <p>Sums <b>read- and write-throttled BGP neighbor counts</b> per IOS-XR device, flagging <b>WARNING</b> the moment any neighbor is throttled.</p>
explanation = <p><code>mstats</code> pulls <code>read_throttled_nbr_count</code> and <code>write_throttled_nbr_count</code> from <code>Cisco-IOS-XR-ipv4-bgp-oper:...process-info.performance_statistics/vrf</code> streaming telemetry per <code>source</code> every 5 minutes; <code>throttled_neighbors</code> adds both directions and any non-zero value triggers WARNING. IOS-XR exposes neighbor throttling when a BGP process can't keep up with inbound/outbound message volume for a given peer - a leading indicator of process overload that has no analog in the catalog's existing ThousandEyes-only BGP coverage.</p>
solution = <p>Any throttled neighbor means the BGP process is applying flow control against a peer, typically due to CPU or memory pressure or an unusually chatty neighbor. Check <code>network_iosxr_bgp_memory_use</code> and <code>network_iosxr_bgp_update_rate</code> on the same device to confirm whether resource exhaustion or message volume is the root cause.</p>
related_info = <ul><li><b>read_throttled_nbr_count / write_throttled_nbr_count</b><br>Per-VRF counts of BGP neighbors currently being flow-controlled in each direction.</li><li><b>See also</b><br><code>network_iosxr_bgp_memory_use</code> - throttling often co-occurs with elevated BGP process memory.</li></ul>
search = | mstats latest("Cisco-IOS-XR-ipv4-bgp-oper:bgp/instances/instance/instance-active/default-vrf/process-info.performance_statistics/vrf/read_throttled_nbr_count") AS read_throttled latest("Cisco-IOS-XR-ipv4-bgp-oper:bgp/instances/instance/instance-active/default-vrf/process-info.performance_statistics/vrf/write_throttled_nbr_count") AS write_throttled WHERE `index_network` span=5m BY source\
| eval throttled_neighbors = read_throttled + write_throttled\
| eval status = if(throttled_neighbors > 0, "WARNING", "OK")\
| timechart span=5m values(throttled_neighbors) AS throttled_neighbors BY source

[network_iosxr_bgp_total_paths]
search_name = Network - Total BGP Paths
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-08-04 00:00:00
date_updated = 2026-08-04 00:00:00
category = Network
sub_category = Routing
tags = Cisco IOS-XR,BGP,Streaming Telemetry,RIB,Capacity Planning
dispatch_context = splunk-cisco-dashboards
dispatch_context_force = 1
default_viz = splunk.pie
description = <p>Reports the <b>total BGP path-attribute entry count</b> per IOS-XR device, flagging <b>HIGH above 500,000</b> and <b>LOW below 50,000</b> paths.</p>
explanation = <p><code>mstats</code> reads <code>path_attributes_entry_count</code> from <code>Cisco-IOS-XR-ipv4-bgp-oper:...process-info.global</code> streaming telemetry per <code>source</code> on a 5-minute cadence. HIGH indicates a device approaching typical RIB/TCAM capacity planning limits; LOW can indicate a device that has lost most of its BGP-learned routes (e.g. a neighbor outage or route-reflector failure). This is internal RIB-scale telemetry with no existing counterpart in the catalog - today's only BGP content is ThousandEyes' external synthetic path-change trend, which has no visibility into actual router path-table size.</p>
solution = <p>HIGH path counts warrant capacity planning review (RIB/FIB scale, route-reflector summarization, or prefix filtering); LOW path counts on a device that normally carries a full table should be treated as a possible neighbor or peering-session failure - check <code>network_iosxr_bgp_established_pct</code> and <code>network_iosxr_bgp_session_uptime</code> for the same device immediately.</p>
related_info = <ul><li><b>path_attributes_entry_count</b><br>IOS-XR global BGP RIB path-attribute entry counter, a proxy for total learned-route scale.</li><li><b>See also</b><br><code>network_iosxr_bgp_memory_use</code> - path-count growth is the most common driver of rising BGP memory consumption.</li></ul>
search = | mstats latest("Cisco-IOS-XR-ipv4-bgp-oper:bgp/instances/instance/instance-active/default-vrf/process-info.global/path_attributes_entry_count") AS path_count WHERE `index_network` span=5m BY source\
| eval status = if(path_count > 500000, "HIGH", if(path_count < 50000, "LOW", "OK"))\
| bin _time span=5m\
| stats latest(path_count) AS path_count values(status) AS status BY source

[network_iosxr_bgp_restart_count]
search_name = Network - BGP Restart Count
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-08-04 00:00:00
date_updated = 2026-08-04 00:00:00
category = Network
sub_category = Routing
tags = Cisco IOS-XR,BGP,Streaming Telemetry,Process Restart,Stability
dispatch_context = splunk-cisco-dashboards
dispatch_context_force = 1
default_viz = splunk.area
description = <p>Trends the <b>BGP process restart counter</b> per IOS-XR device, flagging <b>WARNING</b> whenever more than one restart has been recorded.</p>
explanation = <p><code>mstats</code> reads <code>restart_count</code> from <code>Cisco-IOS-XR-ipv4-bgp-oper:...process-info.global</code> streaming telemetry per <code>source</code> every 5 minutes. Any increase in this counter means the BGP process itself has restarted (as opposed to an individual neighbor session resetting), which briefly drops every session on the device and forces a full table re-advertisement. No equivalent process-level BGP stability signal exists elsewhere in the catalog - ThousandEyes BGP content only observes external path-change behavior, not router-side process health.</p>
solution = <p>A restart_count increase should be correlated against device syslogs/crash logs and <code>network_iosxr_bgp_established_pct</code> for the same device around the same timestamp - a genuine process crash/restart will show a simultaneous drop in established-neighbor percentage and a spike in update-message rate as sessions re-converge.</p>
related_info = <ul><li><b>restart_count</b><br>IOS-XR global BGP process restart counter; each increment represents a full process bounce, not a single-neighbor reset.</li><li><b>See also</b><br><code>network_iosxr_bgp_established_pct</code> to confirm session-wide impact from a restart event.</li></ul>
search = | mstats latest("Cisco-IOS-XR-ipv4-bgp-oper:bgp/instances/instance/instance-active/default-vrf/process-info.global/restart_count") AS restart_count WHERE `index_network` span=5m BY source\
| eval status = if(restart_count > 1, "WARNING", "OK")\
| timechart span=5m values(restart_count) AS restart_count BY source

[network_iosxr_bgp_avg_convergence_time]
search_name = Network - Average BGP Convergence Time
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-08-04 00:00:00
date_updated = 2026-08-04 00:00:00
category = Network
sub_category = Routing
tags = Cisco IOS-XR,BGP,Streaming Telemetry,Convergence,Control Plane
dispatch_context = splunk-cisco-dashboards
dispatch_context_force = 1
default_viz = splunk.singlevalue
description = <p>Estimates <b>average BGP convergence time</b> (inbound UPDATE processing time divided by UPDATE count) per IOS-XR device, flagging <b>SLOW above 1000</b>.</p>
explanation = <p><code>mstats</code> reads <code>inbound_update_messages_time</code> and <code>update_messages_received</code> from <code>Cisco-IOS-XR-ipv4-bgp-oper:...process-info</code> streaming telemetry per <code>source</code>; <code>avg_convergence_time</code> is the ratio of cumulative processing time to UPDATE count, an approximation of per-update processing latency, flagged SLOW above 1000. Internal BGP convergence-latency telemetry is entirely new coverage - the catalog's existing BGP content (ThousandEyes) measures external path-change events, not router-side control-plane processing speed. The original panel's final <code>stats</code> step dropped the numeric <code>avg_convergence_time</code> field and kept only <code>status</code>; this stanza restores <code>latest(avg_convergence_time)</code> alongside status so the single-value tile shows the actual figure rather than just the text label, without altering any threshold logic.</p>
solution = <p>A SLOW device is spending unusually long processing each inbound UPDATE, which can precede visible convergence delays during a real routing event. Check CPU utilization and BGP memory pressure on the same device, and monitor <code>network_iosxr_bgp_update_rate</code> to see whether high message volume is the driver.</p>
related_info = <ul><li><b>Restored field</b><br>Added <code>latest(avg_convergence_time)</code> to the final <code>stats</code> - the source panel's pipeline computed this value but never carried it into its own output.</li><li><b>See also</b><br><code>network_iosxr_bgp_update_rate</code> for the message-volume side of convergence pressure.</li></ul>
search = | mstats latest("Cisco-IOS-XR-ipv4-bgp-oper:bgp/instances/instance/instance-active/default-vrf/process-info.performance_statistics/vrf/inbound_update_messages_time") AS update_time latest("Cisco-IOS-XR-ipv4-bgp-oper:bgp/instances/instance/instance-active/default-vrf/process-info.vrf/update_messages_received") AS updates_received WHERE `index_network` span=5m BY source\
| eval avg_convergence_time = if(updates_received > 0, update_time / updates_received, 0)\
| eval status = if(avg_convergence_time > 1000, "SLOW", "OK")\
| bin _time span=5m\
| stats latest(avg_convergence_time) AS avg_convergence_time values(status) AS status BY source

[network_iosxr_bgp_rib_connection_drops]
search_name = Network - BGP RIB Connection Drops
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-08-04 00:00:00
date_updated = 2026-08-04 00:00:00
category = Network
sub_category = Routing
tags = Cisco IOS-XR,BGP,Streaming Telemetry,RIB,IPv4/IPv6
dispatch_context = splunk-cisco-dashboards
dispatch_context_force = 1
default_viz = splunk.singlevalue
description = <p>Monitors <b>drops in the BGP-to-RIB connection</b> across both IPv4 and IPv6 address families per IOS-XR device, flagging <b>WARNING</b> on any drop.</p>
explanation = <p><code>mstats</code> reads <code>rib_connection_down_count</code> for both <code>ipv4rib_server</code> and <code>ipv6rib_server</code> from <code>Cisco-IOS-XR-ipv4-bgp-oper:...process-info.performance_statistics/global</code> streaming telemetry per <code>source</code>; <code>total_rib_drops</code> sums both families and WARNING fires above 1. A BGP-to-RIB connection drop means the BGP process temporarily lost its channel to install routes into the forwarding RIB - a serious control-plane fault with no equivalent visibility anywhere else in the catalog today. As with the convergence-time panel, the original pipeline's final <code>stats</code> only kept <code>status</code>; this stanza restores <code>latest(total_rib_drops)</code> so the single-value shows the actual drop count.</p>
solution = <p>Any RIB connection drop should be treated as a control-plane fault requiring immediate investigation - it can silently stall route installation even while BGP sessions themselves remain Established. Check IOS-XR RIB process health and correlate timing with <code>network_iosxr_bgp_restart_count</code> for the same device.</p>
related_info = <ul><li><b>Restored field</b><br>Added <code>latest(total_rib_drops)</code> to the final <code>stats</code> so the numeric drop count, not just the status label, is preserved for display.</li><li><b>See also</b><br><code>network_iosxr_bgp_restart_count</code> - RIB connection drops often accompany a BGP process bounce.</li></ul>
search = | mstats latest("Cisco-IOS-XR-ipv4-bgp-oper:bgp/instances/instance/instance-active/default-vrf/process-info.performance_statistics/global/ipv4rib_server/rib_connection_down_count") AS ipv4_rib_drops latest("Cisco-IOS-XR-ipv4-bgp-oper:bgp/instances/instance/instance-active/default-vrf/process-info.performance_statistics/global/ipv6rib_server/rib_connection_down_count") AS ipv6_rib_drops WHERE `index_network` span=5m BY source\
| eval total_rib_drops = ipv4_rib_drops + ipv6_rib_drops\
| eval status = if(total_rib_drops > 1, "WARNING", "OK")\
| bin _time span=5m\
| stats latest(total_rib_drops) AS total_rib_drops values(status) AS status BY source

[network_iosxr_bgp_session_uptime]
search_name = Network - BGP Session Uptime
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-08-04 00:00:00
date_updated = 2026-08-04 00:00:00
category = Network
sub_category = Routing
tags = Cisco IOS-XR,BGP,Streaming Telemetry,Neighbor Sessions,Flap Detection
dispatch_context = splunk-cisco-dashboards
dispatch_context_force = 1
default_viz = splunk.table
description = <p>Computes <b>BGP session uptime in minutes</b> (time since last established) per device from OpenConfig streaming telemetry, flagging <b>LOW</b> when uptime is under 5 minutes - a signal of a recently flapped or reset session.</p>
explanation = <p><code>mstats</code> reads <code>state.last_established</code> from the OpenConfig <code>bgp/neighbors/neighbor</code> tree per <code>source</code>; <code>session_uptime</code> converts the nanosecond epoch delta from now into minutes. Note the source panel groups this OpenConfig neighbor-level field only <code>BY source</code> (device), not by individual neighbor address, even though the underlying telemetry path is per-neighbor - this stanza preserves that exact grouping rather than inventing a <code>neighbor_address</code> dimension not present in the original query. Internal per-device BGP session-uptime tracking from OpenConfig model-driven telemetry has no existing equivalent in the catalog; ThousandEyes' BGP content only tracks external path-change events, not session state duration.</p>
solution = <p>A LOW session uptime on a device that should be stable indicates a recent flap or reset - immediately cross-reference <code>network_iosxr_bgp_session_state_trend</code> and <code>network_iosxr_bgp_flap_detection</code> to identify the specific neighbor and confirm whether it is an isolated blip or part of a wider instability pattern.</p>
related_info = <ul><li><b>state.last_established</b><br>OpenConfig BGP neighbor timestamp of the last transition into Established state.</li><li><b>Grouping note</b><br>Matches the source panel's <code>BY source</code> grouping exactly; per-neighbor breakout requires <code>network_iosxr_bgp_session_state_trend</code>, which does group by <code>neighbor_address</code>.</li></ul>
search = | mstats latest("openconfig:network-instances/network-instance/protocols/protocol/bgp/neighbors/neighbor/state.last_established") AS last_established WHERE `index_network` span=5m BY source\
| eval current_time = now() * 1000000000\
| eval session_uptime = (current_time - last_established) / 1000000000 / 60\
| eval session_uptime = round(session_uptime, 2)\
| eval status = if(session_uptime < 5 AND isnotnull(session_uptime), "LOW", "OK")\
| stats latest(session_uptime) AS session_uptime values(status) AS status BY source

[network_iosxr_bgp_notification_rate]
search_name = Network - BGP Notification Rate
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-08-04 00:00:00
date_updated = 2026-08-04 00:00:00
category = Network
sub_category = Routing
tags = Cisco IOS-XR,BGP,Streaming Telemetry,NOTIFICATION Messages,Anomaly Detection
dispatch_context = splunk-cisco-dashboards
dispatch_context_force = 1
default_viz = splunk.table
description = <p>Computes the combined <b>BGP NOTIFICATION message rate</b> (received + sent, per minute) per device from OpenConfig streaming telemetry, flagging <b>HIGH above 1/min</b>.</p>
explanation = <p><code>mstats rate()</code> reads OpenConfig <code>bgp/neighbors/neighbor/state.messages/received|sent/NOTIFICATION</code> counters per <code>source</code>; <code>total_notification_rate</code> combines both directions and scales to per-minute. As with the session-uptime panel, the source query groups only <code>BY source</code> rather than per neighbor, which this stanza preserves exactly. NOTIFICATION messages signal a BGP error condition (a session tear-down), so any non-zero sustained rate is operationally significant; this internal telemetry has no equivalent anywhere in the catalog today, where BGP coverage is limited to ThousandEyes' external synthetic path-change trend. Also corrected an apparent typo in the source pipeline's <code>bin _time span=5</code> (5 seconds) to <code>span=5m</code>, matching the 5-minute cadence used by every other bucket/eval in this same query and every sibling panel in the source dashboard.</p>
solution = <p>A HIGH notification rate means BGP sessions on that device are actively tearing down and re-establishing - treat it as an active-incident signal. Cross-reference <code>network_iosxr_bgp_flap_detection</code>, which tracks the same NOTIFICATION counters at neighbor granularity alongside connection-down and established-transition deltas, for the specific neighbor responsible.</p>
related_info = <ul><li><b>Typo fix</b><br>Corrected <code>bin _time span=5</code> to <code>span=5m</code> to match the 5-minute mstats span used throughout this query and its sibling panels.</li><li><b>See also</b><br><code>network_iosxr_bgp_flap_detection</code> for the same NOTIFICATION signal broken out per neighbor.</li></ul>
search = | mstats rate("openconfig:network-instances/network-instance/protocols/protocol/bgp/neighbors/neighbor/state.messages/received/NOTIFICATION") AS rx_notification_rate rate("openconfig:network-instances/network-instance/protocols/protocol/bgp/neighbors/neighbor/state.messages/sent/NOTIFICATION") AS tx_notification_rate WHERE `index_network` span=5m BY source\
| eval total_notification_rate = (rx_notification_rate + tx_notification_rate) * 60\
| eval total_notification_rate = round(total_notification_rate, 2)\
| eval status = if(total_notification_rate > 1, "HIGH", "OK")\
| bin _time span=5m\
| stats latest(total_notification_rate) AS total_notification_rate latest(status) AS status BY source

[network_iosxr_bgp_session_state_trend]
search_name = Network - BGP Session State Trends
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-08-04 00:00:00
date_updated = 2026-08-04 00:00:00
category = Network
sub_category = Routing Stability
tags = Cisco IOS-XR,BGP,Streaming Telemetry,FSM,Session State
dispatch_context = splunk-cisco-dashboards
dispatch_context_force = 1
default_viz = splunk.line
description = <p>Decodes and trends the <b>actual BGP finite-state-machine (FSM) state</b> per neighbor from GNMI streaming telemetry, naming each numeric state (Idle through Established) and flagging any non-Established state as alarming.</p>
explanation = <p><code>mstats max("GNMI_BGP.session_state") prestats=true</code> pulls the raw numeric FSM state per <code>neighbor_address</code> and <code>source</code> at 10-second resolution. Unlike every other stanza in this batch, this is not a metric-threshold trend - the <code>eval bgp_state=case(...)</code> maps the standard RFC 4271 BGP FSM integers (0=Idle, 1=Connect, 2=Active, 3=OpenSent, 4=OpenConfirm, 5=Established) into named states, and <code>is_alarming_state</code> flags anything short of Established. The result is timecharted per <code>source_neighbor</code>, giving genuine session-by-session FSM visibility rather than an aggregate up/down percentage. This decodes the actual protocol state machine - a capability entirely absent from the catalog's existing ThousandEyes-only BGP content, which has no concept of IOS-XR's internal FSM.</p>
solution = <p>Any neighbor whose state trend shows repeated cycling through Idle/Connect/Active rather than holding steady at Established is actively flapping or failing to negotiate a session (check AS number, capabilities, or hold-timer mismatches). Pair with <code>network_iosxr_bgp_flap_detection</code>, which quantifies the same instability as a scored delta across connection-down, transition, and NOTIFICATION counters for the same neighbor.</p>
related_info = <ul><li><b>GNMI_BGP.session_state</b><br>Raw RFC 4271 BGP FSM integer per neighbor, decoded here into human-readable states.</li><li><b>is_alarming_state</b><br>Boolean flag for any state other than Established; suitable for an overlay or alert rule on top of the trend.</li><li><b>See also</b><br><code>network_iosxr_bgp_flap_detection</code> for a scored, multi-signal view of the same neighbor-level instability.</li></ul>
search = | mstats max("GNMI_BGP.session_state") prestats=true WHERE `index_network` span=10s BY neighbor_address,source\
| rename psrsvd_nx_GNMI_BGP.session_state as session_state\
| fields _time,source,neighbor_address,session_state\
| table _time,source,neighbor_address,session_state\
| eval bgp_state=case(session_state=0, "Idle", session_state=1, "Connect", session_state=2, "Active", session_state=3, "OpenSent", session_state=4, "OpenConfirm", session_state=5, "Established", true(), "Unknown")\
| eval is_alarming_state=if(bgp_state = "Established", 0, 1)\
| eval source_neighbor = source + "_" + neighbor_address\
| timechart span=10s max(session_state) AS max_session_state BY source_neighbor useother=false

[network_iosxr_bgp_flap_detection]
search_name = Network - BGP Connection Drops due to Flapping
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-08-04 00:00:00
date_updated = 2026-08-04 00:00:00
category = Network
sub_category = Routing Stability
tags = Cisco IOS-XR,BGP,Streaming Telemetry,Flap Detection,Anomaly Detection
dispatch_context = splunk-cisco-dashboards
dispatch_context_force = 1
default_viz = splunk.table
description = <p>Scores <b>per-neighbor BGP instability</b> by computing rate-of-change deltas across four OpenConfig counters - connection-down count, established-state transitions, and NOTIFICATION messages received/sent - and surfaces only neighbors with active churn.</p>
explanation = <p><code>mstats</code> pulls four OpenConfig BGP neighbor counters per <code>source, neighbor_address</code> on a 5-minute cadence, then <code>streamstats current=f last(...)</code> captures each counter's prior-bucket value so <code>delta_*</code> evals isolate the change since the last sample rather than the cumulative counter value. <code>flap_score</code> sums all four deltas and <code>where flap_score > 0</code> keeps only neighbors with genuine new instability in that window. This is real rate-of-change anomaly detection across four independent BGP signals, not a single-metric threshold - a pattern with no counterpart in the catalog's existing ThousandEyes BGP content, which only tracks external path-change counts. <code>default_viz</code> is <code>splunk.table</code> because <code>splunk.sankey</code>, matching the source dashboard's original visualization, is not in this catalog's supported <code>default_viz</code> enum. A per-neighbor ascending time <code>result ranking</code> precedes <code>streamstats</code> so each neighbor's prior-bucket lookup is computed against a true time-ordered sequence.</p>
solution = <p>Any row returned here (flap_score &gt; 0) represents a neighbor with fresh instability in the last 5-minute window - drill into <code>network_iosxr_bgp_session_state_trend</code> for that same <code>source</code>/<code>neighbor_address</code> to see the FSM transitions directly, and check <code>network_iosxr_bgp_notification_rate</code> to see whether NOTIFICATION volume (protocol errors) or plain connection drops are the dominant contributor before engaging the peer's operator.</p>
related_info = <ul><li><b>flap_score</b><br>Sum of four per-window deltas (connection-down, established-transitions, NOTIFICATION rx, NOTIFICATION tx); a multi-signal instability score, not a single counter.</li><li><b>Viz fallback</b><br><code>splunk.sankey</code> (source visualization) is not a supported <code>default_viz</code> value in this catalog; falls back to <code>splunk.table</code>.</li><li><b>See also</b><br><code>network_iosxr_bgp_session_state_trend</code> for the FSM-level detail behind any flapping neighbor found here.</li></ul>
search = | mstats latest("openconfig:network-instances/network-instance/protocols/protocol/bgp/neighbors/neighbor/state.Cisco_IOS_XR_openconfig_bgp_ext:cisco/connection_down_count") AS connection_drops latest("openconfig:network-instances/network-instance/protocols/protocol/bgp/neighbors/neighbor/state.established_transitions") AS est_transitions latest("openconfig:network-instances/network-instance/protocols/protocol/bgp/neighbors/neighbor/state.messages/received/NOTIFICATION") AS notifications_received latest("openconfig:network-instances/network-instance/protocols/protocol/bgp/neighbors/neighbor/state.messages/sent/NOTIFICATION") AS notifications_sent WHERE `index_network` span=5m BY source, neighbor_address\
| streamstats current=f last(connection_drops) as prev_connection_drops last(est_transitions) as prev_est_transitions last(notifications_received) as prev_notifications_received last(notifications_sent) as prev_notifications_sent by source, neighbor_address\
| eval delta_connection_drops = connection_drops - coalesce(prev_connection_drops, 0)\
| eval delta_est_transitions = est_transitions - coalesce(prev_est_transitions, 0)\
| eval delta_notifications_received = notifications_received - coalesce(prev_notifications_received, 0)\
| eval delta_notifications_sent = notifications_sent - coalesce(prev_notifications_sent, 0)\
| eval flap_score = delta_connection_drops + delta_est_transitions + delta_notifications_received + delta_notifications_sent\
| where flap_score > 0\
| eval target = neighbor_address\
| stats max(flap_score) AS flap_score, max(delta_connection_drops) AS delta_connection_drops BY source, target, _time

[network_iosxr_isis_adjacency_uptime_pct]
search_name = Network - IS-IS Adjacency Uptime Percentage
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-08-04 00:00:00
date_updated = 2026-08-04 00:00:00
category = Network
sub_category = Routing Stability
tags = Cisco IOS-XR,IS-IS,Streaming Telemetry,Routing Stability,Adjacency Health
dispatch_context = splunk-cisco-dashboards
dispatch_context_force = 1
default_viz = splunk.table
description = <p>Table of <b>IS-IS adjacency stability</b> per device, computed from Cisco IOS-XR streaming telemetry, showing the percentage of adjacencies that have held for more than 24 hours.</p>
explanation = <p>Queries the <b>Cisco-IOS-XR-clns-isis-oper</b> streaming telemetry path for per-adjacency uptime, flags any adjacency under 24h (86400s) as unstable, and rolls up a per-source stable percentage. Status flips to <b>WARNING</b> below 95%. The catalog currently has zero dedicated IS-IS content-only a generic <code>%ISIS-</code> syslog mnemonic bucket inside the unrelated <code>it_critical_systems_route_flapping</code> stanza-so this is the first metric-based view into IS-IS adjacency health.</p>
solution = <p>Investigate any device below the 95% threshold for <b>flapping IS-IS neighbors</b>-check interface errors, hello/hold timers, and MTU mismatches before the adjacency drops and triggers an SPF recalculation.</p>
related_info = <ul><li><b>Companion metrics</b><br>Pair with <code>network_iosxr_isis_spf_run_rate</code> and <code>network_iosxr_isis_hello_drop_rate</code> in this batch to distinguish a single flapping adjacency from a broader reconvergence storm.</li></ul>
search = | mstats latest("Cisco-IOS-XR-clns-isis-oper:isis/instances/instance/levels/level/adjacencies/adjacency.adjacency_uptime") AS uptime WHERE `index_network` span=5m BY source\
| eval stable = if(uptime > 86400, 1, 0)\
| stats count AS total_adjacencies sum(stable) AS stable_adjacencies BY source\
| eval stable_percentage = if(total_adjacencies > 0, (stable_adjacencies / total_adjacencies) * 100, 0)\
| eval stable_percentage = round(stable_percentage, 2)\
| eval status = if(stable_percentage < 95, "WARNING", "OK")

[network_iosxr_isis_spf_run_rate]
search_name = Network - IS-IS SPF Run Rate per Minute
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-08-04 00:00:00
date_updated = 2026-08-04 00:00:00
category = Network
sub_category = Routing Stability
tags = Cisco IOS-XR,IS-IS,Streaming Telemetry,Routing Stability,SPF
dispatch_context = splunk-cisco-dashboards
dispatch_context_force = 1
default_viz = splunk.table
description = <p>Table with sparkline trend of <b>IS-IS SPF (Shortest Path First) recalculation rate per minute</b>, per device, derived from Cisco IOS-XR streaming telemetry SPF run counters.</p>
explanation = <p>Pulls the <code>spf_run_count</code> counter from <b>Cisco-IOS-XR-clns-isis-oper</b> telemetry, takes a 5-minute delta, and normalizes to a per-minute rate. Status flags <b>HIGH</b> above 10 SPF runs/min, an early signal of an <b>SPF storm</b> or repeated reconvergence caused by unstable adjacencies or LSP churn. No equivalent SPF-rate metric exists anywhere in the catalog today; IS-IS content prior to this batch was limited to a generic <code>%ISIS-</code> syslog mnemonic bucket.</p>
solution = <p>A sustained HIGH SPF rate indicates the topology is recalculating too frequently-correlate with <code>network_iosxr_isis_adjacency_uptime_pct</code> and <code>network_iosxr_isis_lsp_refresh_status</code> to find the flapping link or LSP source driving the reconvergence.</p>
related_info = <ul><li><b>delta p=1</b><br>Computes the change since the prior 5-minute sample so the rate reflects genuine SPF activity rather than a cumulative counter value.</li></ul>
search = | mstats latest("Cisco-IOS-XR-clns-isis-oper:isis/instances/instance/statistics-global.per_area_data/per_topology_data/statistics/spf_run_count") AS spf_count WHERE `index_network` span=5m BY source\
| delta spf_count AS spf_delta p=1\
| eval spf_rate = if(spf_delta >= 0, spf_delta / 5, 0)\
| eval status = if(spf_rate > 10, "HIGH", "OK")\
| bin span=5m _time\
| stats sparkline latest(spf_rate) AS spf_rate latest(status) AS status BY source

[network_iosxr_isis_hello_drop_rate]
search_name = Network - IS-IS Hello PDU Drop Rate
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-08-04 00:00:00
date_updated = 2026-08-04 00:00:00
category = Network
sub_category = Routing Stability
tags = Cisco IOS-XR,IS-IS,Streaming Telemetry,Routing Stability,Hello Protocol
dispatch_context = splunk-cisco-dashboards
dispatch_context_force = 1
default_viz = splunk.table
description = <p>Table with sparkline trend of <b>IS-IS Hello PDU drop rate per minute</b>, per device, from Cisco IOS-XR streaming telemetry.</p>
explanation = <p>Reads the <code>hello_stats/pdu_counters/pdu_dropped_count</code> field from <b>Cisco-IOS-XR-clns-isis-oper</b> telemetry, derives a per-minute drop rate via a 5-minute delta, and flags <b>WARNING</b> above 1 dropped Hello PDU/min. Dropped Hellos are a leading precursor to adjacency loss, since a device that stops receiving Hellos within the hold-timer window declares the neighbor down. This is the first dedicated IS-IS Hello-protocol metric in the catalog; prior IS-IS coverage was limited to a generic <code>%ISIS-</code> syslog mnemonic bucket.</p>
solution = <p>Investigate CPU load, input-queue drops (see <code>network_iosxr_isis_input_queue_drops</code>), or physical-layer errors on the flagged device before the adjacency times out and forces an SPF run.</p>
related_info = <ul><li><b>Precursor signal</b><br>Rising Hello drops typically precede adjacency flaps captured by <code>network_iosxr_isis_adjacency_uptime_pct</code>.</li></ul>
search = | mstats latest("Cisco-IOS-XR-clns-isis-oper:isis/instances/instance/statistics-global.statistics/hello_stats/pdu_counters/pdu_dropped_count") AS hello_drops WHERE `index_network` span=5m BY source\
| delta hello_drops AS drop_delta p=1\
| eval drop_rate = if(drop_delta >= 0, drop_delta / 5, 0)\
| eval status = if(drop_rate > 1, "WARNING", "OK")\
| bin _time span=5m\
| stats sparkline latest(drop_rate) AS drop_rate latest(status) AS status BY source

[network_iosxr_isis_route_count_rib]
search_name = Network - IS-IS Route Count in RIB
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-08-04 00:00:00
date_updated = 2026-08-04 00:00:00
category = Network
sub_category = Routing Stability
tags = Cisco IOS-XR,IS-IS,Streaming Telemetry,RIB,Routing Stability
dispatch_context = splunk-cisco-dashboards
dispatch_context_force = 1
default_viz = splunk.line
description = <p>Trended line chart of <b>active IS-IS routes installed in the RIB</b> per device, sourced from Cisco IOS-XR streaming telemetry.</p>
explanation = <p>Reads <code>number_of_active_routes</code> for the IS-IS protocol from the <b>Cisco-IOS-XR-ip-rib-ipv4-oper</b> path and timecharts it per source. Status flags <b>HIGH</b> above 10,000 routes (possible route leak or scale issue) and <b>LOW</b> below 500 (possible redistribution failure or topology loss). The catalog has no existing MPLS-TE/RIB-health content and no IS-IS route-count trend, so this closes both gaps at once.</p>
solution = <p>A HIGH count warrants checking redistribution policy and route-leaking configuration; a LOW count on a device that previously carried a full IS-IS route set suggests a redistribution or adjacency failure-cross-check against <code>network_iosxr_isis_adjacency_uptime_pct</code>.</p>
related_info = <ul><li><b>timechart BY source</b><br>Keeps each device's route-count trend on its own series for side-by-side comparison.</li></ul>
search = | mstats latest("Cisco-IOS-XR-ip-rib-ipv4-oper:rib/vrfs/vrf/afs/af/safs/saf/ip-rib-route-table-names/ip-rib-route-table-name/protocol/isis/as/information.number_of_active_routes") AS route_count WHERE `index_network` span=5m BY source\
| eval status = case(route_count > 10000, "HIGH", route_count < 500, "LOW", true(), "OK")\
| timechart span=5m latest(route_count) AS route_count BY source

[network_iosxr_isis_lsp_refresh_status]
search_name = Network - IS-IS LSP Refresh Status
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-08-04 00:00:00
date_updated = 2026-08-04 00:00:00
category = Network
sub_category = Routing Stability
tags = Cisco IOS-XR,IS-IS,Streaming Telemetry,Routing Stability,LSP
dispatch_context = splunk-cisco-dashboards
dispatch_context_force = 1
default_viz = splunk.singlevalue
description = <p>Single-value status of <b>IS-IS LSP (Link State PDU) refresh rate per minute</b>, per device, from Cisco IOS-XR streaming telemetry.</p>
explanation = <p>Derives a per-minute LSP refresh rate from the <code>system_lsp_refresh_count</code> counter in <b>Cisco-IOS-XR-clns-isis-oper</b> telemetry and flags <b>HIGH</b> above 5 refreshes/min-an LSP-flood signal that forces every device in the area to reprocess the database and re-run SPF. This is new IS-IS coverage; the catalog previously had none beyond a generic <code>%ISIS-</code> syslog mnemonic bucket.</p>
solution = <p>A HIGH LSP refresh rate suggests a misconfigured or flapping originator flooding updates-identify the source router and check its interface stability and LSP refresh-interval configuration before the flood destabilizes neighboring routers' SPF runs.</p>
related_info = <ul><li><b>Related instability signal</b><br>Often rises alongside <code>network_iosxr_isis_spf_run_rate</code> during a reconvergence event.</li></ul>
search = | mstats latest("Cisco-IOS-XR-clns-isis-oper:isis/instances/instance/statistics-global.per_area_data/statistics/system_lsp_refresh_count") AS lsp_refresh WHERE `index_network` span=5m BY source\
| delta lsp_refresh AS lsp_delta p=1\
| eval lsp_rate = if(lsp_delta >= 0, lsp_delta / 5, 0)\
| eval status = if(lsp_rate > 5, "HIGH", "OK")\
| stats latest(status) AS status BY source

[network_iosxr_isis_input_queue_drops]
search_name = Network - IS-IS Input Queue Drops
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-08-04 00:00:00
date_updated = 2026-08-04 00:00:00
category = Network
sub_category = Routing Stability
tags = Cisco IOS-XR,IS-IS,Streaming Telemetry,Routing Stability,CPU Health
dispatch_context = splunk-cisco-dashboards
dispatch_context_force = 1
default_viz = splunk.singlevalue
description = <p>Single-value status of <b>IS-IS process input-queue drop rate per minute</b>, per device, from Cisco IOS-XR streaming telemetry.</p>
explanation = <p>Reads the <code>process_input_queue/total_counts/pd_us_dropped</code> counter from <b>Cisco-IOS-XR-clns-isis-oper</b> telemetry and derives a per-minute drop rate, flagging <b>WARNING</b> above 1 drop/min. Input-queue drops on the IS-IS process indicate the router's control-plane CPU or process scheduler is overloaded and cannot keep up with incoming PDUs-a resource-overload indicator distinct from, but often correlated with, Hello PDU drops. This adds to the catalog's first dedicated IS-IS coverage beyond a generic syslog mnemonic bucket.</p>
solution = <p>Check overall route-processor CPU and memory utilization on the flagged device and look for a co-resident process consuming excessive cycles; sustained drops here put both Hello processing (<code>network_iosxr_isis_hello_drop_rate</code>) and SPF timeliness at risk.</p>
related_info = <ul><li><b>Resource-overload correlation</b><br>Rising alongside <code>network_iosxr_isis_hello_drop_rate</code> points to CPU/control-plane exhaustion rather than a link-layer problem.</li></ul>
search = | mstats latest("Cisco-IOS-XR-clns-isis-oper:isis/instances/instance/statistics-global.statistics/process_input_queue/total_counts/pd_us_dropped") AS queue_drops WHERE `index_network` span=5m BY source\
| delta queue_drops AS drop_delta p=1\
| eval drop_rate = if(drop_delta >= 0, drop_delta / 5, 0)\
| eval status = if(drop_rate > 1, "WARNING", "OK")\
| bin _time span=5m\
| stats latest(status) AS status BY source

[network_iosxr_mplste_up_p2p_head_pct]
search_name = Network - Percentage of Up P2P Head Tunnels
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-08-04 00:00:00
date_updated = 2026-08-04 00:00:00
category = Network
sub_category = MPLS Traffic Engineering
tags = Cisco IOS-XR,MPLS-TE,Streaming Telemetry,Tunnel Availability
dispatch_context = splunk-cisco-dashboards
dispatch_context_force = 1
default_viz = splunk.table
description = <p>Table with sparkline trend of the <b>percentage of P2P head-end MPLS-TE tunnels in the Up state</b>, per device, from Cisco IOS-XR streaming telemetry.</p>
explanation = <p>Queries <b>Cisco-IOS-XR-mpls-te-oper</b> tunnel-summary telemetry for total and up P2P head-end tunnel counts, computes the up-percentage, and flags <b>WARNING</b> below 95%. The catalog currently has zero MPLS-TE content of any kind, so this establishes the first head-end tunnel availability view for traffic-engineered paths.</p>
solution = <p>A device below 95% has one or more head-end tunnels down-check tunnel signaling (RSVP), path computation, and downstream link/label allocation failures before traffic falls back to best-effort IGP routing.</p>
related_info = <ul><li><b>Companion coverage</b><br>Pair with <code>network_iosxr_mplste_frr_coverage</code> and <code>network_iosxr_mplste_rerouted_rate</code> in this batch for a full head-end tunnel health picture.</li></ul>
search = | mstats latest("Cisco-IOS-XR-mpls-te-oper:mpls-te/tunnels/summary.p2p_head_tunnels") AS total_tunnels latest("Cisco-IOS-XR-mpls-te-oper:mpls-te/tunnels/summary.up_p2p_head_tunnels") AS up_tunnels WHERE `index_network` span=5m BY source\
| eval up_percentage = if(total_tunnels > 0, (up_tunnels / total_tunnels) * 100, 0)\
| eval up_percentage = round(up_percentage, 0)\
| eval status = if(up_percentage < 95, "WARNING", "OK")\
| bin _time span=5m\
| stats sparkline values(up_percentage) as up_percentage values(status) AS status BY source

[network_iosxr_mplste_frr_coverage]
search_name = Network - FRR Protection Coverage for P2P Head Tunnels
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-08-04 00:00:00
date_updated = 2026-08-04 00:00:00
category = Network
sub_category = MPLS Traffic Engineering
tags = Cisco IOS-XR,MPLS-TE,Streaming Telemetry,Fast Reroute
dispatch_context = splunk-cisco-dashboards
dispatch_context_force = 1
default_viz = splunk.table
description = <p>Table with sparkline trend of the <b>percentage of P2P head-end MPLS-TE tunnels protected by Fast Reroute (FRR)</b>, per device, from Cisco IOS-XR streaming telemetry.</p>
explanation = <p>Compares <code>frr_p2p_head_tunnels</code> to total <code>p2p_head_tunnels</code> from <b>Cisco-IOS-XR-mpls-te-oper</b> telemetry and flags <b>WARNING</b> below 90% FRR coverage. Low coverage means a link or node failure on those unprotected tunnels will fall back to slower IGP/RSVP reconvergence instead of sub-50ms FRR failover. This is new content-the catalog has no existing MPLS-TE protection-coverage metric.</p>
solution = <p>Identify head-end tunnels lacking an FRR backup and provision protection (link or node bypass) on their paths, prioritizing tunnels carrying latency-sensitive traffic.</p>
related_info = <ul><li><b>Availability pairing</b><br>Read alongside <code>network_iosxr_mplste_up_p2p_head_pct</code>-a tunnel that is Up but unprotected is still a single point of failure.</li></ul>
search = | mstats latest("Cisco-IOS-XR-mpls-te-oper:mpls-te/tunnels/summary.frr_p2p_head_tunnels") AS frr_tunnels latest("Cisco-IOS-XR-mpls-te-oper:mpls-te/tunnels/summary.p2p_head_tunnels") AS total_tunnels WHERE `index_network` span=5m BY source\
| eval frr_coverage = if(total_tunnels > 0, (frr_tunnels / total_tunnels) * 100, 0)\
| eval frr_coverage = round(frr_coverage, 0)\
| eval status = if(frr_coverage < 90, "WARNING", "OK")\
| bin _time span=5m\
| stats sparkline values(frr_coverage) AS frr_coverage values(status) AS status BY source

[network_iosxr_mplste_convergence_time]
search_name = Network - Tunnel Convergence Time
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-08-04 00:00:00
date_updated = 2026-08-04 00:00:00
category = Network
sub_category = MPLS Traffic Engineering
tags = Cisco IOS-XR,MPLS-TE,Streaming Telemetry,Convergence
dispatch_context = splunk-cisco-dashboards
dispatch_context_force = 1
default_viz = splunk.singlevalue
description = <p>Single-value status of <b>MPLS-TE tunnel convergence time</b> per device, derived from Cisco IOS-XR streaming telemetry's current-convergence summary counters.</p>
explanation = <p>Computes average per-tunnel convergence time (<code>tunnel_total_convergence_complete_time / tunnel_converged_count</code>) from <b>Cisco-IOS-XR-mpls-te-oper</b> telemetry and flags <b>SLOW</b> when the average exceeds 500 (ms). Slow convergence after a topology change means traffic-engineered tunnels take longer to re-signal around a failure, extending the outage window for traffic riding those tunnels. No MPLS-TE convergence metric exists anywhere in the catalog today.</p>
solution = <p>Investigate RSVP signaling load, path computation element (PCE) responsiveness, or a saturated control plane on any device reporting SLOW; sustained slow convergence widens the blast radius of any link/node failure on that router's head-end tunnels.</p>
related_info = <ul><li><b>Failure-response context</b><br>Pair with <code>network_iosxr_mplste_rerouted_rate</code>-frequent reroutes combined with SLOW convergence compound outage impact.</li></ul>
search = | mstats latest("Cisco-IOS-XR-mpls-te-oper:mpls-te/tunnels/summary.current_tunnel_convergence_summary/tunnel_total_convergence_complete_time") AS total_time latest("Cisco-IOS-XR-mpls-te-oper:mpls-te/tunnels/summary.current_tunnel_convergence_summary/tunnel_converged_count") AS converged_count WHERE `index_network` span=5m BY source\
| eval avg_convergence_time = if(converged_count > 0, total_time / converged_count, 0)\
| eval status = if(avg_convergence_time > 500, "SLOW", "OK")\
| bin _time span=5m\
| stats values(status) AS status BY source

[network_iosxr_mplste_autobackup_utilization]
search_name = Network - Autobackup Tunnel Utilization
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-08-04 00:00:00
date_updated = 2026-08-04 00:00:00
category = Network
sub_category = MPLS Traffic Engineering
tags = Cisco IOS-XR,MPLS-TE,Streaming Telemetry,Fast Reroute
dispatch_context = splunk-cisco-dashboards
dispatch_context_force = 1
default_viz = splunk.singlevalue
description = <p>Single-value status of <b>MPLS-TE autobackup tunnel utilization</b> per device, from Cisco IOS-XR streaming telemetry.</p>
explanation = <p>Computes the share of provisioned autobackup (auto-tunnel backup / FRR) tunnels that are Up and actually in use-<code>(up_autobackups - unused_autobackups) / total_autobackups</code>-from <b>Cisco-IOS-XR-mpls-te-oper</b> telemetry, flagging <b>LOW</b> below 50%. Low utilization means a large share of provisioned backup capacity is sitting idle or unavailable, which understates real FRR protection even if raw backup counts look healthy. This is new content; the catalog has no other MPLS-TE autobackup metric.</p>
solution = <p>On a LOW-status device, audit why provisioned autobackup tunnels are unused-check bandwidth reservation, path constraints, or backup-tunnel selection policy so protected traffic actually has a viable Fast Reroute path.</p>
related_info = <ul><li><b>FRR context</b><br>Complements <code>network_iosxr_mplste_frr_coverage</code>: coverage counts protected tunnels, this measures whether the backup capacity behind that protection is actually usable.</li></ul>
search = | mstats latest("Cisco-IOS-XR-mpls-te-oper:mpls-te/tunnels/summary.autobackup_summary/autobackups") AS total_autobackups latest("Cisco-IOS-XR-mpls-te-oper:mpls-te/tunnels/summary.autobackup_summary/up_autobackups") AS up_autobackups latest("Cisco-IOS-XR-mpls-te-oper:mpls-te/tunnels/summary.autobackup_summary/unused_autobackups") AS unused_autobackups WHERE `index_network` span=5m BY source\
| eval utilized_autobackups = up_autobackups - unused_autobackups\
| eval utilization = if(total_autobackups > 0, (utilized_autobackups / total_autobackups) * 100, 0)\
| eval utilization = round(utilization, 2)\
| eval status = if(utilization < 50, "LOW", "OK")\
| bin _time span=5m\
| stats values(status) AS status BY source

[network_iosxr_mplste_rerouted_rate]
search_name = Network - Rerouted P2P Head Tunnels Rate
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-08-04 00:00:00
date_updated = 2026-08-04 00:00:00
category = Network
sub_category = MPLS Traffic Engineering
tags = Cisco IOS-XR,MPLS-TE,Streaming Telemetry,Tunnel Stability
dispatch_context = splunk-cisco-dashboards
dispatch_context_force = 1
default_viz = splunk.singlevalue
description = <p>Single-value status of the <b>P2P head-end MPLS-TE tunnel reroute rate</b> per device, from Cisco IOS-XR streaming telemetry.</p>
explanation = <p>Derives a per-minute reroute rate from the <code>rerouted_p2p_head_tunnels</code> counter in <b>Cisco-IOS-XR-mpls-te-oper</b> telemetry and flags <b>HIGH</b> above 2 reroutes/min-an indicator of tunnel failure or path instability rather than a single one-off event. This is new coverage; the catalog has no existing MPLS-TE reroute-rate metric.</p>
solution = <p>A HIGH reroute rate points to a flapping link, node, or bandwidth-constrained path along one or more tunnels' primary routes-correlate with <code>network_iosxr_mplste_up_p2p_head_pct</code> and IS-IS SPF activity to locate the underlying instability.</p>
related_info = <ul><li><b>Instability correlation</b><br>Frequent reroutes alongside a rising <code>network_iosxr_isis_spf_run_rate</code> suggest the same underlying topology event is affecting both IGP and TE control planes.</li></ul>
search = | mstats latest("Cisco-IOS-XR-mpls-te-oper:mpls-te/tunnels/summary.rerouted_p2p_head_tunnels") AS rerouted_tunnels WHERE `index_network` span=5m BY source\
| delta rerouted_tunnels AS reroute_delta p=1\
| eval reroute_rate = if(reroute_delta >= 0, reroute_delta / 5, 0)\
| eval status = if(reroute_rate > 2, "HIGH", "OK")\
| bin _time span=5m\
| stats values(status) AS status BY source

[network_iosxr_rib_route_churn_rate]
search_name = Network - Route Churn Rate
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-08-04 00:00:00
date_updated = 2026-08-04 00:00:00
category = Network
sub_category = Routing
tags = Cisco IOS-XR,RIB,Streaming Telemetry,Routing Stability
dispatch_context = splunk-cisco-dashboards
dispatch_context_force = 1
default_viz = splunk.table
description = <p>Table with sparkline trend of <b>RIB-wide route churn rate per minute</b>, per device, from Cisco IOS-XR streaming telemetry.</p>
explanation = <p>Counts <code>route_modify_time</code> samples from the <b>Cisco-IOS-XR-ip-rib-ipv4-oper</b> path as a proxy for route modifications, derives a per-minute churn rate, and flags <b>HIGH</b> above 10 modifications/min. This measures RIB-wide instability directly from the routing table itself, independent of any single protocol-distinct from the existing syslog-mnemonic-based <code>it_critical_systems_route_flapping</code> stanza, which only counts IOS log lines for OSPF/EIGRP/BGP/LDP/IS-IS. The catalog has no prior RIB-level churn metric.</p>
solution = <p>Sustained HIGH churn indicates the forwarding table itself is unstable regardless of which protocol is contributing routes-cross-reference with per-protocol signals (<code>network_iosxr_isis_spf_run_rate</code>, BGP session-state panels, <code>it_critical_systems_route_flapping</code>) to isolate the source before it affects forwarding consistency.</p>
related_info = <ul><li><b>Distinct from syslog-based flapping detection</b><br><code>it_critical_systems_route_flapping</code> counts IOS log mnemonics; this panel measures actual RIB route-modify events directly from streaming telemetry, catching churn that may not generate a matching syslog message.</li></ul>
search = | mstats count("Cisco-IOS-XR-ip-rib-ipv4-oper:rib/vrfs/vrf/afs/af/safs/saf/ip-rib-route-table-names/ip-rib-route-table-name/routes/route.route_modify_time") AS modify_count WHERE `index_network` span=5m BY source\
| delta modify_count AS churn_delta p=1\
| eval churn_rate = if(churn_delta >= 0, churn_delta / 5, 0)\
| eval status = if(churn_rate > 10, "HIGH", "OK")\
| bin _time span=5m\
| stats sparkline latest(churn_rate) AS churn_rate latest(status) AS status BY source

[network_iosxr_rib_avg_route_age]
search_name = Network - Average Route Age
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-08-04 00:00:00
date_updated = 2026-08-04 00:00:00
category = Network
sub_category = Routing
tags = Cisco IOS-XR,RIB,Streaming Telemetry,Route Age
dispatch_context = splunk-cisco-dashboards
dispatch_context_force = 1
default_viz = splunk.pie
description = <p>Pie/donut breakdown of <b>average RIB route age</b> (hours) per device, from Cisco IOS-XR streaming telemetry.</p>
explanation = <p>Averages <code>route_age</code> across routes in the <b>Cisco-IOS-XR-ip-rib-ipv4-oper</b> path, converts to hours, and flags <b>STALE</b> above 168 hours (7 days). Very old average route age can indicate routes that never got refreshed by a withdrawn-and-reinstalled cycle, masking a stuck or orphaned entry the network no longer intends to carry. This is new RIB-health content; no equivalent route-age metric exists in the catalog today.</p>
solution = <p>Investigate any STALE device for routes that should have aged out or been withdrawn-verify redistribution and route-map refresh behavior, and confirm the routes are still intentionally present rather than orphaned.</p>
related_info = <ul><li><b>RIB health family</b><br>Complements <code>network_iosxr_rib_route_churn_rate</code> (too much change) and <code>network_iosxr_rib_path_diversity_pic</code> (too little redundancy) to round out RIB-level visibility.</li></ul>
search = | mstats avg("Cisco-IOS-XR-ip-rib-ipv4-oper:rib/vrfs/vrf/afs/af/safs/saf/ip-rib-route-table-names/ip-rib-route-table-name/routes/route.route_age") AS avg_age WHERE `index_network` span=5m BY source\
| eval avg_age_hours = avg_age / 3600\
| eval avg_age_hours = round(avg_age_hours, 2)\
| eval status = if(avg_age_hours > 168, "STALE", "OK")\
| bin _time span=1h\
| stats latest(avg_age_hours) AS avg_age_hours values(status) as status BY source

[network_iosxr_rib_path_diversity_pic]
search_name = Network - Path Diversity (Average PIC Count)
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-08-04 00:00:00
date_updated = 2026-08-04 00:00:00
category = Network
sub_category = Routing
tags = Cisco IOS-XR,RIB,Streaming Telemetry,Fast Reroute
dispatch_context = splunk-cisco-dashboards
dispatch_context_force = 1
default_viz = splunk.singlevalue
description = <p>Single-value status of <b>average Prefix-Independent Convergence (PIC) path count</b> per device, from Cisco IOS-XR streaming telemetry.</p>
explanation = <p>Averages <code>pic_count</code>-the number of pre-computed backup paths per route-from the <b>Cisco-IOS-XR-ip-rib-ipv4-oper</b> path and flags <b>LOW</b> below 2. A low average PIC count means most routes have little or no fast-reroute path diversity in the RIB, so a link or node failure is more likely to require a full reconvergence instead of an instant PIC-protected switchover. No equivalent path-diversity metric exists anywhere in the catalog today.</p>
solution = <p>On a LOW-status device, review IGP/BGP topology and ECMP/backup-path availability for the affected VRF/AFI-SAFI-insufficient path diversity leaves routes without fast-reroute protection at the RIB level.</p>
related_info = <ul><li><b>RIB health family</b><br>Read alongside <code>network_iosxr_rib_route_churn_rate</code> and <code>network_iosxr_rib_avg_route_age</code> for a complete view of routing-table health beyond per-protocol adjacency states.</li></ul>
search = | mstats avg("Cisco-IOS-XR-ip-rib-ipv4-oper:rib/vrfs/vrf/afs/af/safs/saf/ip-rib-route-table-names/ip-rib-route-table-name/routes/route.pic_count") AS avg_pic_count WHERE `index_network` span=5m BY source\
| eval avg_pic_count = round(avg_pic_count, 2)\
| eval status = if(avg_pic_count < 2, "LOW", "OK")\
| bin _time span=5m\
| stats values(avg_pic_count) AS avg_pic_count values(status) AS status BY source

[network_iosxr_optical_pre_fec_ber]
search_name = Network - Average Pre-FEC Bit Error Rate
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-08-04 00:00:00
date_updated = 2026-08-04 00:00:00
category = Network
sub_category = Optical Transport
tags = Cisco IOS-XR,Optical,Streaming Telemetry,Transceiver Health,FEC
dispatch_context = splunk-cisco-dashboards
dispatch_context_force = 1
default_viz = splunk.singlevalue
description = <p>Average pre-Forward Error Correction (pre-FEC) bit error rate per Cisco IOS-XR optical transport node, sourced from streaming telemetry.</p>
explanation = <p>Reads the <code>Cisco-IOS-XR-controller-optics-oper</code> pre_fec_ber sensor path via <code>mstats</code> against the network metrics index. Pre-FEC BER is the raw error rate measured before forward error correction repairs it, so it is the earliest available signal that a coherent-optics link is degrading, well before FEC exhaustion causes an actual outage. A value above 0.00001 is flagged HIGH. This is the first optical/transceiver-health content added to the catalog - previously there was zero coverage of coherent optics telemetry from IOS-XR streaming telemetry.</p>
solution = <p>If status is HIGH, correlate with <code>network_iosxr_optical_uncorrected_ber_pct</code> and <code>network_iosxr_optical_low_snr_lanes_pct</code> for the same source. Inspect the physical link for dirty/degraded fiber connectors, check transmit/receive power levels, and review recent optical amplifier or DWDM changes upstream. A sustained HIGH reading with rising uncorrected BER indicates the link is approaching FEC failure and should be scheduled for maintenance before it drops.</p>
related_info = <ul><li>Companion optical-health stanzas in this same batch: network_iosxr_optical_uncorrected_ber_pct, network_iosxr_optical_tx_power, network_iosxr_optical_low_snr_lanes_pct.</li><li>The source panel's final `stats` only preserved the `status` field; this adaptation also preserves the underlying `avg_pre_fec_ber` value (computed earlier in the same pipeline) so the singlevalue shows a real number, not just a status string.</li></ul>
search = | mstats avg("Cisco-IOS-XR-controller-optics-oper:optics-oper/optics-ports/optics-port/optics-info.ext_param_val/pre_fec_ber") AS avg_pre_fec_ber WHERE `index_network` span=5m BY source\
| eval avg_pre_fec_ber = if(isnotnull(avg_pre_fec_ber), round(avg_pre_fec_ber, 10), 0)\
| eval status = if(avg_pre_fec_ber > 0.00001, "HIGH", "OK")\
| bin _time span=5m\
| stats latest(avg_pre_fec_ber) AS avg_pre_fec_ber latest(status) AS status BY source

[network_iosxr_optical_uncorrected_ber_pct]
search_name = Network - Percentage of Ports with High Uncorrected BER
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-08-04 00:00:00
date_updated = 2026-08-04 00:00:00
category = Network
sub_category = Optical Transport
tags = Cisco IOS-XR,Optical,Streaming Telemetry,Transceiver Health,BER
dispatch_context = splunk-cisco-dashboards
dispatch_context_force = 1
default_viz = splunk.singlevalue
description = <p>Percentage of optical ports per Cisco IOS-XR node where the post-FEC uncorrected bit error rate exceeds the device's own alarm-high threshold.</p>
explanation = <p>Pulls <code>uncorrected_ber</code> and its paired <code>uncorrected_ber_alarm_high_threshold</code> field from the same optics-oper streaming telemetry sensor group via `mstats`, so the comparison uses the threshold the device itself reports rather than a hardcoded constant. Uncorrected BER (the error rate remaining after FEC correction) is the strongest available signal of an actively failing optical link - some errors are getting through despite correction. A percentage above 5% of ports on a node is flagged HIGH. This is part of the first optical/transceiver-health content in the catalog; there is no existing coverage of coherent-optics BER anywhere else.</p>
solution = <p>Treat a HIGH status as urgent - unlike pre-FEC BER (an early warning), uncorrected errors are already reaching upper-layer protocols and can cause packet loss or BGP/IS-IS flaps. Identify the specific affected port(s) on the node, check for degraded transceivers, dirty connectors, or fiber bend/attenuation issues, and consider proactively failing over traffic off the affected link while it is serviced.</p>
related_info = <ul><li>Companion optical-health stanzas in this same batch: network_iosxr_optical_pre_fec_ber, network_iosxr_optical_tx_power, network_iosxr_optical_low_snr_lanes_pct.</li><li>The source panel's final `stats` only preserved the `status` field; this adaptation also preserves the underlying `high_uncorrected_percentage` value so the singlevalue shows a real number, not just a status string.</li></ul>
search = | mstats latest("Cisco-IOS-XR-controller-optics-oper:optics-oper/optics-ports/optics-port/optics-info.ext_param_val/uncorrected_ber") AS uncorrected_ber latest("Cisco-IOS-XR-controller-optics-oper:optics-oper/optics-ports/optics-port/optics-info.ext_param_threshold_val/uncorrected_ber_alarm_high_threshold") AS threshold WHERE `index_network` span=5m BY source\
| eval is_high = if(uncorrected_ber > threshold AND isnotnull(uncorrected_ber) AND isnotnull(threshold), 1, 0)\
| eval total_ports = if(isnotnull(uncorrected_ber), 1, 0)\
| stats sum(total_ports) AS total_ports sum(is_high) AS high_uncorrected_ports BY _time, source\
| eval high_uncorrected_percentage = if(total_ports > 0, (high_uncorrected_ports / total_ports) * 100, 0)\
| eval high_uncorrected_percentage = round(high_uncorrected_percentage, 2)\
| eval status = if(high_uncorrected_percentage > 5, "HIGH", "OK")\
| bin _time span=15m\
| stats latest(high_uncorrected_percentage) AS high_uncorrected_percentage latest(status) AS status BY source

[network_iosxr_optical_tx_power]
search_name = Network - Average Transmit Power (dBm)
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-08-04 00:00:00
date_updated = 2026-08-04 00:00:00
category = Network
sub_category = Optical Transport
tags = Cisco IOS-XR,Optical,Streaming Telemetry,Transceiver Health,Transmit Power
dispatch_context = splunk-cisco-dashboards
dispatch_context_force = 1
default_viz = splunk.table
description = <p>Average optical transmit power (dBm) per Cisco IOS-XR node, trended with a sparkline, flagged when outside the safe operating range.</p>
explanation = <p>Averages the <code>transmit_power</code> lane-data field from the optics-oper streaming telemetry sensor group via `mstats`. Transmit power outside the transceiver's rated range (below -10 dBm or above 4 dBm here) indicates either a failing laser/optic (too low) or a misconfigured/overdriven amplifier stage (too high), both of which degrade link margin and increase bit errors downstream. Part of the catalog's first optical/transceiver-health coverage.</p>
solution = <p>For OUT_OF_RANGE sources, check the physical transceiver's reported power against its datasheet range. Low power often means a failing laser, a dirty/damaged connector, or excess fiber attenuation (splices, bends) - clean or replace the optic/patch. High power can indicate an amplifier misconfiguration and risks damaging the receiving optic - reduce output or verify amplifier gain settings.</p>
related_info = <ul><li>Companion optical-health stanzas in this same batch: network_iosxr_optical_pre_fec_ber, network_iosxr_optical_uncorrected_ber_pct, network_iosxr_optical_low_snr_lanes_pct.</li></ul>
search = | mstats avg("Cisco-IOS-XR-controller-optics-oper:optics-oper/optics-ports/optics-port/optics-info.lane_data/transmit_power") AS avg_tx_power WHERE `index_network` span=5m BY source\
| eval avg_tx_power = if(isnotnull(avg_tx_power), round(avg_tx_power, 2), 0)\
| eval status = if(avg_tx_power < -10 OR avg_tx_power > 4, "OUT_OF_RANGE", "OK")\
| bin _time span=5m\
| stats sparkline latest(avg_tx_power) AS avg_tx_power latest(status) AS status BY source

[network_iosxr_optical_low_snr_lanes_pct]
search_name = Network - Percentage of Lanes with Low SNR
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-08-04 00:00:00
date_updated = 2026-08-04 00:00:00
category = Network
sub_category = Optical Transport
tags = Cisco IOS-XR,Optical,Streaming Telemetry,Coherent Optics,SNR
dispatch_context = splunk-cisco-dashboards
dispatch_context_force = 1
default_viz = splunk.table
description = <p>Percentage of coherent-optics lanes per Cisco IOS-XR node where signal-to-noise ratio (SNR) is below the device-reported warn-low threshold, trended with a sparkline.</p>
explanation = <p>Compares each of the two coherent-optics lanes' <code>snr_lane1</code>/<code>snr_lane2</code> values against the device's own <code>snr_warn_low_threshold</code> field via `mstats`, rather than a hardcoded SNR floor. Low SNR reduces the margin available for FEC to correct errors and is often an earlier indicator of link degradation than BER alone, since it reflects the underlying optical signal quality rather than the downstream error count. A rate above 10% of lanes is flagged LOW. Part of the catalog's first optical/transceiver-health coverage.</p>
solution = <p>For a LOW status, identify the specific lane(s) below threshold and correlate with network_iosxr_optical_tx_power and network_iosxr_optical_pre_fec_ber for the same source - a low-SNR lane with rising pre-FEC BER is a strong leading indicator of an impending link failure. Check amplifier gain, dispersion compensation settings, and physical fiber quality on the affected span.</p>
related_info = <ul><li>Companion optical-health stanzas in this same batch: network_iosxr_optical_pre_fec_ber, network_iosxr_optical_uncorrected_ber_pct, network_iosxr_optical_tx_power.</li></ul>
search = | mstats latest("Cisco-IOS-XR-controller-optics-oper:optics-oper/optics-ports/optics-port/optics-info.ext_param_val/snr_lane1") AS snr_lane1 latest("Cisco-IOS-XR-controller-optics-oper:optics-oper/optics-ports/optics-port/optics-info.ext_param_val/snr_lane2") AS snr_lane2 latest("Cisco-IOS-XR-controller-optics-oper:optics-oper/optics-ports/optics-port/optics-info.ext_param_threshold_val/snr_warn_low_threshold") AS snr_threshold WHERE `index_network` span=5m BY source\
| eval lane1_low = if(snr_lane1 < snr_threshold AND isnotnull(snr_lane1), 1, 0)\
| eval lane2_low = if(snr_lane2 < snr_threshold AND isnotnull(snr_lane2), 1, 0)\
| eval total_lanes = if(isnotnull(snr_lane1), 1, 0) + if(isnotnull(snr_lane2), 1, 0)\
| eval low_snr_lanes = lane1_low + lane2_low\
| stats sum(total_lanes) AS total_lanes sum(low_snr_lanes) AS low_snr_lanes BY _time, source\
| eval low_snr_percentage = if(total_lanes > 0, (low_snr_lanes / total_lanes) * 100, 0)\
| eval low_snr_percentage = round(low_snr_percentage, 2)\
| eval status = if(low_snr_percentage > 10, "LOW", "OK")\
| bin _time span=5m\
| stats sparkline latest(low_snr_percentage) AS low_snr_percentage latest(status) AS status BY source

[network_iosxr_vrf_route_anomaly_zscore]
search_name = Network - VRF Route Count Anomaly (z-score)
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-08-04 00:00:00
date_updated = 2026-08-04 00:00:00
category = Network
sub_category = Anomaly Detection
tags = Cisco IOS-XR,Anomaly Detection,BGP,VRF,Statistical Baseline
dispatch_context = splunk-cisco-dashboards
dispatch_context_force = 1
default_viz = splunk.table
description = <p>Flags VRF route-count readings that deviate statistically from their own time-of-day baseline, per source/VRF/node/protocol, using a z-score computed over a rolling 2-day window.</p>
explanation = <p>Averages the FIB route-summary count per VRF via `mstats`, then buckets each reading by hour-of-day (<code>time_of_day</code>) and uses `eventstats` to compute a mean and standard deviation per time-of-day/source/vrf_name/node_name/protocol_name combination - i.e. it learns what a "normal" route count looks like for that VRF at that hour, rather than using a single flat threshold. Any reading more than 1.5 standard deviations from its own baseline is flagged as an anomaly, with an <code>anomaly_score</code> that decays as the z-score grows. A sudden route-count anomaly on a VRF usually means a route leak, a flapping peer re-advertising routes, or an unexpected topology change. This time-of-day-baseline z-score pattern is a reusable statistical-baseline template - the catalog currently only uses this exact pattern once elsewhere (an occupancy-surge-detection stanza in an unrelated domain) and never for routing/VRF data, making this a genuinely new application of an existing technique.</p>
solution = <p>Investigate flagged rows starting with the highest anomaly_score. Check for recent BGP/IGP route churn, a newly flapping neighbor, or a configuration change on the affected VRF/node. If the anomaly correlates with a maintenance window, it may be expected; if not, treat it as an early signal of route leakage or an unplanned topology change worth confirming with the routing team.</p>
related_info = <ul><li>Reuses the same time-of-day eventstats baseline/z-score pattern already in the catalog for occupancy-surge detection, applied here for the first time to BGP/VRF route-count data.</li><li>Uses a relative 2-day lookback (`earliest=-2d@d`) inside the `mstats` clause so the eventstats baseline has enough history regardless of the dispatched time range.</li></ul>
search = | mstats avg("Cisco-IOS-XR-fib-common-oper:fib/nodes/node/protocols/protocol/vrfs/vrf/summary.routes") AS avg_current_routes WHERE `index_network` earliest=-2d@d latest=now span=15m BY source,vrf_name,node_name,protocol_name\
| eval vrf_name=replace(vrf_name, "\*+", "iid")\
| eval time_of_day=strftime(_time, "%H")\
| eventstats avg(avg_current_routes) AS mean stdev(avg_current_routes) AS stdev BY time_of_day,source,vrf_name,node_name,protocol_name\
| eval z_score = abs((avg_current_routes - mean) / stdev)\
| eval is_anomaly = if(z_score > 1.5 AND isnotnull(z_score), 1, 0)\
| eval anomaly = if(is_anomaly == 1, "Yes", "No")\
| eval anomaly_score = if(isnotnull(z_score), round(1 / (1 + z_score), 3), 0)\
| search anomaly="Yes"\
| table _time, source, vrf_name, node_name, protocol_name, time_of_day, avg_current_routes, anomaly, anomaly_score

[network_iosxr_mltk_interface_error_anomaly]
search_name = Network - Interface Error Rate Anomalies (MLTK)
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-08-04 00:00:00
date_updated = 2026-08-04 00:00:00
category = Network
sub_category = Anomaly Detection
tags = Cisco IOS-XR,Anomaly Detection,MLTK,Interface Errors,Streaming Telemetry
dispatch_context = splunk-cisco-dashboards
dispatch_context_force = 1
default_viz = splunk.line
description = <p>Trends combined input+output interface error rate per Cisco IOS-XR router and overlays points flagged as statistical outliers by a pre-trained MLTK DensityFunction model.</p>
explanation = <p>Sums input and output error-counter rates from `mstats` streaming telemetry, filters to periods where the combined rate exceeds 1/sec, then applies a pre-trained Splunk MLTK DensityFunction model (<code>iface_err_df_model_v2</code>) to flag points that fall outside the model's learned normal-density boundaries. Unlike a fixed threshold, a density-function model adapts to each router's/interface's own typical error behavior, catching gradual drift or unusual spikes a static rule would miss.</p>
solution = <p>Treat overlaid anomaly points as a prompt to check the interface for physical issues (bad cabling, failing SFP, duplex mismatch) or upstream congestion. Correlate the anomaly window with recent config changes or maintenance activity on that router.</p>
related_info = <ul><li>IMPORTANT - depends on a pre-trained MLTK model artifact (`iface_err_df_model_v2`) that is not present in this environment. This stanza harvests the reusable SPL pattern (rate aggregation -&gt; threshold filter -&gt; `apply` a DensityFunction model -&gt; outlier flag); it will not execute successfully until that model is trained and saved in the target Splunk instance's MLTK app.</li><li>Companion stanza in this same batch: network_iosxr_mltk_interface_error_explain, which uses the same model to also produce a human-readable explanation.</li><li>The source panel hardcoded an absolute earliest/latest date range; this adaptation uses a relative `earliest=-7d` window instead.</li></ul>
search = | mstats rate("Cisco-IOS-XR-infra-statsd-oper:infra-statistics/interfaces/interface/generic-counters.input_errors") AS input_error_rate rate("Cisco-IOS-XR-infra-statsd-oper:infra-statistics/interfaces/interface/generic-counters.output_errors") AS output_error_rate WHERE `index_network` earliest=-7d span=5m BY source\
| eval total_error_rate = input_error_rate + output_error_rate\
| where total_error_rate > 1\
| apply app:iface_err_df_model_v2\
| eval is_anomaly = 'IsOutlier(total_error_rate)'\
| eval anomaly_point = if(is_anomaly=1, total_error_rate, null())\
| stats avg(total_error_rate) as total_error_rate avg(anomaly_point) as anomaly_point by _time

[network_iosxr_mltk_interface_error_explain]
search_name = Network - Interface Error Anomaly Explanations
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-08-04 00:00:00
date_updated = 2026-08-04 00:00:00
category = Network
sub_category = Anomaly Detection
tags = Cisco IOS-XR,Anomaly Detection,MLTK,Interface Errors,Explainability
dispatch_context = splunk-cisco-dashboards
dispatch_context_force = 1
default_viz = splunk.table
description = <p>Same interface-error-rate anomaly detection as network_iosxr_mltk_interface_error_anomaly, but additionally parses the MLTK model's decision boundaries into a plain-language root-cause explanation and recommended operator action per flagged row.</p>
explanation = <p>After applying the pre-trained DensityFunction model (`iface_err_df_model_v2`) and filtering to outlier points, this search parses the model's `BoundaryRanges` output text (via `rex`/`mvmap`/string-splitting) to recover the numeric high/low decision thresholds and their associated rarity probabilities, then classifies each outlier as a "HIGH spike", "LOW dip", or generic "DENSITY outlier" and builds a human-readable `why` column plus an `operator_action` column with a concrete next step. This explainable-anomaly pattern - translating an ML model's internal boundary output into an operator-facing sentence - is the single most novel SPL pattern harvested in this batch: it is a generic template that could be reused for any MLTK DensityFunction anomaly, in any domain, not just interface errors.</p>
solution = <p>Read the `why` and `operator_action` columns directly - they are generated per row and describe both what the model flagged and what to do about it (e.g. checking for packet drops/CRC errors on a HIGH spike, or checking for link flaps/routing adjacency issues on a LOW dip).</p>
related_info = <ul><li>IMPORTANT - depends on the same pre-trained MLTK model artifact (`iface_err_df_model_v2`) as network_iosxr_mltk_interface_error_anomaly, which is not present in this environment. This stanza harvests the reusable "explainable anomaly" SPL pattern; it will not execute successfully until that model is trained and saved in the target Splunk instance's MLTK app.</li><li>Companion stanza in this same batch: network_iosxr_mltk_interface_error_anomaly, which trends the raw metric and anomaly points without the explanation columns.</li><li>The source panel hardcoded an absolute earliest/latest date range; this adaptation uses a relative `earliest=-7d` window instead. Inline documentation comments present in the source panel were removed for catalog consistency; all structural logic (the boundary parsing, direction classification, why/operator_action text) is preserved unchanged.</li></ul>
search = | mstats rate("Cisco-IOS-XR-infra-statsd-oper:infra-statistics/interfaces/interface/generic-counters.input_errors") AS input_error_rate rate("Cisco-IOS-XR-infra-statsd-oper:infra-statistics/interfaces/interface/generic-counters.output_errors") AS output_error_rate WHERE `index_network` earliest=-7d span=5m BY source\
| eval total_error_rate = input_error_rate + output_error_rate\
| where total_error_rate > 1\
| apply app:iface_err_df_model_v2\
| eval is_outlier = 'IsOutlier(total_error_rate)'\
| where is_outlier=1\
| eval BoundaryRangesClean = replace(BoundaryRanges, "\r", "")\
| eval br = split(BoundaryRangesClean, "\n")\
| eval br = mvmap(br, trim(br))\
| eval high_line = mvindex(mvfilter(match(br, ":Infinity:")), 0)\
| eval low_line = mvindex(mvfilter(match(br, "^-Infinity:")), 0)\
| rex field=high_line "^(?<high_threshold_raw>[^:]+):Infinity:(?<high_p>[\d\.]+)"\
| rex field=low_line "^-Infinity:(?<low_threshold_raw>[^:]+):(?<low_p>[\d\.]+)"\
| eval high_threshold = tonumber(high_threshold_raw)\
| eval low_threshold = tonumber(low_threshold_raw)\
| eval direction = case(isnotnull(high_threshold) AND total_error_rate >= high_threshold, "HIGH spike", isnotnull(low_threshold) AND total_error_rate <= low_threshold, "LOW dip", true(), "DENSITY outlier")\
| eval ranges_one_line = if(len(BoundaryRangesClean)>0, replace(BoundaryRangesClean,"\n"," | "), null())\
| eval why = case(direction="HIGH spike", "Outlier per model: value " . round(total_error_rate,2) . " > " . round(coalesce(high_threshold,0),2) . " (rare-high p=" . coalesce(high_p,"n/a") . ")", direction="LOW dip", "Outlier per model: value " . round(total_error_rate,2) . " < " . round(coalesce(low_threshold,0),2) . " (rare-low p=" . coalesce(low_p,"n/a") . ")", true(), "Outlier per model (density-based): value " . round(total_error_rate,2) . " is statistically rare for this router. Boundaries: " . coalesce(ranges_one_line,"not provided by model"))\
| eval operator_action = case(direction="HIGH spike", "Check interface counters on " . source . " for packet drops or CRC errors. Verify optics, cabling, and recent config changes.", direction="LOW dip", "Verify interface operational status on " . source . ". Possible link flap or traffic interruption. Check syslog and routing adjacencies.", true(), "Investigate abnormal interface error behavior on " . source . ". Review interface statistics, recent changes, and correlated network events.")\
| table _time source total_error_rate direction why operator_action

[network_iosxr_bgp_acme_peer_loss]
search_name = Network - Peer Loss
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-08-04 00:00:00
date_updated = 2026-08-04 00:00:00
category = Network
sub_category = Routing Stability
tags = Cisco IOS-XR,BGP,Routing Stability,Streaming Telemetry,Peer Health
dispatch_context = splunk-cisco-dashboards
dispatch_context_force = 1
default_viz = splunk.table
description = <p>Tracks the gap between configured and capable BGP peers per source router, trended with a sparkline.</p>
explanation = <p>Reads the IOS-XR `show bgp ipv4 unicast summary` streaming telemetry counters for configured peers and capable peers via `mstats` (prestats mode), then computes <code>peer_loss = configuredpeers - capablepeers</code>. This is a genuinely distinct BGP health metric from the established-neighbor-percentage-style checks harvested elsewhere: it measures how many of the peers the router is configured to have are not currently in a capable (session-ready) state, which surfaces sessions stuck in a pre-established state (e.g. idle/connect/active) that a simple established-vs-total percentage can mask.</p>
solution = <p>A nonzero (and especially a rising) peer_loss value means one or more configured BGP peers are not reaching a capable state. Check neighbor reachability, TCP session state, and authentication/AS-path configuration for the affected peers on that source router.</p>
related_info = <ul><li>Distinct from an established-neighbor-percentage metric harvested from a different source dashboard in a parallel batch - this stanza specifically measures the configured-vs-capable peer delta, not the percentage of sessions in the Established state.</li></ul>
search = | mstats avg("show bgp ipv4 unicast summary.configuredpeers") AS configured_peers avg("show bgp ipv4 unicast summary.capablepeers") AS capable_peers prestats=true WHERE `index_network` span=10s by source\
| rename "psrsvd_sm_show bgp ipv4 unicast summary.configuredpeers" as configuredpeers, "psrsvd_sm_show bgp ipv4 unicast summary.capablepeers" as capablepeers\
| eval peer_loss = configuredpeers - capablepeers\
| stats sparkline avg(peer_loss) as avg_peer_loss values(configuredpeers) as configuredpeers values(capablepeers) as capablepeers BY _time,source\
| eval avg_peer_loss=round(avg_peer_loss,0)

[it_health_composite_service_alerts]
search_name = IT Health - Service Alerts
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-08-04 00:00:00
date_updated = 2026-08-04 00:00:00
category = IT Health
sub_category = Network Health
tags = Composite KPI,Cross-Domain,Executive,Alerting
dispatch_context = splunk-cisco-dashboards
dispatch_context_force = 1
default_viz = splunk.table
description = <p>Unified alert table correlating ThousandEyes web-service availability failures with BGP upstream-prefix-loss events, with a graceful empty-state row when nothing is currently alerting.</p>
explanation = <p>The ThousandEyes branch runs <code>tstats</code> with the <code>scd_summariesonly</code> macro against <code>Cisco_ThousandEyes.Test_Metrics</code>, filtered to <code>http-server</code> tests, and flags any minute where availability rounds to 0%. The BGP branch runs <code>mstats</code> against the accepted-prefix-count metric and flags when the accepted count drops below the expected minimum. Both branches are combined with <code>append</code>, rolled up with <code>stats count ... by alert_source, alert_message</code>, and then <code>union</code>-ed with a synthetic &quot;No Service Alerts&quot; row (via <code>makeresults</code>) so the table never renders empty -- an <code>eventstats</code>/<code>where</code> gate at the end ensures the placeholder row only survives when there truly are zero real alerts.</p>
solution = <p>Any row other than the &quot;No Service Alerts&quot; placeholder needs immediate triage: a ThousandEyes-sourced row means the monitored web service is down from the vantage point's perspective; a BGP-sourced row means an upstream router has stopped advertising the expected route, which can explain a ThousandEyes failure at the network layer.</p>
related_info = <ul><li><b>Provenance</b><br>Acme Labs demo dashboard, panel &quot;Service Alerts&quot;.</li><li><b>Index macro applied</b><br>The BGP branch's <code>WHERE index="cisco_metrics"</code> was replaced with the <code>index_network</code> macro per assignment, matching the same substitution used in <code>it_health_composite_service_health_score</code>'s BGP branch in this same batch.</li><li><b>Demo-specific text trimmed</b><br>The source panel's alert-message strings included emoji prefixes and a hardcoded lab tenant name (&quot;for Maple&quot;); these were dropped in favor of plain text so the alert text reads as a generic production message rather than a lab-specific one. The hardcoded <code>neighbor_address=10.30.4.137</code> peer IP and the account-id wildcard filter (already an effective no-op in the source panel) were otherwise left as the structural scoping this pattern needs.</li></ul>
search = | tstats `scd_summariesonly` avg(Test_Metrics.metric_name:http.server.request.availability) as avg_avail FROM datamodel="Cisco_ThousandEyes.Test_Metrics" WHERE Test_Metrics.thousandeyes.test.type="http-server" Test_Metrics.metric_name:http.server.request.availability=* BY _time span=1m\
| where isnotnull(avg_avail) AND round(avg_avail,2)=0\
| eval alert_message = "ALERT (ThousandEyes): web service is unavailable and service impacting. Current Availability: " . tostring(avg_avail) . "%"\
| eval alert_source = "ThousandEyes"\
| append [| mstats max("Cisco-IOS-XR-ipv4-bgp-oper:bgp/instances/instance/instance-active/vrfs/vrf/afs/af/neighbor-af-table/neighbor.af_data/prefixes_accepted") as prefixes_accepted WHERE `index_network` AND af_name="ipv4-unicast" span=1m BY neighbor_address, source | search neighbor_address=10.30.4.137 | eval kpi1_prefixes_health = if(prefixes_accepted >= 4, 100, 0) | where kpi1_prefixes_health = 0 | eval alert_message = "ALERT (BGP/Network): upstream router " . neighbor_address . " has stopped advertising the expected prefix count. Prefixes Accepted: " . tostring(prefixes_accepted) | eval alert_source = "BGP" | fields _time, alert_source, alert_message]\
| stats count as alert_count min(_time) as first_occurrence_epoch max(_time) as last_occurrence_epoch by alert_source, alert_message\
| eval first_occurrence = strftime(first_occurrence_epoch, "%Y-%m-%d %H:%M:%S")\
| eval last_occurrence = strftime(last_occurrence_epoch, "%Y-%m-%d %H:%M:%S")\
| eval is_actual_alert = 1\
| fields alert_source, alert_message, alert_count, first_occurrence, last_occurrence, is_actual_alert\
| union [| makeresults count=1 | eval alert_message="No Service Alerts" | eval alert_source=null(), alert_count=null(), first_occurrence=null(), last_occurrence=null() | eval is_actual_alert = 0 | fields alert_source, alert_message, alert_count, first_occurrence, last_occurrence, is_actual_alert]\
| eventstats sum(is_actual_alert) as total_actual_alerts\
| where is_actual_alert=1 OR total_actual_alerts=0\
| table alert_source, alert_message, alert_count, first_occurrence, last_occurrence

[dc_networking_messages_by_mnemonics_mnemonics]
search_name = DC Networking - Messages by mnemonics - Mnemonics
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-07-30 00:00:00
date_updated = 2026-07-30 00:00:00
category = Data Center Networking
sub_category = Nexus 9000 Platform
tags = Cisco DC Networking,Cisco Nexus 9000,Syslog
dispatch_context = cisco_dc_networking_app_for_splunk
dispatch_context_force = 0
default_viz = splunk.table
description = <p>Reports mnemonics from the Cisco DC Networking <code>Messages by mnemonics</code> dashboard.</p>
explanation = <p>Runs curated SPL from this app with app-owned index scoping and only the required exported source knowledge objects. Dashboard-only filters are neutralized so the search runs independently.</p>
solution = <p>Use the result to identify affected data-center entities and correlate changes with related operational events.</p>
related_info = <ul><li><b>Provenance</b><br><code>cisco_dc_networking_app_for_splunk</code> / <code>mnemonics_drilldown.xml</code>.</li></ul>
search = `index_dc` sourcetype=cisco:dc:nexus9k:syslog\
| lookup cisco_dc_nexus_hostname_lookup device AS host OUTPUT hostname AS hostname1\
| lookup cisco_dc_nexus_hostname_lookup device_without_port as host OUTPUT hostname as hostname2\
| eval Hostname = coalesce(hostname1, hostname2)\
| lookup cisco_dc_nexus_severity_lookup severity_id AS severity_id OUTPUT severity_name AS severity_name\
| stats latest(syslog_msg) as syslog_msg values(Hostname) as Hostname values(severity_name) as Severity values(severity_description) AS Description by _time,host,category,mnemonics\
| rename syslog_msg as Message host as deviceIP mnemonics as Mnemonics category AS Facility\
| fields _time Hostname deviceIP Facility Severity Message

[dc_networking_messages_by_severity_level_severity_messages]
search_name = DC Networking - Messages by severity level - Severity: messages
search_author = akhamis
updated_author = akhamis
version = 1.1.0
date_created = 2026-07-30 00:00:00
date_updated = 2026-08-01
category = Data Center Networking
sub_category = ACI Syslog & Events
tags = Cisco DC Networking,Cisco ACI,Cisco Nexus 9000,Syslog
dispatch_context = cisco_dc_networking_app_for_splunk
dispatch_context_force = 0
default_viz = splunk.table
description = <p>Reports severity: messages from the Cisco DC Networking <code>Messages by severity level</code> dashboard.</p>
explanation = <p>Runs curated SPL from this app with app-owned index scoping and only the required exported source knowledge objects. Dashboard-only filters are neutralized so the search runs independently.</p>
solution = <p>Use the result to identify affected data-center entities and correlate changes with related operational events.</p>
related_info = <ul><li><b>Provenance</b><br><code>cisco_dc_networking_app_for_splunk</code> / <code>severity_level_drilldown.xml</code>.</li></ul>
search = `index_dc` sourcetype=cisco:dc:nexus9k:syslog\
| lookup cisco_dc_nexus_hostname_lookup device AS host OUTPUT hostname AS hostname1\
| lookup cisco_dc_nexus_hostname_lookup device_without_port as host OUTPUT hostname as hostname2\
