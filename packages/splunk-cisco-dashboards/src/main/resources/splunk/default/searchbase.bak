| fields _time Hostname deviceIP Facility Mnemonics Message

[security_resilience_idsips_alert_trend]
search_name = Security Resilience - IDS/IPS Alert Trend
search_author = akhamis
updated_author = akhamis
version = 1.0.1
date_created = 2026-05-06 00:00:00
date_updated = 2026-05-06 00:00:00
category = Security
sub_category = IDS / IPS
tags = Firewall
dispatch_context = splunk-cisco-dashboards
dispatch_context_force = 1
default_viz = splunk.line
viz_options = {"seriesColors":["#EF4444"],"lineWidth":2,"nullValueDisplay":"gaps"}
drilldown_search_name = Security Resilience - IDS Classification
drilldown_button_title = View IDS/IPS detail
description = <p>Tracks the volume of <b>Secure Firewall intrusion events</b> from the <b>Cisco_Security</b> data model over time, powering the IDS/IPS alert trend sparkline.</p>
explanation = <p><code>tstats</code> targets the real <code>Secure_Firewall_Dataset.Intrusion_Events</code> leaf defined in <code>data/models/Cisco_Security.json</code>, bins by <code>_time</code>, and renders a fixed-range timechart. The <code>scd_summariesonly</code> macro controls whether acceleration-only or raw-backed data model access is used in the local deployment.</p>
solution = <p><b>Operational insight:</b> A trend spike means intrusion volume changed over time; compare with the aggregate IDS/IPS alert count and classification panels before deciding whether it is attack activity, sensor noise, or policy tuning fallout.</p>
related_info = <ul><li><b>Cisco_Security data model</b><br>The app-level <code>datamodels.conf</code> controls acceleration; dataset definitions live in <code>default/data/models/Cisco_Security.json</code>.</li><li><b>Intrusion_Events</b><br>Leaf dataset constrained by <code>EventType=IntrusionEvent</code>.</li><li><b>Dashboard parity</b><br>This stanza is the master copy for the Security Resilience IDS/IPS trend panel.</li></ul>
search = | tstats `scd_summariesonly` count FROM DATAMODEL=Cisco_Security WHERE nodename=Secure_Firewall_Dataset.Intrusion_Events by _time\
| timechart fixedrange=false sum(count) as "IDS/IPS Alerts"

[security_resilience_sdwan_hunt_application_downgrade_reversion]
search_name = Security Resilience - SD-WAN Threat Hunt - Application Downgrade and Reversion
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-08-05 00:00:00
date_updated = 2026-08-05 00:00:00
category = Security
sub_category = SD-WAN Threat Hunting
tags = SD-WAN,Threat Hunting,Software Downgrade,MITRE ATT&CK,T1601.002
dispatch_context = TA_cisco_catalyst
dispatch_context_force = 0
default_viz = splunk.table
viz_options = {"seriesColors":["#DC2626","#F59E0B","#2563EB"],"legendDisplay":"off"}
description = <p>Finds <b>Cisco SD-WAN controller software downgrade, reboot, and automatic reversion signals</b> associated with the privilege-escalation sequence documented in the Cisco SD-WAN Threat Hunt Guide.</p>
explanation = <p>The search reads controller syslog from both the stable <code>cisco:sdwan:syslog</code> sourcetype and its <code>cisco:sdwan:system:logs</code> fallback. It labels <code>cdb_set</code> software activation, master-install, reboot, confirmation-timer, and unconfirmed-upgrade messages so analysts can reconstruct the sequence without relying on appliance-local logs that an actor may clear.</p>
solution = <p><b>Suggested Actions</b><br><b>1.</b> Compare the target image with the approved change plan and maintenance window.<br><b>2.</b> Investigate unapproved downgrades or reversions as high priority.<br><b>3.</b> Pivot to the correlated compromise timeline and inspect the same controller for path traversal, root SSH, or local-user changes.</p>
related_info = <ul><li><b>False-positive context</b><br>Administrator rollback and failed-upgrade recovery can produce the same messages; authorised change records are the primary tuning source.</li><li><b>Required telemetry</b><br>Forward vSmart and manager controller system/application logs off the appliance before an incident.</li><li><b>Guide mapping</b><br>Implements PRIVESC-T1601.002-AppDowngrade-001 and PRIVESC-T1601.002-AppReversion-002.</li></ul>
search = `index_sdwan` sourcetype IN ("cisco:sdwan:syslog", "cisco:sdwan:system:logs") ("cdb_set: cdb Set software" OR "master install" OR "system-reboot-issued" OR "Starting upgrade confirmation timer" OR "Waiting for upgrade confirmation from user" OR "Software upgrade not confirmed")\
| rex field=_raw "host-name:[^A-Za-z0-9_.-]*(?<sdwan_host>[A-Za-z0-9_.-]+)"\
| eval Device=coalesce(sdwan_host, host), Signal=case(match(_raw,"(?i)cdb_set:\s*cdb Set software"),"Software image state changed", match(_raw,"(?i)master install"),"Master install initialised", match(_raw,"(?i)system-reboot-issued"),"System reboot issued", match(_raw,"(?i)Starting upgrade confirmation timer"),"Upgrade confirmation timer started", match(_raw,"(?i)Waiting for upgrade confirmation from user"),"Upgrade confirmation pending", match(_raw,"(?i)Software upgrade not confirmed"),"Unconfirmed upgrade reverted")\
| eval Severity=if(match(Signal,"(?i)changed|reverted|reboot"),"High","Supporting")\
| rename _time as "Time", source as "Source", sourcetype as "Sourcetype", _raw as "Raw Event"\
| table "Time", Device, Signal, Severity, "Source", "Sourcetype", "Raw Event"

[security_resilience_sdwan_hunt_peer_certificate_validation_failure]
search_name = Security Resilience - SD-WAN Threat Hunt - Peer Certificate Validation Failure
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-08-05 00:00:00
date_updated = 2026-08-05 00:00:00
category = Security
sub_category = SD-WAN Threat Hunting
tags = SD-WAN,Threat Hunting,Certificate,Rogue Peer,MITRE ATT&CK,T1190
dispatch_context = TA_cisco_catalyst
dispatch_context_force = 0
default_viz = splunk.table
viz_options = {"seriesColors":["#DC2626","#F59E0B","#2563EB"],"legendDisplay":"off"}
description = <p>Detects <b>SD-WAN control-connection certificate validation failures</b> associated with missing or unregistered peer serial numbers during rogue peering.</p>
explanation = <p>The search selects <code>control-connection-auth-fail</code>, <code>ERR_SER_NUM_NT_PRESENT</code>, and certificate messages that cannot find a serial number, then extracts controller and peer identity fields for inventory validation.</p>
solution = <p><b>Suggested Actions</b><br><b>1.</b> Confirm whether the peer was being legitimately onboarded.<br><b>2.</b> Validate peer and public IPs against controller inventory.<br><b>3.</b> Investigate temporally adjacent rogue-peer, downgrade, and persistence signals.</p>
related_info = <ul><li><b>False-positive context</b><br>New or misconfigured devices without serial registration can generate these failures.</li><li><b>Guide mapping</b><br>Implements INITIALACCESS-T1190-PeerCertFail-010; the guide's internal table labels this item 011.</li></ul>
search = `index_sdwan` sourcetype IN ("cisco:sdwan:syslog", "cisco:sdwan:system:logs") ("control-connection-auth-fail" OR "ERR_SER_NUM_NT_PRESENT" OR "Unable to find the serial no")\
| where match(_raw,"(?i)control-connection-auth-fail|ERR_SER_NUM_NT_PRESENT|Unable to find the serial no")\
| rex field=_raw "host-name:[^A-Za-z0-9_.-]*(?<sdwan_host>[A-Za-z0-9_.-]+)"\
| rex field=_raw "peer-type:\"?(?<peer_type>[^\"\s]+)"\
| rex field=_raw "peer-system-ip:\"?(?<peer_system_ip>[^\"\s]+)"\
| rex field=_raw "public-ip:\"?(?<public_ip>[^\"\s]+)"\
| rex field=_raw "reason:\"?(?<reason>[^\"\s]+)"\
| eval Device=coalesce(sdwan_host, host), Indicator=case(match(_raw,"(?i)ERR_SER_NUM_NT_PRESENT"),"Peer serial number not present", match(_raw,"(?i)Unable to find the serial no"),"Peer serial number missing from vSmart database", 1==1,"Control-connection authentication failure")\
| rename _time as "Time", peer_type as "Peer Type", peer_system_ip as "Peer System IP", public_ip as "Public IP", reason as "Reason", _raw as "Raw Event"\
| table "Time", Device, Indicator, "Peer Type", "Peer System IP", "Public IP", "Reason", "Raw Event"

[security_resilience_sdwan_hunt_cve_2022_20775_path_traversal]
search_name = Security Resilience - SD-WAN Threat Hunt - CVE-2022-20775 Path Traversal
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-08-05 00:00:00
date_updated = 2026-08-05 00:00:00
category = Security
sub_category = SD-WAN Threat Hunting
tags = SD-WAN,Threat Hunting,CVE-2022-20775,Path Traversal,MITRE ATT&CK,T1068
dispatch_context = TA_cisco_catalyst
dispatch_context_force = 0
default_viz = splunk.table
viz_options = {"seriesColors":["#DC2626","#F59E0B","#2563EB"],"legendDisplay":"off"}
description = <p>Detects <b>CVE-2022-20775 exploitation artefacts</b> in SD-WAN <code>system-login-change</code> events where a crafted username contains repeated directory traversal or the observed <code>/tmp/pwn</code> path.</p>
explanation = <p>The search requires both a login-change event and the exploit path pattern. This keeps the result focused on the stable, high-confidence behaviour described in the hunt guide instead of flagging unrelated path strings.</p>
solution = <p><b>Suggested Actions</b><br><b>1.</b> Treat every result as critical and isolate the affected controller according to the incident-response plan.<br><b>2.</b> Confirm the software version and look for a preceding downgrade.<br><b>3.</b> Hunt for root sessions, SSH keys, and local-user changes on the same device.</p>
related_info = <ul><li><b>Expected noise</b><br>No normal administrative workflow should place traversal strings in <code>user-name</code>; validate any TAC activity before closure.</li><li><b>Guide mapping</b><br>Implements PRIVESC-T1068-CVE202220775-011; the guide's internal table labels this item 012.</li></ul>
search = `index_sdwan` sourcetype IN ("cisco:sdwan:syslog", "cisco:sdwan:system:logs") "system-login-change" ("../" OR "/tmp/pwn")\
| where match(_raw,"(?i)(?:\.\./){2,}|/tmp/pwn")\
| rex field=_raw "host-name:[^A-Za-z0-9_.-]*(?<sdwan_host>[A-Za-z0-9_.-]+)"\
| rex field=_raw "user-name:[^A-Za-z0-9_./-]*(?<sdwan_user>[^\"\s]+)"\
| eval Device=coalesce(sdwan_host, host), Indicator=if(match(_raw,"(?i)/tmp/pwn"),"Observed /tmp/pwn exploit path","Repeated directory traversal in username"), Severity="Critical"\
| rename _time as "Time", sdwan_user as "User Name", _raw as "Raw Event"\
| table "Time", Device, Severity, Indicator, "User Name", "Raw Event"

[security_resilience_sdwan_hunt_root_ssh_public_key]
search_name = Security Resilience - SD-WAN Threat Hunt - Root SSH Public Key Accepted
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-08-05 00:00:00
date_updated = 2026-08-05 00:00:00
category = Security
sub_category = SD-WAN Threat Hunting
tags = SD-WAN,Threat Hunting,Root,SSH,Public Key,MITRE ATT&CK,T1098.004
dispatch_context = TA_cisco_catalyst
dispatch_context_force = 0
default_viz = splunk.table
viz_options = {"seriesColors":["#DC2626","#F59E0B","#2563EB"],"legendDisplay":"off"}
description = <p>Detects <b>successful SSH public-key authentication for the root account</b> on Cisco SD-WAN systems, a high-confidence persistence signal because root should not be used for interactive access.</p>
explanation = <p>The search matches the stable auth-log phrase <code>Accepted publickey for root</code> and extracts the originating address and port when present. Off-appliance collection is important because incident activity may include local log removal.</p>
solution = <p><b>Suggested Actions</b><br><b>1.</b> Treat every result as high priority and validate the source address.<br><b>2.</b> Review root and vManage administrator authorised-key files through approved forensic collection.<br><b>3.</b> Correlate with downgrade, path-traversal, and root-session detections.</p>
related_info = <ul><li><b>Required telemetry</b><br>Forward controller <code>auth.log</code> or an equivalent normalised authentication stream into one of the supported SD-WAN controller sourcetypes.</li><li><b>Guide mapping</b><br>Implements PERSISTENCE-T1098.004-RootSSHKeyAccepted-012; the guide's internal table labels this item 013.</li></ul>
search = `index_sdwan` sourcetype IN ("cisco:sdwan:syslog", "cisco:sdwan:system:logs") "Accepted publickey for root"\
| rex field=_raw "Accepted publickey for root from (?<source_ip>[^\s]+) port (?<source_port>\d+)"\
| eval Device=coalesce(host, source), Severity="High", Indicator="Root SSH public key accepted"\
| rename _time as "Time", source_ip as "Source IP", source_port as "Source Port", sourcetype as "Sourcetype", _raw as "Raw Event"\
| table "Time", Device, Severity, Indicator, "Source IP", "Source Port", "Sourcetype", "Raw Event"

[security_resilience_sdwan_hunt_root_or_rogue_sessions]
search_name = Security Resilience - SD-WAN Threat Hunt - Root or Rogue Interactive Sessions
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-08-05 00:00:00
date_updated = 2026-08-05 00:00:00
category = Security
sub_category = SD-WAN Threat Hunting
tags = SD-WAN,Threat Hunting,Root,Interactive Login,Local Account,MITRE ATT&CK,T1078,T1136.001
dispatch_context = TA_cisco_catalyst
dispatch_context_force = 0
default_viz = splunk.table
viz_options = {"seriesColors":["#DC2626","#F59E0B","#2563EB"],"legendDisplay":"off"}
description = <p>Detects <b>root interactive sessions</b> and sessions by local users created or modified during the selected hunt window on the same Cisco SD-WAN controller.</p>
explanation = <p>The search combines login/logout messages with user-creation and AAA messages, extracts the account names, and uses <code>eventstats</code> to carry the set of newly observed local users onto session events for the same device. Root remains high confidence; a session matching a newly configured user is medium confidence and requires account-inventory review.</p>
solution = <p><b>Suggested Actions</b><br><b>1.</b> Investigate root sessions immediately.<br><b>2.</b> Validate matching local users against the authorised account inventory and change records.<br><b>3.</b> Review source authentication records, authorised keys, and adjacent controller activity.</p>
related_info = <ul><li><b>Hunt-window semantics</b><br>A non-root user is elevated only when its name also appears in a user-add or AAA-change event for the same device in the selected time range.</li><li><b>Guide mapping</b><br>Implements PERSISTENCE-T1078-RootOrRogueLogins-013 and uses PERSISTENCE-T1136.001-UserAddAAA-014 for account context.</li></ul>
search = `index_sdwan` sourcetype IN ("cisco:sdwan:syslog", "cisco:sdwan:system:logs") ("system-login-change" OR "system-logout-change" OR "/usr/sbin/useradd" OR "cfgmgr_config_aaa_user")\
| rex field=_raw "host-name:[^A-Za-z0-9_.-]*(?<sdwan_host>[A-Za-z0-9_.-]+)"\
| rex field=_raw "user-name:[^A-Za-z0-9_.-]*(?<session_user>[A-Za-z0-9_.-]+)"\
| rex field=_raw "/usr/sbin/useradd\s+(?<new_local_user>[A-Za-z0-9_.-]+)"\
| rex field=_raw "cfgmgr_config_aaa_user.*?(?:for user:|username)\s+(?<aaa_user>[A-Za-z0-9_.-]+)"\
| eval Device=coalesce(sdwan_host, host), suspect_user=coalesce(new_local_user, aaa_user)\
| eventstats values(suspect_user) as created_users by Device\
| where isnotnull(session_user) AND (lower(session_user)=="root" OR mvfind(created_users,"(?i)^".session_user."$")>=0)\
| eval Session_Action=if(match(_raw,"(?i)system-logout-change"),"Logout","Login"), Confidence=if(lower(session_user)=="root","High","Medium")\
| rename _time as "Time", session_user as "User", created_users as "Users Changed in Hunt Window", _raw as "Raw Event"\
| table "Time", Device, "User", Session_Action, Confidence, "Users Changed in Hunt Window", "Raw Event"

[security_resilience_sdwan_hunt_suspicious_local_user_aaa]
search_name = Security Resilience - SD-WAN Threat Hunt - Suspicious Local User and AAA Changes
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-08-05 00:00:00
date_updated = 2026-08-05 00:00:00
category = Security
sub_category = SD-WAN Threat Hunting
tags = SD-WAN,Threat Hunting,Local Account,AAA,Persistence,MITRE ATT&CK,T1136.001
dispatch_context = TA_cisco_catalyst
dispatch_context_force = 0
default_viz = splunk.table
viz_options = {"seriesColors":["#DC2626","#F59E0B","#2563EB"],"legendDisplay":"off"}
description = <p>Finds <b>local-user creation and AAA configuration activity</b> on Cisco SD-WAN controllers using the <code>useradd</code> and <code>cfgmgr_config_aaa_user</code> artefacts documented in the hunt guide.</p>
explanation = <p>The search extracts the affected account when available, distinguishes operating-system user creation from controller AAA configuration, and highlights failures or attempts to add an account that already exists. These events are not inherently malicious, so authorised provisioning is the primary baseline.</p>
solution = <p><b>Suggested Actions</b><br><b>1.</b> Compare each account and timestamp with approved provisioning activity.<br><b>2.</b> Review unexpected or repeated modifications, especially around controller reboots or image changes.<br><b>3.</b> Pivot to interactive-session and correlated-timeline results for the same device.</p>
related_info = <ul><li><b>False-positive context</b><br>Legitimate local-account provisioning produces the same command families; tune with account inventory and change windows.</li><li><b>Guide mapping</b><br>Implements PERSISTENCE-T1136.001-UserAddAAA-014; the guide's internal table labels this item 015.</li></ul>
search = `index_sdwan` sourcetype IN ("cisco:sdwan:syslog", "cisco:sdwan:system:logs") ("/usr/sbin/useradd" OR "cfgmgr_config_aaa_user")\
| rex field=_raw "host-name:[^A-Za-z0-9_.-]*(?<sdwan_host>[A-Za-z0-9_.-]+)"\
| rex field=_raw "/usr/sbin/useradd\s+(?<new_local_user>[A-Za-z0-9_.-]+)"\
| rex field=_raw "cfgmgr_config_aaa_user.*?(?:for user:|username)\s+(?<aaa_user>[A-Za-z0-9_.-]+)"\
| eval Device=coalesce(sdwan_host, host), User=coalesce(new_local_user, aaa_user), Change_Type=if(match(_raw,"(?i)/usr/sbin/useradd"),"Local user creation","AAA user configuration"), Outcome=case(match(_raw,"(?i)already exists"),"Existing user", match(_raw,"(?i)\bfailed\b"),"Failed", 1==1,"Observed")\
| rename _time as "Time", _raw as "Raw Event"\
| table "Time", Device, User, Change_Type, Outcome, "Raw Event"

[security_resilience_sdwan_hunt_correlated_compromise_timeline]
search_name = Security Resilience - SD-WAN Threat Hunt - Correlated Compromise Timeline
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-08-05 00:00:00
date_updated = 2026-08-05 00:00:00
category = Security
sub_category = SD-WAN Threat Hunting
tags = SD-WAN,Threat Hunting,Correlation,Control Plane,Privilege Escalation,Persistence
dispatch_context = TA_cisco_catalyst
dispatch_context_force = 0
default_viz = splunk.table
viz_options = {"seriesColors":["#DC2626","#F59E0B","#2563EB"],"legendDisplay":"off"}
description = <p>Identifies <b>Cisco SD-WAN controllers with indicators from at least two attack stages in a 30-minute window</b>, linking rogue peering, software downgrade, privilege escalation, and persistence into a single triage view.</p>
explanation = <p>The search normalises high-confidence indicators from the companion hunts, assigns each event to Initial Access, Software Downgrade, Privilege Escalation, or Persistence, and aggregates by controller and 30-minute window. A result requires two or more distinct stages, reducing isolated administrative or onboarding noise.</p>
solution = <p><b>Suggested Actions</b><br><b>1.</b> Prioritise every result for incident-response review.<br><b>2.</b> Open the companion hunts over the same time range for raw-event context.<br><b>3.</b> Preserve remote logs and collect Admin-Tech or disk artefacts using the approved forensic process.<br><b>4.</b> Validate image history, peer inventory, authentication sources, and local accounts.</p>
related_info = <ul><li><b>Windowing</b><br>The fixed 30-minute bucket reflects the hunt guide's observed downgrade and peering sequences; widen the dashboard time range to cover the suspected incident while retaining this correlation grain.</li><li><b>Scope</b><br>This correlation intentionally excludes low-confidence timeout and CA-key signals unless a stronger attack-stage indicator is also present.</li><li><b>Source</b><br><a href="https://www.cyber.gov.au/sites/default/files/2026-02/ACSC-led%20Cisco%20SD-WAN%20Hunt%20Guide.pdf">ACSC-led Cisco SD-WAN Threat Hunt Guide</a>.</li></ul>
search = `index_sdwan` sourcetype IN ("cisco:sdwan:syslog", "cisco:sdwan:system:logs") ("cdb_set: cdb Set software" OR "master install" OR "system-reboot-issued" OR "Software upgrade not confirmed" OR "control-connection-state-change" OR "vbond_dump_pkt" OR "VDAEMON_DBG_PKT" OR "control-connection-auth-fail" OR "ERR_SER_NUM_NT_PRESENT" OR "Unable to find the serial no" OR "system-login-change" OR "system-logout-change" OR "Accepted publickey for root" OR "/usr/sbin/useradd" OR "cfgmgr_config_aaa_user")\
| rex field=_raw "host-name:[^A-Za-z0-9_.-]*(?<sdwan_host>[A-Za-z0-9_.-]+)"\
| rex field=_raw "peer-type:\"?(?<peer_type>[^\"\s]+)"\
| rex field=_raw "remote-color:(?<remote_color>\(null\)|\{28 0\}|[^\s]+)"\
| rex field=_raw "user-name:[^A-Za-z0-9_.-]*(?<session_user>[A-Za-z0-9_.-]+)"\
| eval Device=coalesce(sdwan_host, host), Stage=case(lower(peer_type)=="vhub" OR remote_color=="(null)" OR remote_color=="{28 0}" OR match(_raw,"(?i)vbond_dump_pkt|VDAEMON_DBG_PKT|control-connection-auth-fail|ERR_SER_NUM_NT_PRESENT|Unable to find the serial no"),"Initial Access", match(_raw,"(?i)cdb_set:\s*cdb Set software|master install|system-reboot-issued|Software upgrade not confirmed"),"Software Downgrade", match(_raw,"(?i)system-login-change") AND match(_raw,"(?i)(?:\.\./){2,}|/tmp/pwn"),"Privilege Escalation", match(_raw,"(?i)Accepted publickey for root|/usr/sbin/useradd|cfgmgr_config_aaa_user") OR (match(_raw,"(?i)system-(?:login|logout)-change") AND lower(session_user)=="root"),"Persistence")\
| eval Indicator=case(Stage=="Initial Access","Rogue peer or certificate anomaly", Stage=="Software Downgrade","Software image or reboot activity", Stage=="Privilege Escalation","CVE-2022-20775 path traversal", Stage=="Persistence","Root access or local-account persistence")\
| where isnotnull(Stage)\
| eval event_time=_time\
| bin _time span=30m\
| stats min(event_time) as first_seen, max(event_time) as last_seen, values(Stage) as stages, values(Indicator) as indicators, count as events by Device, _time\
| eval stage_count=mvcount(stages)\
| where stage_count>=2\
| eval first_seen=strftime(first_seen,"%Y-%m-%d %H:%M:%S"), last_seen=strftime(last_seen,"%Y-%m-%d %H:%M:%S")\
| rename _time as "Window", first_seen as "First Seen", last_seen as "Last Seen", stage_count as "Attack Stages", stages as "Stages", indicators as "Indicators", events as "Events"\
| table "Window", Device, "Attack Stages", "Stages", "Indicators", "Events", "First Seen", "Last Seen"

[security_resilience_firepower_intrusion_trend]
search_name = Security Resilience - Firepower Intrusion Trend
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-05-22 00:00:00
date_updated = 2026-06-10
category = Security
sub_category = IDS / IPS
tags = Firewall,Firepower,eStreamer,IDS,Trend
dispatch_context = splunk-cisco-dashboards
dispatch_context_force = 1
default_viz = splunk.area
viz_options = {"seriesColors":["#EF4444","#F59E0B","#3B82F6","#10B981"],"lineWidth":2}
drilldown_search_name = Security Resilience - Firepower IDS Event Correlation
drilldown_button_title = View Firepower event detail
description = <p>Tracks <b>Firepower intrusion event volume</b> over time as a <b>single IPS activity series</b> from the <b>Cisco_Security</b> data model, revealing attack campaign surges and sensor noise changes.</p>
explanation = <p>Uses tstats `scd_summariesonly` against the Secure_Firewall_Dataset.Intrusion_Events leaf, buckets by _time, and renders a timechart of total IPS event volume under the label All IPS Events.. This is a single series - directional traffic classification (outside-to-inside vs inside-to-outside) is not available from the accelerated data model and would require raw eStreamer events with zone-pair fields.</p>
solution = <p><b>Suggested Actions</b><br><b>1.</b> Correlate outside-to-inside spikes with firewall deny trends.<br><b>2.</b> Inside-to-outside spikes warrant endpoint investigation for compromised hosts.<br><b>3.</b> Flat high baselines may indicate noisy signatures needing tuning in FMC.</p>
related_info = <ul><li><b>Directional trending</b><br>Splitting by traffic direction isolates external attacks from internal anomalies in a single chart.</li></ul>
search = | tstats `scd_summariesonly` count FROM DATAMODEL=Cisco_Security where nodename=Secure_Firewall_Dataset.Intrusion_Events by _time\
| eval direction="All IPS Events"\
| timechart sum(count) as count by direction

[security_resilience_firepower_top_signatures]
search_name = Security Resilience - Firepower Top IDS Signatures
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-05-22 00:00:00
date_updated = 2026-06-10
category = Security
sub_category = IDS / IPS
tags = Firewall,Firepower,eStreamer,IDS,Signatures
dispatch_context = splunk-cisco-dashboards
dispatch_context_force = 1
default_viz = splunk.column
viz_options = {"seriesColors":["#D64550"],"stackMode":"unstacked"}
drilldown_search_name = Security Resilience - Firepower IDS Event Correlation
drilldown_button_title = View Firepower signature detail
description = <p>Ranks the <b>top IDS/IPS signatures</b> by hit count with <b>unique source and target counts</b> to distinguish noisy rules from genuine widespread threats.</p>
explanation = <p>A signature with high event count but low unique-source count is likely a single scanner; one with many unique sources is a broader campaign. The <code>blocked</code> field indicates whether Firepower dropped or only alerted on the traffic, helping teams prioritize signature tuning.</p>
solution = <p><b>Suggested Actions</b><br><b>1.</b> Signatures with high counts but action=alert-only should be reviewed for inline block promotion.<br><b>2.</b> Signatures triggered by many unique sources indicate widespread threats - correlate with threat intel.<br><b>3.</b> Consistently noisy false-positive signatures should be tuned in FMC to reduce SOC fatigue.</p>
related_info = <ul><li><b>Unique source/target ratios</b><br>Distinguishes targeted attacks from scanning noise.</li></ul>
search = | tstats `scd_summariesonly` count, dc(Secure_Firewall_Dataset.src_ip) as unique_sources, dc(Secure_Firewall_Dataset.dest_ip) as unique_targets FROM DATAMODEL=Cisco_Security where nodename=Secure_Firewall_Dataset.Intrusion_Events BY Secure_Firewall_Dataset.classification\
| rename Secure_Firewall_Dataset.classification as msg\
| rename msg as "Signature", count as "Hits", unique_sources as "Unique Sources", unique_targets as "Unique Targets"\
| eval "Last Action"="Not in DM"

[security_resilience_ips_severity_distribution]
search_name = Security Resilience - IPS Severity Distribution
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-04-13 11:04:12
date_updated = 2026-06-10
category = Security
sub_category = Intrusion Prevention
tags = Firewall,IPS,eStreamer,Severity
dispatch_context = splunk-cisco-dashboards
dispatch_context_force = 1
default_viz = splunk.table
viz_options = {"seriesColors":["#DC2626","#F59E0B","#2563EB","#16A34A"],"legendDisplay":"off"}
drilldown_search_name = Security Resilience - IDS Classification
drilldown_button_title = View IPS severity detail
description = <p>Breaks down <b>Firepower IPS events</b> by <b>impact</b> level from the accelerated <b>Cisco_Security</b> data model, so teams see whether defenses are dominated by <b>high-impact signatures</b>; vendor <b>priority</b> is not exposed by this data model and always displays as "Not in DM".</p>
explanation = <p>The search runs <code>tstats `scd_summariesonly`</code> against the accelerated <b>Cisco_Security</b> data model at the <code>Secure_Firewall_Dataset.Intrusion_Events</code> node, summing counts by the model's <code>impact</code> field only. Because this custom data model does not expose an FMC-style priority field, <code>priority</code> is set to the literal placeholder <code>"Not in DM"</code> on every row purely to keep a stable two-column group-by shape - it is not real priority data.</p>
solution = <p><b>Operational insight:</b> Skew toward unknown impact often means incomplete parser upgrades; skew toward critical impact with few blocks may indicate detection-only policies.</p>
related_info = <ul><li><b>Cisco_Security data model</b><br>The accelerated <code>Secure_Firewall_Dataset.Intrusion_Events</code> node only defines <code>impact</code>; there is no modeled <code>priority</code> field.</li><li><b>"Not in DM" placeholder</b><br>Use a raw eStreamer-based severity search when real FMC <code>Priority</code> values are required.</li><li><b>Pairs with</b><br>Security Resilience - IDS Classification, which documents the same data-model limitation.</li></ul>
search = | tstats `scd_summariesonly` count FROM DATAMODEL=Cisco_Security where nodename=Secure_Firewall_Dataset.Intrusion_Events BY Secure_Firewall_Dataset.Intrusion_Events.impact\
| rename Secure_Firewall_Dataset.Intrusion_Events.impact as impact\
| eval priority="Not in DM"\
| stats sum(count) as count by impact, priority

[user_experience_client_roaming_analysis]
search_name = User Experience - Client Roaming Analysis
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-04-18 16:00:00
date_updated = 2026-04-18 16:00:00
category = Network
sub_category = Wireless
tags = Catalyst Center,User Experience,Roaming
dispatch_context = TA_cisco_catalyst
dispatch_context_force = 0
default_viz = splunk.table
viz_options = {"seriesColors":["#0284C7","#0D9488","#F59E0B","#DC2626"],"legendDisplay":"off"}
drilldown_search_name = User Experience - Client Base Search
drilldown_button_title = View client base detail
description = <p>Per-<b>SSID</b> and <b>site</b> roaming math: <b>success rate</b>, <b>failed attempts</b>, and <b>average roam duration</b> to catch <b>mobility pain</b> before tickets spike.</p>
explanation = <p>Wireless clients with <code>onboarding.totalRoamingAttempts&gt;0</code> enter the pipeline. <code>stats</code> sums <code>successfulRoamingCount</code>, <code>failedRoamingCount</code>, and <code>totalRoamingAttempts</code>, and averages <code>maxRoamingDuration</code> grouped by <code>connection.ssid</code> and <code>siteHierarchy</code>. <code>success_pct</code> divides successes by attempts; results prioritize failures to spotlight worst SSID/site pairs.</p>
solution = <p><b>Operational insight:</b> Mobility problems cluster on specific SSID/site tuples-fixing those AP clusters often clears dozens of subjective "Wi-Fi drops" reports.</p>
related_info = <ul><li><b>sum of roam counters</b><br>Aggregates client-level mobility telemetry into SSID/site insights.</li><li><b>success_pct</b><br>Compresses raw counts into an intuitive KPI for leadership.</li><li><b>ranking -failed</b><br>Surfaces the noisiest mobility domains first.</li></ul>
search = `index_catalyst` sourcetype IN (cisco:dnac:client, cisco:catalyst:client) type="Wireless" onboarding.totalRoamingAttempts>0\
| stats latest(onboarding.successfulRoamingCount) as successfulRoamingCount, latest(onboarding.failedRoamingCount) as failedRoamingCount, latest(onboarding.totalRoamingAttempts) as totalRoamingAttempts, latest(onboarding.maxRoamingDuration) as maxRoamingDuration, latest(connection.ssid) as connection_ssid, latest(siteHierarchy) as siteHierarchy by macAddress\
| stats sum(successfulRoamingCount) as successful, sum(failedRoamingCount) as failed, sum(totalRoamingAttempts) as total, avg(maxRoamingDuration) as avg_roam_ms by connection_ssid, siteHierarchy\
| eval success_pct=round(successful/total*100,1), avg_roam_ms=round(avg_roam_ms,0)\
| rename connection_ssid as SSID, siteHierarchy as Site

[teuc_5_9_30_sase_secure_edge_performance]
search_name = TEUC-5.9.30 - SASE Secure Edge Performance
search_author = use-case-library
updated_author = akhamis
version = 1.0.0
date_created = 2026-04-21 11:24:21
date_updated = 2026-04-21 11:24:21
category = Monitoring
sub_category = SASE
tags = ThousandEyes,Umbrella,Zscaler
dispatch_context = ta_cisco_thousandeyes
dispatch_context_force = 0
default_viz = splunk.table
viz_options = {"seriesColors":["#2563EB","#16A34A","#F59E0B","#DC2626"],"legendDisplay":"off"}
description = ...comparing combinations of test and agent by average latency and packet loss.
explanation = After running <code>tstats</code> with the <code>scd_summariesonly</code> macro against the accelerated <code>Cisco_ThousandEyes.Test_Metrics</code> data model for <code>thousandeyes.test.type="agent-to-server"</code>, a wildcard filter keeps tests naming major secure-edge vendors, averaging latency and loss per test/agent. No ranking is applied.
solution = <p>Top rows are the <b>slowest or lossiest secure-edge paths</b> in the window. If latency clusters on one vendor string, escalate to that vendor&rsquo;s operations channel; if only certain agents appear, investigate local DNS, PAC files, or split tunneling.</p>
related_info = <ul><li><b>Vendor-specific naming</b><br>Wildcards tie the search to how you label ThousandEyes tests; align naming with your CASB or SSE architecture documents.</li><li><b>Agent-to-server suitability</b><br>This test type measures reachability to service-edge nodes akin to user traffic steering.</li><li><b>Descending ranking for triage</b><br>Putting worst latency first accelerates incident review when many rows return.</li></ul>
search = | tstats `scd_summariesonly` avg(Test_Metrics.metric_name:network.latency) as avg_latency_s, avg(Test_Metrics.metric_name:network.loss) as avg_loss FROM DATAMODEL=Cisco_ThousandEyes.Test_Metrics WHERE Test_Metrics.thousandeyes.test.type="agent-to-server" (Test_Metrics.thousandeyes.test.name="*SASE*" OR Test_Metrics.thousandeyes.test.name="*Zscaler*" OR Test_Metrics.thousandeyes.test.name="*Umbrella*") BY Test_Metrics.thousandeyes.test.name, Test_Metrics.thousandeyes.source.agent.name\
| rename "Test_Metrics.thousandeyes.test.name" as "thousandeyes.test.name" "Test_Metrics.thousandeyes.source.agent.name" as "thousandeyes.source.agent.name"\
| eval avg_latency_ms=round(avg_latency_s*1000,1)

[teuc_5_9_32_cdn_edge_network_performance]
search_name = TEUC-5.9.32 - CDN Edge Network Performance
search_author = use-case-library
updated_author = akhamis
version = 1.0.0
date_created = 2026-04-21 11:24:21
date_updated = 2026-04-21 11:24:21
category = Monitoring
sub_category = Cloud
tags = ThousandEyes,CDN,Throughput
dispatch_context = ta_cisco_thousandeyes
dispatch_context_force = 0
default_viz = splunk.table
viz_options = {"seriesColors":["#2563EB","#16A34A","#F59E0B","#DC2626"],"legendDisplay":"off"}
description = <p>This search evaluates HTTP-server tests aimed at <b>CDN properties</b>, averaging <b>client request duration (TTFB proxy)</b> and <b>server throughput</b> per test, agent, and <b>server address</b>, then expressing throughput in <b>Mbps</b>.</p>
explanation = Starting with <code>tstats</code> and the <code>scd_summariesonly</code> macro against the accelerated <code>Cisco_ThousandEyes.Test_Metrics</code> data model, filtered to <code>thousandeyes.test.type="http-server"</code>...
solution = <p>Rows highlight <b>which CDN edges look slow or thin</b> from each synthetic agent. High TTFB with okay throughput may imply TLS or origin fetch issues; low throughput with fine TTFB can mean throttling or last-mile bandwidth caps.</p>
related_info = <ul><li><b>TTFB vs total page time</b><br><code>http.client.request.duration</code> focuses on the first response leg; pair with page-load tests for full render stories.</li><li><b>Throughput math</b><br>Confirm whether <code>http.server.throughput</code> is bytes per second in your schema before relying on the megabit conversion.</li><li><b>Edge addressing</b><br>Keeping <code>server.address</code> in the split helps separate PoP-specific regressions from global CDN issues.</li></ul>
search = | tstats `scd_summariesonly` avg(Test_Metrics.metric_name:http.client.request.duration) as avg_ttfb_s, avg(Test_Metrics.metric_name:http.server.throughput) as avg_throughput FROM DATAMODEL=Cisco_ThousandEyes.Test_Metrics WHERE Test_Metrics.thousandeyes.test.type="http-server" Test_Metrics.thousandeyes.test.name="*CDN*" BY Test_Metrics.thousandeyes.test.name, Test_Metrics.thousandeyes.source.agent.name, Test_Metrics.server.address\
| rename "Test_Metrics.thousandeyes.test.name" as "thousandeyes.test.name" "Test_Metrics.thousandeyes.source.agent.name" as "thousandeyes.source.agent.name" "Test_Metrics.server.address" as "server.address"\
| eval avg_ttfb_ms=round(avg_ttfb_s*1000,1), throughput_mbps=round(avg_throughput/1048576,2)

[teuc_5_9_33_cloud_provider_path_visualization]
search_name = TEUC-5.9.33 - Cloud Provider Path Visualization
search_author = use-case-library
updated_author = akhamis
version = 1.0.0
date_created = 2026-04-21 11:24:21
date_updated = 2026-04-21 11:24:21
category = Monitoring
sub_category = Cloud
tags = ThousandEyes,Path Visualization
dispatch_context = ta_cisco_thousandeyes
dispatch_context_force = 0
default_viz = splunk.table
viz_options = {"seriesColors":["#2563EB","#16A34A","#F59E0B","#DC2626"],"legendDisplay":"off"}
description = <p>This search inventories <b>path visualization hops</b> for agent-to-server tests named like major <b>cloud providers</b>, counting path samples and listing distinct <b>hop_ip</b> values per test and agent.</p>
explanation = This query runs <code>tstats</code> with the <code>scd_summariesonly</code> macro against the accelerated <code>Cisco_ThousandEyes.Path_Viz</code> data model, filtered to server names matching AWS/Azure/GCP substrings, grouped by <code>Path_Viz.server</code> (renamed to thousandeyes.test.name) and <code>Path_Viz.serverIp</code> (renamed to thousandeyes.source.agent.name — this is actually the destination server IP, not an agent identifier). <code>values(Path_Viz.hops)</code> builds the multivalue hop list.
solution = <p>Rows summarize <b>how rich path telemetry is</b> for each cloud-leaning test and agent. Abnormal <code>count</code> drops can signal collection gaps; exploding hop lists may follow BGP flaps or load-balancer changes.</p>
related_info = <li><b>Cisco_ThousandEyes.Path_Viz data model</b><br>Path visualization is modeled separately from Test_Metrics; queried here via accelerated tstats, not the index_thousandeyes macro.</li>
search = | tstats `scd_summariesonly` count, values(Path_Viz.hops) as hops FROM DATAMODEL=Cisco_ThousandEyes.Path_Viz WHERE Path_Viz.server="*AWS*" OR Path_Viz.server="*Azure*" OR Path_Viz.server="*GCP*" BY Path_Viz.server, Path_Viz.serverIp\
| rename "Path_Viz.server" as "thousandeyes.test.name" "Path_Viz.serverIp" as "thousandeyes.source.agent.name"

[teuc_5_9_43_saas_application_response_time_comparison]
search_name = TEUC-5.9.43 - SaaS Application Response Time Comparison
search_author = use-case-library
updated_author = akhamis
version = 1.0.0
date_created = 2026-04-21 11:24:21
date_updated = 2026-04-21 11:24:21
category = Monitoring
sub_category = SaaS
tags = ThousandEyes,M365,Salesforce,ServiceNow
dispatch_context = ta_cisco_thousandeyes
dispatch_context_force = 0
default_viz = splunk.table
viz_options = {"seriesColors":["#2563EB","#16A34A","#F59E0B","#DC2626"],"legendDisplay":"off"}
description = ...across http-server and page-load tests, reporting averaged availability and TTFB per test name and agent location.
explanation = <code>tstats</code> with the <code>scd_summariesonly</code> macro against the accelerated <code>Cisco_ThousandEyes.Test_Metrics</code> data model accepts <code>thousandeyes.test.type="http-server" OR "page-load"</code>, restricted to vendor-name wildcards, averaging availability and TTFB by test name and agent location. No ranking is applied.
solution = <p>Rows benchmark <b>availability and TTFB for every monitored SaaS label and city</b>; clusters of low <code>avg_avail</code> signal regional brownouts worth escalating to providers.</p>
related_info = <ul><li><b>Vendor name wildcards</b><br>Requires consistent ThousandEyes test titles embedding M365, Salesforce, or ServiceNow tokens.</li><li><b>Location dimension</b><br>Uses human-readable agent locations for executive-ready tables.</li><li><b>Mixed test types</b><br>HTTP-server rows typically populate both KPIs; validate schema when mixing with page-load.</li></ul>
search = | tstats `scd_summariesonly` avg(Test_Metrics.metric_name:http.server.request.availability) as avg_avail, avg(Test_Metrics.metric_name:http.client.request.duration) as avg_ttfb_s FROM DATAMODEL=Cisco_ThousandEyes.Test_Metrics WHERE Test_Metrics.thousandeyes.test.type="http-server" OR Test_Metrics.thousandeyes.test.type="page-load" (Test_Metrics.thousandeyes.test.name="*M365*" OR Test_Metrics.thousandeyes.test.name="*Salesforce*" OR Test_Metrics.thousandeyes.test.name="*ServiceNow*") BY Test_Metrics.thousandeyes.test.name, Test_Metrics.thousandeyes.monitor.location\
| rename "Test_Metrics.thousandeyes.test.name" as "thousandeyes.test.name" "Test_Metrics.thousandeyes.monitor.location" as "thousandeyes.source.agent.location"\
| eval avg_ttfb_ms=round(avg_ttfb_s*1000,1)

[teuc_5_9_44_multi_region_saas_availability]
search_name = TEUC-5.9.44 - Multi-Region SaaS Availability
search_author = use-case-library
updated_author = akhamis
version = 1.0.0
date_created = 2026-04-21 11:24:21
date_updated = 2026-04-21 11:24:21
category = Monitoring
sub_category = SaaS
tags = ThousandEyes,Regional,Availability
dispatch_context = ta_cisco_thousandeyes
dispatch_context_force = 0
default_viz = splunk.table
viz_options = {"seriesColors":["#2563EB","#16A34A","#F59E0B","#DC2626"],"legendDisplay":"off"}
description = <p>Surfaces <b>HTTP server tests</b> whose <b>averaged availability</b> drops below perfect across <b>country and city</b> dimensions, exposing regional brownouts before a global status page updates.</p>
explanation = Events are queried via <code>tstats</code> with the <code>scd_summariesonly</code> macro against the accelerated <code>Cisco_ThousandEyes.Test_Metrics</code> data model, filtered to <code>thousandeyes.test.type="http-server"</code>.
solution = <p>Production SaaS endpoints monitored densely should hover near <b>100% averaged availability</b>; persistent rows here mean measurable probe failure from specific vantage points even if other regions stay green.</p>
related_info = <ul><li><b>Geo enrichment fields</b><br>Country ISO plus location string supports both automated geo dashboards and operator-readable incident notes.</li><li><b>Availability averaging</b><br>Averages over long windows dampen brief blips; shorten the window for detection of short incidents.</li><li><b>HTTP server test scope</b><br>This query intentionally excludes non-HTTP test types; pair with DNS or network tests for full-stack SaaS views.</li></ul>
search = | tstats `scd_summariesonly` avg(Test_Metrics.metric_name:http.server.request.availability) as avg_availability FROM DATAMODEL=Cisco_ThousandEyes.Test_Metrics WHERE Test_Metrics.thousandeyes.test.type="http-server" BY Test_Metrics.thousandeyes.test.name, Test_Metrics.thousandeyes.monitor.location\
| rename "Test_Metrics.thousandeyes.test.name" as "thousandeyes.test.name" "Test_Metrics.thousandeyes.monitor.location" as "thousandeyes.source.agent.location"\
| eval "thousandeyes.source.agent.geo.country.iso_code"="unknown"\
| where avg_availability < 100

[teuc_5_9_52_trace_span_analysis]
search_name = TEUC-5.9.52 - Trace Span Analysis
search_author = use-case-library
updated_author = akhamis
version = 1.0.0
date_created = 2026-04-21 11:24:21
date_updated = 2026-04-21 11:24:21
category = Monitoring
sub_category = Traces
tags = ThousandEyes,OTel,Spans
dispatch_context = ta_cisco_thousandeyes
dispatch_context_force = 0
default_viz = splunk.table
viz_options = {"seriesColors":["#2563EB","#16A34A","#F59E0B","#DC2626"],"legendDisplay":"off"}
description = Aggregates OTel trace spans, reporting span count and mean duration (ms) by service/server address, span name, and span kind.
explanation = <code>tstats</code> with the <code>scd_summariesonly</code> macro against the accelerated <code>Cisco_ThousandEyes.Test_Traces</code> data model computes count and <code>avg(Test_Traces.duration)</code> grouped by server address (aliased to service.name), span name, and span kind. No ranking is applied.
solution = <p>Top rows are the <b>loudest or slowest span kinds</b>; cross-check with APM or logging when mean duration jumps without corresponding network TEUC regressions.</p>
related_info = <ul><li><b>duration_ms</b><br>OTel span duration field; confirm semantics with your instrumentation library.</li><li><b>span.kind</b><br>Distinguishes client, server, producer, and consumer spans for triage.</li><li><b>cisco:thousandeyes:trace</b><br>Traces route through <code>index_thousandeyes</code> in typical Splunk TA deployments.</li></ul>
search = | tstats `scd_summariesonly` count, avg(Test_Traces.duration) as avg_span_duration_ms FROM DATAMODEL=Cisco_ThousandEyes.Test_Traces BY Test_Traces.server.address, Test_Traces.span_name, Test_Traces.span_kind\
| rename "Test_Traces.server.address" as "service.name" "Test_Traces.span_name" as "span.name" "Test_Traces.span_kind" as "span.kind"

[teuc_5_9_53_cross_platform_correlation_network_plus_apm]
search_name = TEUC-5.9.53 - Cross-Platform Correlation Network plus APM
search_author = use-case-library
updated_author = akhamis
version = 1.0.0
date_created = 2026-04-21 11:24:21
date_updated = 2026-04-21 11:24:21
category = Monitoring
sub_category = Correlation
tags = ThousandEyes,APM,Root Cause
dispatch_context = ta_cisco_thousandeyes
dispatch_context_force = 0
default_viz = splunk.table
viz_options = {"seriesColors":["#2563EB","#16A34A","#F59E0B","#DC2626"],"legendDisplay":"off"}
drilldown_search_name = TEUC-5.9.54 - MTTR Reduction via Network vs Application Isolation
drilldown_button_title = View MTTR reduction analysis
description = Joins ThousandEyes agent-to-server network KPIs with APM trace latency on the same server address and time bucket to label each interval as network, application, or both dominated.
explanation = The left side runs <code>tstats</code> with the <code>scd_summariesonly</code> macro against the accelerated <code>Cisco_ThousandEyes.Test_Metrics</code> data model filtered to agent-to-server tests, grouped by server address and _time.
solution = <p>Output rows represent <b>actionable disagreement</b> between path performance and application delay; persistent <code>root_cause="Network"</code> steers capacity toward WAN or DNS, while <code>Application</code> steers toward service owners even when ping looks fine.</p>
related_info = <ul><li><b>Join hygiene</b><br>Outer joins prevent dropping network evidence when APM temporarily stops reporting.</li><li><b>Time bin alignment</b><br>Matching 5m bins on both sides is essential; mismatched spans produce false <code>Normal</code> labels.</li><li><b>Heuristic limits</b><br>The <code>case</code> thresholds encode organizational policy and should be reviewed quarterly.</li></ul>
search = | tstats `scd_summariesonly` avg(Test_Metrics.metric_name:network.latency) as avg_net_latency_s, avg(Test_Metrics.metric_name:network.loss) as avg_net_loss FROM DATAMODEL=Cisco_ThousandEyes.Test_Metrics WHERE Test_Metrics.thousandeyes.test.type="agent-to-server" BY Test_Metrics.server.address, _time\
| rename "Test_Metrics.server.address" as "server.address"\
| join type=outer max=1 server.address [ search index=apm_traces | bin _time | stats avg(duration_ms) as avg_app_latency_ms p99(duration_ms) as p99_app_latency_ms by service.name, server.address, _time ]\
| eval avg_net_latency_ms=round(avg_net_latency_s*1000,1)\
| eval root_cause=case(avg_net_latency_ms>200 AND avg_app_latency_ms<500, "Network", avg_net_latency_ms<50 AND avg_app_latency_ms>2000, "Application", avg_net_latency_ms>200 AND avg_app_latency_ms>2000, "Both", 1=1, "Normal")\
| where root_cause!="Normal"\
| table _time, server.address, service.name, avg_net_latency_ms, avg_net_loss, avg_app_latency_ms, root_cause

[building_resilience_fit_occupancy_hourofweek_anomaly]
search_name = Building Resilience - Occupancy Anomaly by Hour-of-Week (fit)
search_author = akhamis
updated_author = akhamis
version = 1.1.0
date_created = 2026-06-10
date_updated = 2026-06-13
category = Building
sub_category = Occupancy
tags = Cisco Spaces,Anomaly,Machine Learning,Forecast
dispatch_context = ta_cisco_spaces
dispatch_context_force = 0
default_viz = splunk.table
viz_options = {"seriesColors":["#16A34A","#0EA5E9","#F59E0B","#DC2626"],"legendDisplay":"off"}
description = <p>Uses the Machine Learning Toolkit / AI Toolkit to learn the <b>normal range of room-occupancy % for each Weekday/Weekend time slot</b> (e.g. &ldquo;Weekday 14:00&rdquo;) and flags hours whose observed occupancy is a statistical <b>outlier</b> for that slot.</p>
explanation = <p>The base search builds the same hourly <code>occupancy_pct</code> series as the other occupancy stanzas, then classifies each bucket into one of <b>48 time slots</b> (Weekday/Weekend &times; 24 hours) using <code>day_type</code> and <code>hour</code>. An <code>eventstats count | where n_samples &gt;= 3</code> guard drops any slot with fewer than three training points before fitting, preventing the MLTK &ldquo;too few training points&rdquo; warning. <code>| fit DensityFunction occupancy_pct by slot into user:spaces_occupancy_density_model</code> fits a <b>separate probability distribution per slot</b> and appends the boolean output <code>IsOutlier(occupancy_pct)</code>.</p>
solution = <p>Returns the anomalous buckets: <code>_time</code>, <code>Hour of Week</code>, <code>Observed Occupancy %</code>, and the <code>Anomaly</code> flag.</p>
related_info = <ul><li><b>Requires the Machine Learning Toolkit</b><br><code>fit DensityFunction</code> ships with the Splunk AI/Machine Learning Toolkit.</li><li><b>Per-slot baseline</b><br>The <code>by hour_of_week</code> clause makes &ldquo;normal&rdquo; depend on the time-of-week, not a single global threshold.</li><li><b>Data sufficiency</b><br>48 Weekday/Weekend &times; hour slots each need 3+ samples; a 2-week window is sufficient. The pre-fit <code>eventstats | where n_samples &gt;= 3</code> guard silences MLTK &ldquo;too few training points&rdquo; warnings by dropping thin slots before fitting.</li></ul>
search = `index_spaces` sourcetype="cisco:spaces:firehose" eventType="SPACE_OCCUPANCY" "spaceOccupancy.space.type"=ROOM\
| bin _time span=1h\
| stats max(spaceOccupancy.peakPeopleCount) as peak, latest(spaceOccupancy.peoplePresence) as present by _time, spaceOccupancy.space.floorId, spaceOccupancy.space.name\
| eval occupied=if(present=="true" OR peak>0, 1, 0)\
| stats count as total_rooms, sum(occupied) as rooms_occupied by _time\
| eval occupancy_pct=if(total_rooms>0, round(rooms_occupied/total_rooms*100, 2), 0)\
| eval day_type=if(tonumber(strftime(_time,"%u"))>=6, "Weekend", "Weekday"), slot=day_type." ".strftime(_time,"%H").":00"\
| eventstats count as n_samples by slot\
| where n_samples >= 3\
| fit DensityFunction occupancy_pct by slot into user:spaces_occupancy_density_model\
| eval is_anomaly='IsOutlier(occupancy_pct)'\
| where is_anomaly=1\
| eval is_anomaly=round(is_anomaly)\
| eval occupancy_pct=round(occupancy_pct, 1)\
| fields _time slot occupancy_pct is_anomaly\
| rename slot as "Time Slot", occupancy_pct as "Observed Occupancy %", is_anomaly as "Anomaly"

[overview_operational_lead]
search_name = Overview - Operational Lead
search_author = akhamis
updated_author = akhamis
version = 1.0.1
date_created = 2026-05-09
date_updated = 2026-07-23 00:00:00
category = Network
sub_category = Site Connectivity
tags = KPI,IT Health,Catalyst Center,Site Leaderboard,Leaderboard,Legacy KPI
dispatch_context = cisco-catalyst-app
dispatch_context_force = 0
default_viz = splunk.singlevalue
viz_options = {"majorColor":"#059669"}
drilldown_search_name = Overview - Site State Drilldown
drilldown_button_title = View site state detail
description = <p>Identifies which site has the strongest overall IT health in the selected window by averaging Catalyst Center device health scores per site. Answers &ldquo;which site is running best right now?&rdquo; at a glance on the executive overview.</p>
explanation = <p>Pulls per-device latest reachability and manageability from <code>cisco:dnac:devicehealth</code>, scores each device 0/50/100, averages by <code>Site</code>, then keeps only the site(s) tied for the maximum average via <code>eventstats max</code> + <code>where score=max_score</code>. <code>stats first(Site) as value</code> collapses ties to a single readable string.</p>
solution = <p><b>Operational insight:</b> The "leader" is a relative measure &mdash; if every site is at 50, the leader is still degraded. Read this tile alongside the absolute IT-health metric to know whether the leader is "great" or "least-bad".</p>
related_info = <ul><li><b>Sourcetype contract</b><br><code>cisco:dnac:devicehealth</code> emits <code>Reachability</code>, <code>Manageability</code>, <code>DeviceID</code>, and <code>Site</code>.</li><li><b>Companion stanza</b><br><code>overview_top_incident_volume</code> &mdash; same shape, opposite question (noisiest site by XDR incident count).</li><li><b>Embedded duplicate</b><br>The same SPL is appended inside <code>overview_topology_overview</code> as a <code>summary</code> row consumed by the topology React component.</li></ul>
search = | tstats `scd_summariesonly` latest(Cisco_Catalyst_Dataset.Cisco_Catalyst_Device_Health_Events.device_health_reachability) as Reachability latest(Cisco_Catalyst_Dataset.Cisco_Catalyst_Device_Health_Events.device_health_manageability) as Manageability latest(Cisco_Catalyst_Dataset.Cisco_Catalyst_Device_Health_Events.device_health_site) as Site FROM datamodel=Cisco_Catalyst_App WHERE nodename=Cisco_Catalyst_Dataset.Cisco_Catalyst_Device_Health_Events BY Cisco_Catalyst_Dataset.Cisco_Catalyst_Device_Health_Events.device_health_ip_address\
| where Site!=""\
| eval h=case(Reachability=="Reachable" AND match(Manageability,"^Managed"),100, Reachability=="Reachable",50, 1==1,0)\
| stats avg(h) as score by Site\
| eventstats max(score) as max_score\
| where score=max_score\
| stats first(Site) as value

[security_resilience_sdwan_utd_amp_disposition_trend]
search_name = Security Resilience - SD-WAN UTD AMP Disposition Trend
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-05-28
date_updated = 2026-05-28
category = Security
sub_category = UTD / IPS
tags = SD-WAN,UTD,AMP,Malware,Trend
dispatch_context = TA_cisco_catalyst
dispatch_context_force = 0
default_viz = splunk.line
viz_options = {"seriesColors":["#DC2626","#F59E0B","#2563EB","#16A34A"],"lineWidth":2,"legendDisplay":"bottom","nullValueDisplay":"gaps","dataValuesDisplay":"minmax"}
drilldown_search_name = Security Resilience - SD-WAN UTD Top Malware Files
drilldown_button_title = View top malware files
description = <p>Time series of UTD AMP file disposition (clean / inspected / malicious) over the dashboard window. Mirrors the Advanced Malware Protection chart on the expanded Security view.</p>
explanation = <p>Filters <code>cisco:sdwan:utd:logs</code> to AMP-class events (<code>isnotnull(utd_amp_disposition)</code>), then buckets dispositions into the UI's three categories. AMP events carry <code>Filename</code>, <code>Filetype</code>, <code>SHA</code>, and <code>Malware</code> alongside the disposition.</p>
solution = <p><b>Suggested Actions</b><br><b>1.</b> Any uptick in Malicious dispositions should drive an immediate review via the Top Malware Files table.<br><b>2.</b> Long flat lines at zero indicate AMP signature feed issues or low file-bearing traffic - verify cloud lookup connectivity.</p>
related_info = <ul><li><b>utd_amp_disposition values</b><br>Typical values: <code>clean</code>, <code>malicious</code>, <code>unknown</code>; the SPL maps unknown to "inspected" to match the UI semantics.</li></ul>
search = `index_sdwan` sourcetype="cisco:sdwan:utd:logs"\
| where isnotnull(utd_amp_disposition)\
| eval disposition=case(lower(utd_amp_disposition)="clean","clean files", lower(utd_amp_disposition)="malicious","malicious files", 1==1,"inspected files")\
| timechart span=30m count by disposition

[network_intelligence_ftd_intrusion_top_signatures]
search_name = Network Intelligence - IPS Top Signatures and Classifications
search_author = akhamis
updated_author = akhamis
version = 1.1.0
date_created = 2026-06-02
date_updated = 2026-06-13
category = Security
sub_category = Network Intelligence
tags = Firewall,Intrusions,Signatures,Leaderboard
dispatch_context = splunk-cisco-dashboards
dispatch_context_force = 1
default_viz = splunk.table
viz_options = {"seriesColors":["#DC2626","#F59E0B","#2563EB","#16A34A"],"legendDisplay":"off"}
description = <p>Ranks IPS intrusion signatures by event volume, source spread, classification, and impact from the data model. Works with any eStreamer or CIM-mapped IPS source.</p>
explanation = <p>Queries the <code>Secure_Firewall_Dataset.Intrusion_Events</code> DM leaf via <code>tstats `scd_summariesonly`</code> with no sourcetype filter. Any CIM-mapped IPS sensor that populates this DM node contributes automatically.</p>
solution = <p>Start with signatures that combine high volume and broad source spread, especially for privilege-escalation or denial-of-service classifications. Validate whether detections are expected exposure or active exploitation attempts.</p>
related_info = <ul><li><b>Observed signal</b><br>Sample data shows concentrated signature activity with dominant categories such as attempted privilege gain and denial of service.</li></ul>
search = | tstats `scd_summariesonly` count as alert_events, dc(Secure_Firewall_Dataset.src_ip) as unique_sources, dc(Secure_Firewall_Dataset.dest_ip) as unique_destinations FROM DATAMODEL=Cisco_Security where nodename=Secure_Firewall_Dataset.Intrusion_Events BY Secure_Firewall_Dataset.classification, Secure_Firewall_Dataset.Intrusion_Events.impact\
| rename Secure_Firewall_Dataset.classification as classification_name, Secure_Firewall_Dataset.Intrusion_Events.impact as priority_id\
| eval signature_id=classification_name, rule_message=classification_name, protocol_name="unknown", app_name="unknown", inline_results="Not in DM"

[network_intelligence_ftd_intrusion_risky_flows]
search_name = Network Intelligence - IPS High-Risk Source to Destination Flows
search_author = akhamis
updated_author = akhamis
version = 1.1.0
date_created = 2026-06-02
date_updated = 2026-06-13
category = Security
sub_category = Network Intelligence
tags = Firewall,Intrusions,Flow,Risk
dispatch_context = splunk-cisco-dashboards
dispatch_context_force = 1
default_viz = splunk.table
viz_options = {"seriesColors":["#DC2626","#F59E0B","#2563EB","#16A34A"],"legendDisplay":"off"}
description = <p>Highlights source-destination intrusion flow pairs with repeated alerts, high-priority detections, and risk-level labels derived from priority and event volume. Works with any CIM-mapped IPS source.</p>
explanation = <p>Queries the <code>Secure_Firewall_Dataset.Intrusion_Events</code> DM leaf via <code>tstats `scd_summariesonly`</code> with no sourcetype filter, aggregating intrusion events per source/destination tuple. Captures minimum priority and derives a risk level from priority and event volume.</p>
solution = <p>Prioritize Critical and High flows for immediate containment and endpoint validation. These rows represent repeated or severe detections concentrated on specific communication paths.</p>
related_info = <ul><li><b>Priority logic</b><br>Lower numeric <code>PriorityID</code> indicates higher severity in this dataset and is used directly in risk scoring.</li></ul>
search = | tstats `scd_summariesonly` count as intrusion_events, min(Secure_Firewall_Dataset.Intrusion_Events.impact) as highest_priority FROM DATAMODEL=Cisco_Security where nodename=Secure_Firewall_Dataset.Intrusion_Events BY Secure_Firewall_Dataset.src_ip, Secure_Firewall_Dataset.dest_ip\
| rename Secure_Firewall_Dataset.src_ip as source, Secure_Firewall_Dataset.dest_ip as destination\
| where isnotnull(source) AND isnotnull(destination)\
| eval protocol_name="unknown", classification_name="see DM classification", inline_results="Not in DM", apps="unknown", risk_level=case(highest_priority<=1,"Critical", highest_priority<=2,"High", intrusion_events>=5,"Medium", 1==1,"Low")

[xdr_aa_job_task_failure_health]
search_name = XDR - Attack Analyzer - Job Tasks Failure Health
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-06-02
date_updated = 2026-06-02
category = Security
sub_category = XDR
tags = AttackAnalyzer,Jobs,Tasks,Health
dispatch_context = Splunk_App_SAA
dispatch_context_force = 0
default_viz = splunk.table
viz_options = {"seriesColors":["#DC2626","#F59E0B","#2563EB","#16A34A"],"legendDisplay":"off"}
description = <p>Tracks task execution failures and timeout conditions by engine with associated score and state-text context.</p>
explanation = <p>The search filters <code>splunk:aa:job:task</code> to failed or non-empty state-text outcomes and summarizes by engine and state to expose analysis pipeline health drift.</p>
solution = <p>Prioritize engines with recurring failures and elevated score context, then investigate parser/runtime issues to prevent blind spots in detonation coverage.</p>
related_info = <ul><li><b>Observed health split</b><br>Field summary confirms mostly <code>done</code> states with smaller <code>error</code> and <code>timedout</code> classes ideal for failure monitoring.</li></ul>
search = `index_security` sourcetype="splunk:aa:job:task"\
| eval job_id=coalesce(JobID,SAA_JOB_ID), task_id=coalesce(ID,""), engine=coalesce(Engine,"unknown"), state=lower(coalesce(State,"unknown")), state_text=coalesce(StateText,""), priority=tonumber(coalesce(Priority,10)), result_display_score=tonumber(coalesce('Results.DisplayScore',0)), result_score=tonumber(coalesce('Results.Score',0))\
| where state IN ("error","timedout") OR state_text!=""\
| stats count as task_failures dc(job_id) as jobs max(priority) as max_priority max(result_display_score) as max_display_score max(result_score) as max_score values(state_text) as state_texts by engine, state\
| eval state_texts=mvjoin(state_texts,", ")

[security_resilience_zeek_ssh_auth_pressure]
search_name = Security Resilience - Zeek SSH Authentication Pressure
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-06-02
date_updated = 2026-06-02
category = Security
sub_category = Network Intelligence
tags = Zeek,Logins,Session,Risk
dispatch_context = splunk-cisco-dashboards
dispatch_context_force = 1
default_viz = splunk.table
viz_options = {"seriesColors":["#DC2626","#F59E0B","#2563EB","#16A34A"],"legendDisplay":"off"}
description = <p>Surfaces SSH authentication pressure by destination, emphasizing failed or repeated-attempt sessions with client/server banner context.</p>
explanation = <p>The query reads <code>zeek:ssh</code>, normalizes source and destination aliases, converts authentication attempts to numeric form, and derives a normalized auth state from <code>auth_success</code>. It then aggregates by destination and auth state while retaining banner and crypto samples for triage context.</p>
solution = <p>Escalate destinations with high failed-session volume or high cumulative attempts, then validate whether activity reflects expected automation, brute-force probing, or misconfigured credentials.</p>
related_info = <ul><li><b>Observed behavior</b><br>Current telemetry contains large baseline successful automation plus concentrated failed-attempt clusters on SSH service ports.</li></ul>
search = `index_zeek` sourcetype="zeek:ssh"\
| eval source_ip=coalesce(src_ip,src,'id.orig_h',id_orig_h), destination_ip=coalesce(dest_ip,dest,'id.resp_h',id_resp_h), destination_port=coalesce(dest_port,'id.resp_p',id_resp_p), auth_attempts_num=tonumber(coalesce(auth_attempts,0)), auth_success_value=lower(tostring(coalesce(auth_success,"unknown"))), auth_state=case(auth_success_value=="true" OR auth_success_value=="t" OR auth_success_value=="1","Success", auth_success_value=="false" OR auth_success_value=="f" OR auth_success_value=="0","Failure", true(),"Unknown"), client_banner=coalesce(client,user_agent,"unknown"), server_banner=coalesce(server,"unknown"), kex_alg_norm=coalesce(kex_alg,"unknown"), cipher_alg_norm=coalesce(cipher_alg,"unknown"), session_id=coalesce(uid,session_id,flow_id,"unknown")\
| where auth_state!="Success" OR auth_attempts_num>1\
| stats count as ssh_events sum(auth_attempts_num) as total_auth_attempts dc(session_id) as unique_sessions dc(source_ip) as unique_sources values(client_banner) as client_banners values(server_banner) as server_banners values(kex_alg_norm) as kex_algs values(cipher_alg_norm) as cipher_algs by auth_state, destination_ip, destination_port\
| eval client_banners=mvjoin(client_banners,", "), server_banners=mvjoin(server_banners,", "), sample_kex=mvindex(kex_algs,0), sample_cipher=mvindex(cipher_algs,0)

[security_operations_lateral_movement_identity_network_pivots]
search_name = Security Operations - Lateral Movement - Identity and Network Pivot Risk
search_author = akhamis
updated_author = akhamis
version = 1.0.1
date_created = 2026-06-03
date_updated = 2026-07-23 00:00:00
category = Security
sub_category = Network Intelligence
tags = ISE,Zeek,Identity,LateralMovement,Network,Pivot,Events And Incident Viewer
dispatch_context = TA_cisco_catalyst
dispatch_context_force = 0
default_viz = splunk.table
viz_options = {"seriesColors":["#DC2626","#F59E0B","#2563EB","#16A34A"],"legendDisplay":"off"}
description = <p>Correlates identity-authentication outcomes with east-west network sessions to highlight source IPs showing potential lateral pivot behavior.</p>
explanation = <p>The search unions ISE authentication events (5200/5400) with Zeek connection telemetry targeting common lateral-movement service ports. It computes per-source identity failure pressure, lateral session volume, and destination spread, then scores risk tiers to surface the most actionable pivots.</p>
solution = <p>Prioritize high-risk rows where authentication failures and lateral-port fan-out both spike, then pivot to host and account triage for containment and credential-reset workflows.</p>
related_info = <ul><li><b>Pivot signal design</b><br>Combining identity and network indicators reduces false positives from either signal alone and highlights likely attacker progression paths.</li></ul>
search = (`index_identity` sourcetype="cisco:ise:syslog" ("5200" OR "5400"))\
| eval source_ip=coalesce(src_ip,src,ip,Framed_IP_Address,Calling_Station_ID), source_ip=if(match(source_ip,"^\\d{1,3}(\\.\\d{1,3}){3}$"),source_ip,null()), identity_user=lower(coalesce(UserName,user,IdentityUsername,"unknown")), auth_success=if(match(_raw,"5200"),1,0), auth_fail=if(match(_raw,"5400"),1,0), lateral_sessions=0, lateral_dest=null()\
| append [ search `index_zeek` sourcetype="zeek:conn"\
    | eval source_ip=coalesce(src,'id.orig_h',id_orig_h), destination_ip=coalesce(dest,'id.resp_h',id_resp_h), destination_port=tonumber(coalesce(dest_port,'id.resp_p',id_resp_p)), action_norm=lower(coalesce(action,"unknown"))\
    | where destination_port IN (22,88,135,139,389,445,636,3389,5985,5986) AND action_norm!="blocked"\
    | eval source_ip=if(match(source_ip,"^\\d{1,3}(\\.\\d{1,3}){3}$"),source_ip,null()), identity_user="unknown", auth_success=0, auth_fail=0, lateral_sessions=1, lateral_dest=destination_ip\
    | fields _time source_ip identity_user auth_success auth_fail lateral_sessions lateral_dest\
  ]\
| where isnotnull(source_ip) AND source_ip!=""\
| stats sum(auth_success) as auth_success sum(auth_fail) as auth_fail sum(lateral_sessions) as lateral_sessions dc(lateral_dest) as unique_lateral_destinations values(identity_user) as identity_users by source_ip\
| eval identity_users=mvjoin(mvfilter(identity_users!="unknown"),", "), identity_users=if(identity_users=="","unknown",identity_users), lateral_risk=case(auth_fail>=20 OR unique_lateral_destinations>=12,"High", auth_fail>=10 OR unique_lateral_destinations>=8,"Medium", auth_fail>=5 OR unique_lateral_destinations>=5,"Elevated", 1==1,"Watch")\
| where lateral_sessions>=15 AND unique_lateral_destinations>=5

[secure_networking_vendor_mac_on_nac_port]
search_name = Secure Networking - Virtual/Vendor MAC on Wired NAC Port
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-07-21 16:30:00
date_updated = 2026-07-23 00:00:00
category = Identity
sub_category = Secure Network Segmentation
tags = Secure Networking,Secure Network Segmentation,ISE TA,TrustSec,NAC,MAC OUI,Events And Incident Viewer
dispatch_context = TA_cisco_catalyst
dispatch_context_force = 0
default_viz = splunk.table
viz_options = {"seriesColors":["#0D9488","#2563EB","#F59E0B","#DC2626"],"legendDisplay":"off","overview":[{"workspace":"secure_networking","tileId":"secure_networking_vendor_mac_on_nac_port","section":"scalable_network_segmentation","label":"Virtual/Vendor MAC on Wired NAC Port","subLabel":"Scalable Network Segmentation","color":"#0D9488","thresholdNote":"Every row is a virtual/infrastructure MAC seen on a wired access port \u2014 each should be verified and, if legitimate infrastructure, added to a TrustSec EX-AUTH exemption rather than left to authenticate normally."}]}
description = <p>Flags <b>wired NAC authentications from virtual / infrastructure MAC addresses</b> &mdash; VMware, Check Point, Cisco HSRP, F5, Cisco ASA, A10, Citrix vendor OUIs &mdash; that are likely candidates for a TrustSec authentication exemption (EX-AUTH) and should be verified.</p>
explanation = <p>Virtual-interface MACs (hypervisor vNICs, HSRP/VRRP virtual MACs, load-balancer floats) authenticating on a wired NAC port often shouldn't be going through NAC at all &mdash; they can float between physical boxes and cause traffic to fail when a port with NAC enabled loses the active MAC. This classifies each wired-port MAC against well-known public vendor OUI prefixes; anything matching is surfaced for review.</p>
solution = <p>Every row is a virtual/infrastructure MAC seen on a wired access port &mdash; each should be verified and, if legitimate infrastructure, added to a TrustSec EX-AUTH exemption rather than left to authenticate normally.</p>
related_info = <ul><li><b>Vendor OUI prefixes</b><br>Public IEEE OUI assignments: VMware (00:50:56 / 00:0C:29 / 00:05:69 / 00:1C:14), Check Point (00:1C:7F), Cisco HSRP (00:00:0C:07:AC / 00:00:0C:9F), F5 (00:01:D7), Cisco ASA (00:A0:C9), A10 (00:1A:E2), Citrix (00:16:3E).</li><li><b>Known limitation</b><br>Fields and filter logic are confirmed correct against live data (verified 2026-07-22), but this environment's demo MAC generator does not currently seed any addresses matching these vendor OUI prefixes, so the search returns 0 rows here until that data is seeded — this is a data gap, not a query defect.</li></ul>
search = `index_identity` sourcetype="cisco:ise:syslog" NAS_Port_Type="Ethernet"\
| eval mac=upper(replace(coalesce(EndPointMACAddress, Calling_Station_ID), "-", ":"))\
| eval vendor_mac=case(match(mac,"^00:50:56") OR match(mac,"^00:0C:29") OR match(mac,"^00:05:69") OR match(mac,"^00:1C:14"),"VMware", match(mac,"^00:1C:7F"),"Check Point", match(mac,"^00:00:0C:07:AC"),"Cisco HSRP v1", match(mac,"^00:00:0C:9F"),"Cisco HSRP v2", match(mac,"^00:01:D7"),"F5", match(mac,"^00:A0:C9"),"Cisco ASA", match(mac,"^00:1A:E2"),"A10 Networks", match(mac,"^00:16:3E"),"Citrix", true(),"Unknown")\
| where vendor_mac!="Unknown"\
| stats count by NetworkDeviceName, NAS_IP_Address, NAS_Port_Id, mac, vendor_mac\
| rename NetworkDeviceName as "Network Device", NAS_IP_Address as "Address", NAS_Port_Id as "Port", mac as "MAC Address", vendor_mac as "Vendor MAC"

[secure_networking_agentic_servicenow_incident_summary]
search_name = Secure Networking - Agentic Ops ServiceNow Incident Summary
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-07-22 14:00:00
date_updated = 2026-07-22 14:00:00
category = Monitoring
sub_category = Agentic Ops
tags = Secure Networking,Agentic Ops,ServiceNow,ITSM,Ticket Management
dispatch_context = splunk-cisco-dashboards
dispatch_context_force = 1
default_viz = splunk.table
viz_options = {"seriesColors":["#0284C7","#16A34A","#F59E0B","#DC2626"],"legendDisplay":"off","overview":[{"workspace":"secure_networking","tileId":"secure_networking_agentic_servicenow_incident_summary","section":"agentic_ops","label":"Agentic Ops ServiceNow Incident Summary","subLabel":"Agentic Ops","color":"#0284C7","thresholdNote":"A rising Open count at Critical/High severity alongside Secure Networking feed anomalies (see secure_networking_source_health_by_pillar) is a signal worth correlating \u2014 ticket volume rising with degraded telemetry health often points at the same root cause."}]}
description = <p>Summarizes <b>ServiceNow incident tickets</b> by severity, showing open vs. closed counts and distinct assignment groups &mdash; a starting point for correlating operational tickets to Secure Networking events.</p>
explanation = <p>Reads the <code>snow:incident</code> feed directly (ServiceNow's own severity/active/assignment_group fields), rather than the CIM Ticket Management data model, since this environment's ServiceNow sample is not yet CIM-normalized.</p>
solution = <p>A rising Open count at Critical/High severity alongside Secure Networking feed anomalies (see secure_networking_source_health_by_pillar) is a signal worth correlating &mdash; ticket volume rising with degraded telemetry health often points at the same root cause.</p>
related_info = <ul><li><b>Known limitation</b><br>This is ticket volume only, not a confirmed join between specific tickets and specific Secure Networking devices/sites &mdash; that join needs a shared site or CI-name key that hasn't been validated yet.</li></ul>
search = sourcetype="snow:incident"\
| eval status=if(active="true","Open","Closed"), sev_rank=case(severity="1",1, severity="2",2, severity="3",3, severity="4",4, 1==1,5), Severity=case(severity="1","Critical", severity="2","High", severity="3","Moderate", severity="4","Low", 1==1,"Unspecified")\
| stats count as Tickets, count(eval(status="Open")) as Open, count(eval(status="Closed")) as Closed, dc(assignment_group) as "Assignment Groups", latest(sys_updated_on) as "Last Updated" by Severity, sev_rank\
| table Severity, Tickets, Open, Closed, "Assignment Groups", "Last Updated"

