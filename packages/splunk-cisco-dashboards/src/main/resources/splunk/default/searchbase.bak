[dc_networking_fabric_details_top_affected_leafs]
search_name = DC Networking - Fabric Details - Top Affected Leafs
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-07-30 00:00:00
date_updated = 2026-07-30 00:00:00
category = Data Center Networking
sub_category = ACI Fabric Health
tags = Cisco DC Networking,Cisco ACI
dispatch_context = cisco_dc_networking_app_for_splunk
dispatch_context_force = 0
default_viz = splunk.column
description = <p>Reports top affected leafs from the Cisco DC Networking <code>Fabric Details</code> dashboard.</p>
explanation = <p>Runs curated SPL from this app with app-owned index scoping and only the required exported source knowledge objects. Dashboard-only filters are neutralized so the search runs independently.</p>
solution = <p>Review severity, affected resources, and recurrence before assigning or escalating the condition.</p>
related_info = <ul><li><b>Provenance</b><br><code>cisco_dc_networking_app_for_splunk</code> / <code>fabric_dashboard.xml</code>.</li><li><b>Customize for sibling entities</b><br>Swap Role=leaf for Role=spine to rank the most-affected spine switches instead.</li></ul>
search = | `apic-fabric-overview`\
| search component=fabricNode AND id > 16 Role=leaf\
| stats latest(CurrentHealth) AS "Health" by id,node,apic_host\
| where 100 >= Health\
| eval "Health < 60" = case(Health < 60, Health)\
| eval "Health < 80" = case(Health >= 60 AND Health <80, Health)\
| eval "Health < 100" = case(Health >=80 AND Health <=100, Health)\
| eval Node= node.":".apic_host\
| table Node,"Health < 60","Health < 80","Health < 100"

[dc_networking_fabric_details_top_tcam_usage_by_node]
search_name = DC Networking - Fabric Details - Top TCAM Usage by Node
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-07-30 00:00:00
date_updated = 2026-07-30 00:00:00
category = Data Center Networking
sub_category = ACI Fabric Health
tags = Cisco DC Networking,Cisco ACI
dispatch_context = cisco_dc_networking_app_for_splunk
dispatch_context_force = 0
default_viz = splunk.bar
description = <p>Reports top tcam usage by node from the Cisco DC Networking <code>Fabric Details</code> dashboard.</p>
explanation = <p>Runs curated SPL from this app with app-owned index scoping and only the required exported source knowledge objects. Dashboard-only filters are neutralized so the search runs independently.</p>
solution = <p>Use the result to identify affected data-center entities and correlate changes with related operational events.</p>
related_info = <ul><li><b>Provenance</b><br><code>cisco_dc_networking_app_for_splunk</code> / <code>fabric_dashboard.xml</code>.</li></ul>
search = | `apic-fabric-overview`\
| search component="eqptcapacityPolEntry5min"\
| stats avg(normalizedLast) AS avg_normalizedLast by node, apic_host\
| eval avg_normalizedLast=round(avg_normalizedLast,2)\
| table node, avg_normalizedLast, apic_host\
| join [inputlookup cisco_dc_tcamThreshold.csv | stats values(warningThreshold) AS WarningThr, values(criticalThreshold) AS CriticalThr]\
| where 100 >= avg_normalizedLast\
| eval "Normal" = case(avg_normalizedLast < WarningThr, avg_normalizedLast)\
| eval "Warning" = case(avg_normalizedLast >= WarningThr AND avg_normalizedLast < CriticalThr, avg_normalizedLast)\
| eval "Critical" = case(avg_normalizedLast >=CriticalThr AND avg_normalizedLast <=100, avg_normalizedLast)\
| eval Node= node.":".apic_host\
| table Node, "Normal","Warning","Critical"\
| rename Node AS "Top TCAM Used Nodes"

[dc_networking_fabric_extenders_detail_fex_id_extended_chassis_module]
search_name = DC Networking - Fabric Extenders Detail - FEX id: - Extended Chassis Module
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-07-30 00:00:00
date_updated = 2026-07-30 00:00:00
category = Data Center Networking
sub_category = Nexus 9000 Platform
tags = Cisco DC Networking,Cisco ACI
dispatch_context = cisco_dc_networking_app_for_splunk
dispatch_context_force = 0
default_viz = splunk.table
description = <p>Reports fex id: - extended chassis module from the Cisco DC Networking <code>Fabric Extenders Detail</code> dashboard.</p>
explanation = <p>Runs curated SPL from this app with app-owned index scoping and only the required exported source knowledge objects. Dashboard-only filters are neutralized so the search runs independently.</p>
solution = <p>Use the result to identify affected data-center entities and correlate changes with related operational events.</p>
related_info = <ul><li><b>Provenance</b><br><code>cisco_dc_networking_app_for_splunk</code> / <code>fabric_extenders_detail.xml</code>.</li></ul>
search = `index_dc` sourcetype="cisco:dc:aci:health" component="eqptExtChCard"\
| rex field=dn "extch-(?<FEXID>[^\/]+)"\
| rex field=dn "node-(?<nodeID>[^\/]+)"\
| rex field=dn "extchslot-(?<ChassisSlotID>[^\/]+)"\
| rex field=dn "pod-(?<pod>[^\/]+)"\
| strcat " " id Name\
| eval module_row=json_object("Name",Name,"ser",ser,"model",model,"operSt",operSt,"rdSt",rdSt,"macB",macB)\
| stats latest(module_row) AS module_row by nodeID, FEXID, ChassisSlotID, pod, apic_host\
| join nodeID,apic_host,pod [search `index_dc` sourcetype="cisco:dc:aci:health" component=fabricNode role=leaf | rex field=dn "pod-(?<pod>[^\/]+)" | rex field=dn "node-(?<nodeID>[^\/]+)" | stats latest(name) AS name by pod, nodeID, apic_host]\
| eval Name=json_extract(module_row,"Name"), ser=json_extract(module_row,"ser"), model=json_extract(module_row,"model"), operSt=json_extract(module_row,"operSt"), rdSt=json_extract(module_row,"rdSt"), macB=json_extract(module_row,"macB")\
| rename ser AS "Serial Number" model AS "Model" operSt AS "Operational State" rdSt AS "Redundancy State" Name AS "Software Card Id"\
| table apic_host, pod, nodeID, FEXID, ChassisSlotID, "Software Card Id", "Serial Number", Model, "Operational State", "Redundancy State", macB

[dc_networking_fabric_extenders_detail_fex_id_power_supply]
search_name = DC Networking - Fabric Extenders Detail - FEX id: - Power Supply
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-07-30 00:00:00
date_updated = 2026-07-30 00:00:00
category = Data Center Networking
sub_category = Nexus 9000 Platform
tags = Cisco DC Networking,Cisco ACI,Operations
dispatch_context = cisco_dc_networking_app_for_splunk
dispatch_context_force = 0
default_viz = splunk.table
description = <p>Reports fex id: - power supply from the Cisco DC Networking <code>Fabric Extenders Detail</code> dashboard.</p>
explanation = <p>Runs curated SPL from this app with app-owned index scoping and only the required exported source knowledge objects. Dashboard-only filters are neutralized so the search runs independently.</p>
solution = <p>Use the result to identify affected data-center entities and correlate changes with related operational events.</p>
related_info = <ul><li><b>Provenance</b><br><code>cisco_dc_networking_app_for_splunk</code> / <code>fabric_extenders_detail.xml</code>.</li></ul>
search = | `apic-fabric-overview`\
| search component="eqptPsu" dn="*extch*"\
| rex field=dn "extch-(?<FEXID>[^\/]+)"\
| rex field=dn "pod-(?<pod>[^\/]+)"\
| stats dc(Fault Creation Time) AS "Faults" latest(CurrentHealth) AS "Health" latest(state) AS State latest(model) AS Model latest(ser) AS "Serial Number" latest(volt) AS Volt by id,nodeID,apic_host,pod,FEXID\
| strcat "Psu" id Name\
| join nodeID,apic_host,pod [search `index_dc` sourcetype="cisco:dc:aci:health" component=fabricNode role=leaf | rex field=dn "pod-(?<pod>[^\/]+)" | rex field=dn "node-(?<nodeID>[^\/]+)" | stats latest(name) AS node_name by pod, nodeID, apic_host]\
| rename pod AS Pod\
| table apic_host, Pod, nodeID, FEXID, Name, Health, Faults, State, Volt, Model, "Serial Number"

[dc_networking_fabric_extenders_detail_fabric_extenders_fex_health]
search_name = DC Networking - Fabric Extenders Detail - Fabric Extenders (FEX): Health
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-07-30 00:00:00
date_updated = 2026-07-30 00:00:00
category = Data Center Networking
sub_category = Nexus 9000 Platform
tags = Cisco DC Networking,Cisco ACI
dispatch_context = cisco_dc_networking_app_for_splunk
dispatch_context_force = 0
default_viz = splunk.line
description = <p>Reports fabric extenders (fex): health from the Cisco DC Networking <code>Fabric Extenders Detail</code> dashboard.</p>
explanation = <p>Runs curated SPL from this app with app-owned index scoping and only the required exported source knowledge objects. Dashboard-only filters are neutralized so the search runs independently.</p>
solution = <p>Investigate degraded or high-volume entities and correlate them with recent faults and configuration changes.</p>
related_info = <ul><li><b>Provenance</b><br><code>cisco_dc_networking_app_for_splunk</code> / <code>fabric_extenders_detail.xml</code>.</li></ul>
search = `index_dc` sourcetype="cisco:dc:aci:health" component=eqptExtCh dn="*extch*/health"\
| rex field=dn "node-(?<extnode>[^\/]+)"\
| rex field=dn "pod-(?<pod>[^\/]+)"\
| fields id, cur, extnode, pod, updTs\
| join type=outer extnode,pod [search `index_dc` sourcetype=cisco:dc:aci:health component=fabricNode role=leaf | rex field=dn "pod-(?<pod>[^\/]+)" | rex field=dn "node-(?<extnode>[^\/]+)" | stats latest(name) AS name by pod, extnode, apic_host]\
| eval _time=strptime(updTs,"%Y-%m-%dT%H:%M:%S.%3N")\
| chart latest(cur) AS Health by _time,id

[dc_networking_faults_transition_faults_duration]
search_name = DC Networking - Faults Transition - Faults Duration
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-07-30 00:00:00
date_updated = 2026-07-30 00:00:00
category = Data Center Networking
sub_category = ACI Fabric Health
tags = Cisco DC Networking,Cisco ACI,Operations
dispatch_context = cisco_dc_networking_app_for_splunk
dispatch_context_force = 0
default_viz = splunk.table
description = <p>Reports faults duration from the Cisco DC Networking <code>Faults Transition</code> dashboard.</p>
explanation = <p>Runs curated SPL from this app with app-owned index scoping and only the required exported source knowledge objects. Dashboard-only filters are neutralized so the search runs independently.</p>
solution = <p>Review severity, affected resources, and recurrence before assigning or escalating the condition.</p>
related_info = <ul><li><b>Provenance</b><br><code>cisco_dc_networking_app_for_splunk</code> / <code>fault_transition.xml</code>.</li></ul>
search = | `apic-fabric-overview`\
| eventstats max(_time) AS winning_time by dn,apic_host\
| where _time=winning_time\
| eval it = strptime(creationTime, "%Y-%m-%dT%H:%M:%S.%3N")\
| eval ot = strptime(lastTransition, "%Y-%m-%dT%H:%M:%S.%3N")\
| eval faultDuration = tostring((ot - it), "duration")\
| rex field=faultDuration "(?<durationHours>\d+):(?<durationMinutes>\d+):(?<durationSeconds>.*)"\
| eval duration=durationSeconds + 60 * (durationMinutes + 60 * (durationHours))\
| stats avg(duration) AS avgDuration min(faultDuration) AS MinDuration max(faultDuration) AS MaxDuration\
| fieldformat avgDuration = tostring(avgDuration, "duration")

[dc_networking_system_faults_syslog_fault_event_details]
search_name = DC Networking - System Faults - Syslog Fault Event Details
search_author = akhamis
updated_author = akhamis
