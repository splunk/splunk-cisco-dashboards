[dc_networking_fabric_details_health_fault_details_leafs]
search_name = DC Networking - Fabric Details - Health/Fault Details: Leafs
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-07-30 00:00:00
date_updated = 2026-07-30 00:00:00
category = Data Center Networking
sub_category = ACI Fabric Health
tags = Cisco DC Networking,Cisco ACI,Operations
dispatch_context = cisco_dc_networking_app_for_splunk
dispatch_context_force = 0
default_viz = splunk.table
description = <p>Reports health/fault details for leaf switches from the Cisco DC Networking <code>Fabric Details</code> dashboard.</p>
explanation = <p>Runs curated SPL from this app with app-owned index scoping and only the required exported source knowledge objects. Dashboard-only filters are neutralized so the search runs independently.</p>
solution = <p>Review severity, affected resources, and recurrence before assigning or escalating the condition.</p>
related_info = <ul><li><b>Provenance</b><br><code>cisco_dc_networking_app_for_splunk</code> / <code>fabric_dashboard.xml</code>.</li><li><b>Customize for sibling entities</b><br>Swap Role=leaf for Role=spine to view the equivalent health/fault detail for spine switches.</li></ul>
search = | `apic-fabric-overview`\
| search component="fabricNode" Role=leaf AND id > 16\
| stats values(health) AS "allHealth" latest(CurrentHealth) AS "Health" sparkline(avg(health),450s) AS "Health Trend" dc(Fault Creation Time) AS "Faults" latest(adSt) AS "Administrative State" latest(model) AS Model by id,node,apic_host\
| where 100 >= Health\
| eval "APIC Site/Cluster"=apic_host\
| table "APIC Site/Cluster",node,Health,"Health Trend",Faults,"Administrative State",Model\
| rename node AS nodeName

