| lookup cisco_dc_nexus_severity_lookup severity_id AS severity_id OUTPUT severity_name AS severity_name,severity_description AS severity_description\
| stats latest(syslog_msg) as syslog_msg values(Hostname) as Hostname values(severity_name) as severity_name values(severity_description) AS Description by _time,host,category,mnemonics\
