| stats latest(memory_usage_total) AS "Total Memory(KBytes)" latest(memory_usage_used) AS "Used Memory(KBytes)" latest(memory_usage_free) AS "Free Memory(KBytes)" sparkline(avg(memory_usage_used)) AS "Memory Usage Trend" latest(current_memory_status) AS "Current Memory Status" latest(cpu_state_user) AS "CPU User(Percentage)" latest(cpu_state_idle) AS "CPU Idle(Percentage)" sparkline(avg(cpu_state_idle)) AS "CPU Idle Trend" latest(cpu_state_kernel) AS "CPU Kernel(Percentage)" latest(load_avg_1min) as "Load average(1min)" latest(load_avg_5min) as "Load average(5min)" latest(load_avg_15min) as "Load average(15min)" by hostname,device\
| rename hostname AS Hostname device as Device

[dc_networking_schemas_bridge_domain_fault_details]
search_name = DC Networking - Schemas - Bridge Domain Fault Details
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-07-30 00:00:00
date_updated = 2026-07-30 00:00:00
category = Data Center Networking
sub_category = Multi-Site Orchestrator
tags = Cisco DC Networking,Operations
dispatch_context = cisco_dc_networking_app_for_splunk
dispatch_context_force = 0
default_viz = splunk.table
description = <p>Reports bridge domain fault details from the Cisco DC Networking <code>Schemas</code> dashboard.</p>
explanation = <p>Runs curated SPL from this app with app-owned index scoping and only the required exported source knowledge objects. Dashboard-only filters are neutralized so the search runs independently.</p>
solution = <p>Review severity, affected resources, and recurrence before assigning or escalating the condition.</p>
related_info = <ul><li><b>Provenance</b><br><code>cisco_dc_networking_app_for_splunk</code> / <code>schemas.xml</code>.</li><li><b>Customize for sibling entities</b><br>Swap the bds_faults_* field prefix for anps_faults_* (application profiles), contracts_faults_* (contracts), externalEpgs_faults_* (external EPGs), or vrfs_faults_* (VRFs) to view fault detail for that schema object type.</li></ul>
search = `index_dc` sourcetype="cisco:dc:nd:mso" mso_api_endpoint=schemaHealthFaults\
| eval faults=mvzip(mvzip(bds_faults_code, bds_faults_type),bds_faults_message)\
| mvexpand faults\
| rex field=faults "(?<Fault_Code>\w+),(?<Fault_Type>\w+),(?<Fault_Message>[^\{]+)"\
| stats count by Fault_Code, Fault_Type, Fault_Message\
| fields - count\
| table Fault_Code, Fault_Type, Fault_Message\
| rename Fault_Code as "Fault Code", Fault_Type as "Fault Type",Fault_Message as "Fault Message"

[dc_networking_schemas_bridge_domain_health_details]
search_name = DC Networking - Schemas - Bridge Domain Health Details
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-07-30 00:00:00
date_updated = 2026-07-30 00:00:00
category = Data Center Networking
sub_category = Multi-Site Orchestrator
tags = Cisco DC Networking,Operations
dispatch_context = cisco_dc_networking_app_for_splunk
dispatch_context_force = 0
default_viz = splunk.table
description = <p>Reports bridge domain health details from the Cisco DC Networking <code>Schemas</code> dashboard.</p>
explanation = <p>Runs curated SPL from this app with app-owned index scoping and only the required exported source knowledge objects. Dashboard-only filters are neutralized so the search runs independently.</p>
solution = <p>Investigate degraded or high-volume entities and correlate them with recent faults and configuration changes.</p>
related_info = <ul><li><b>Provenance</b><br><code>cisco_dc_networking_app_for_splunk</code> / <code>schemas.xml</code>.</li><li><b>Customize for sibling entities</b><br>Swap the bds_bdRef/bds_health_score field pair for anps_anpRef/anps_health_score (application profiles), externalEpgs_externalEpgRef/externalEpgs_health_score (external EPGs), or vrfs_vrfRef/vrfs_health_score (VRFs) to view health scores for that schema object type.</li></ul>
search = `index_dc` sourcetype="cisco:dc:nd:mso" mso_api_endpoint=schemaHealthFaults\
| eval health=mvzip(bds_bdRef, bds_health_score)\
| mvexpand health\
| rex field=health "(?<Bridge_Domain_Reference>[^\{]+),(?<Health_Score>\w+)"\
| stats latest(Health_Score) AS Health_Score by Bridge_Domain_Reference\
| table Bridge_Domain_Reference, Health_Score\
| rename Bridge_Domain_Reference as "Bridge Domain Reference", Health_Score as "Health Score"

