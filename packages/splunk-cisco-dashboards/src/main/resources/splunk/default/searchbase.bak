[dc_networking_atomic_counters_ep_to_ep_counters]
search_name = DC Networking - Atomic Counters - EP To EP counters
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-07-30 00:00:00
date_updated = 2026-07-30 00:00:00
category = Data Center Networking
sub_category = ACI Tenant & Policy
tags = Cisco DC Networking,Cisco ACI
dispatch_context = cisco_dc_networking_app_for_splunk
dispatch_context_force = 0
default_viz = splunk.table
description = <p>Reports ep to ep counters from the Cisco DC Networking <code>Atomic Counters</code> dashboard.</p>
explanation = <p>Runs curated SPL from this app with app-owned index scoping and only the required exported source knowledge objects. Dashboard-only filters are neutralized so the search runs independently.</p>
solution = <p>Use the result to identify affected data-center entities and correlate changes with related operational events.</p>
related_info = <ul><li><b>Provenance</b><br><code>cisco_dc_networking_app_for_splunk</code> / <code>tenant_counters.xml</code>.</li></ul>
search = | `atomic_counter_details`\
| where dn like "%[uni/tn-%/ap-%/%"\
| search component = dbgEpToEpRslt\
| table apic_host, _time,src,"Source VM",dst,"Destination VM","Total Transmitted Packets","Total Received Packets","Total Dropped Packets","Total Excess Packets"\
| rename src AS "SOURCE EP" dst AS "Destination EP" apic_host AS "APIC Site/Cluster"

[dc_networking_atomic_counters_epg_to_epg_counters]
search_name = DC Networking - Atomic Counters - EPG To EPG counters
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-07-30 00:00:00
date_updated = 2026-07-30 00:00:00
category = Data Center Networking
sub_category = ACI Tenant & Policy
tags = Cisco DC Networking,Cisco ACI
dispatch_context = cisco_dc_networking_app_for_splunk
dispatch_context_force = 0
default_viz = splunk.table
description = <p>Reports epg to epg counters from the Cisco DC Networking <code>Atomic Counters</code> dashboard.</p>
explanation = <p>Runs curated SPL from this app with app-owned index scoping and only the required exported source knowledge objects. Dashboard-only filters are neutralized so the search runs independently.</p>
solution = <p>Use the result to identify affected data-center entities and correlate changes with related operational events.</p>
related_info = <ul><li><b>Provenance</b><br><code>cisco_dc_networking_app_for_splunk</code> / <code>tenant_counters.xml</code>.</li></ul>
search = | `atomic_counter_details`\
| where dn like "%[uni/tn-%/ap-%/%"\
| search component = dbgEpgToEpgRslt\
| eventstats max(_time) AS winning_time by apic_host,src,dst\
| where _time=winning_time\
| eval tie_break=coalesce('Total Transmitted Packets',0)."|".coalesce('Total Received Packets',0)."|".coalesce('Total Dropped Packets',0)."|".coalesce('Total Excess Packets',0)\
| eventstats max(tie_break) AS winning_tie by apic_host,src,dst\
| where tie_break=winning_tie\
| stats latest(_time) AS _time values("Total Transmitted Packets") AS "Total Transmitted Packets" values("Total Received Packets") AS "Total Received Packets" values("Total Dropped Packets") AS "Total Dropped Packets" values("Total Excess Packets") AS "Total Excess Packets" by apic_host,src,dst\
| rename src AS "SOURCE EPG" dst AS "Destination EPG" apic_host AS "APIC Site/Cluster"

