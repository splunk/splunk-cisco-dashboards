[dc_networking_vmware_end_points_in_vlan_range]
search_name = DC Networking - VMware - End Points in VLAN Range
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-07-30 00:00:00
date_updated = 2026-07-30 00:00:00
category = Data Center Networking
sub_category = VMware Integration
tags = Cisco DC Networking,Cisco ACI,VMware
dispatch_context = cisco_dc_networking_app_for_splunk
dispatch_context_force = 0
default_viz = splunk.table
description = <p>Reports end points in vlan range from the Cisco DC Networking <code>VMware</code> dashboard.</p>
explanation = <p>Runs curated SPL from this app with app-owned index scoping and only the required exported source knowledge objects. Dashboard-only filters are neutralized so the search runs independently.</p>
solution = <p>Use the result to identify affected data-center entities and correlate changes with related operational events.</p>
related_info = <ul><li><b>Provenance</b><br><code>cisco_dc_networking_app_for_splunk</code> / <code>vmware.xml</code>.</li></ul>
search = `index_dc` sourcetype=cisco:dc:aci:class component=fvRsHyper\
| rex field=dn "conn-\[vlan-(?<VlanID>[^\]]+)"\
| rex field=dn "epdefref-(?<mac>[^\/]+)"\
| rex field=dn "ctrlr-\[(?<Controller>[^\]]+)"\
| stats latest(Controller) AS Controller by dn, mac, VlanID\
| join [search `index_dc` sourcetype="cisco:dc:aci:class" component=fvnsEncapBlk | rex field=dn "vlanns-\[(?<VLANPool>[^\]]+)" | rex field=dn "from-\[vlan-(?<FR>[^\]]+)" | rex field=dn "to-\[vlan-(?<TO>[^\]]+)" | table VLANPool,FR,TO | join VLANPool [search `index_dc` sourcetype=cisco:dc:aci:class component=fvnsRtVlanNs | rex field=dn "vlanns-\[(?<VLANPool>[^\]]+)" | rex field=dn "uni\/vmmp-(?<VMM>[^\/]+)" | rex field=dn "\/dom-(?<Controller>[^\]]+)" | table VLANPool,Controller, VMM | search VMM=VMware]]\
| join [search `index_dc` sourcetype="cisco:dc:aci:class" "vlan-*" component=fvCEp | rex field=dn "uni\/tn-(?<Tenant>[^\/]+)\/ap-(?<App>[^\/]+)\/epg-(?<EPG>[^\/]+)" | rex field=encap "vlan-(?<ID>[^$$]+)" | convert num(ID) | table Tenant,App,EPG,mac,ID]\
| convert num(FR) num(TO)\
| table Tenant, App, EPG, mac, VlanID\
| rename mac AS "MAC Address"

[dc_networking_vmware_top_received_errored_packets_reporting_esx_hosts]
search_name = DC Networking - VMware - Top Received Errored Packets Reporting ESX Hosts
search_author = akhamis
updated_author = akhamis
version = 1.0.1
date_created = 2026-07-30 00:00:00
date_updated = 2026-08-02
category = Data Center Networking
sub_category = VMware Integration
tags = Cisco DC Networking,Cisco ACI,VMware
dispatch_context = cisco_dc_networking_app_for_splunk
dispatch_context_force = 0
default_viz = splunk.line
description = <p>Reports top received errored packets reporting esx hosts from the Cisco DC Networking <code>VMware</code> dashboard.</p>
explanation = <p>Uses <code>timechart limit=5 useother=f</code> to retain the five ESX host series with the highest received errored-packet contribution over the selected time range.</p>
solution = <p>Investigate degraded or high-volume entities and correlate them with recent faults and configuration changes.</p>
related_info = <ul><li><b>Provenance</b><br><code>cisco_dc_networking_app_for_splunk</code> / <code>vmware.xml</code>.</li></ul>
search = | `vmware_counter_details`\
| search component=compRcvdErrPkts1h\
| rename "Receiving Host" AS Host\
| timechart limit=5 useother=f avg("Errored_Packets") AS "Received Errored Packets" by Host\
| fields - NULL

[dc_networking_vmware_top_received_errored_packets_reporting_vms]
search_name = DC Networking - VMware - Top Received Errored Packets Reporting VMs
search_author = akhamis
updated_author = akhamis
version = 1.0.1
date_created = 2026-07-30 00:00:00
date_updated = 2026-08-02
category = Data Center Networking
sub_category = VMware Integration
tags = Cisco DC Networking,Cisco ACI,VMware
dispatch_context = cisco_dc_networking_app_for_splunk
dispatch_context_force = 0
default_viz = splunk.line
description = <p>Reports top received errored packets reporting vms from the Cisco DC Networking <code>VMware</code> dashboard.</p>
explanation = <p>Uses <code>timechart limit=5 useother=f</code> to retain the five virtual-machine series with the highest received errored-packet contribution over the selected time range.</p>
solution = <p>Investigate degraded or high-volume entities and correlate them with recent faults and configuration changes.</p>
related_info = <ul><li><b>Provenance</b><br><code>cisco_dc_networking_app_for_splunk</code> / <code>vmware.xml</code>.</li></ul>
search = | `vmware_counter_details`\
| search component=compRcvdErrPkts1h\
| rename "Receiving Virtual Machine" AS VirtualMachine\
| timechart limit=5 useother=f avg("Errored_Packets") AS "Received Errored Packets" by VirtualMachine\
| fields - NULL

