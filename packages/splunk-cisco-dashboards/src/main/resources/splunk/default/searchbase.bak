[dc_networking_power]
search_name = DC Networking - Power
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-07-30 00:00:00
date_updated = 2026-07-30 00:00:00
category = Data Center Networking
sub_category = Nexus 9000 Platform
tags = Cisco DC Networking,Cisco Nexus 9000
dispatch_context = cisco_dc_networking_app_for_splunk
dispatch_context_force = 0
default_viz = splunk.table
description = <p>Reports power from the Cisco DC Networking <code>Power</code> dashboard.</p>
explanation = <p>Runs curated SPL from this app with app-owned index scoping and only the required exported source knowledge objects. Dashboard-only filters are neutralized so the search runs independently.</p>
solution = <p>Use the result to identify affected data-center entities and correlate changes with related operational events.</p>
related_info = <ul><li><b>Provenance</b><br><code>cisco_dc_networking_app_for_splunk</code> / <code>nexus9k_power_details.xml</code>.</li></ul>
search = `index_dc` sourcetype=cisco:dc:nexus9k component=nxpower\
| lookup cisco_dc_nexus_hostname_lookup device AS device OUTPUT hostname AS hostname1\
| lookup cisco_dc_nexus_hostname_lookup device_without_port as device OUTPUT hostname as hostname2\
| eval hostname = coalesce(hostname1, hostname2)\
| lookup cisco_dc_nexus_temperature_lookup device AS device,model AS mod_model OUTPUT modtype AS modtype_lookup1\
| lookup cisco_dc_nexus_temperature_lookup device_without_port AS device,model AS mod_model OUTPUT modtype AS modtype_lookup2\
| eval modtype_lookup = coalesce(modtype_lookup1, modtype_lookup2)\
| stats latest(hostname) as Hostname values(modtype_lookup) as modtype_lookup values(mod_model) as mod_model values(actual_draw) as actual_draw values(allocated) as allocated values(modstatus) as modstatus by _time,device,modnum\
| rename device as Device modnum as "Module Number"\
| replace "* W" with "*" in actual_draw\
| replace "* W" with "*" in allocated\
| stats latest(Hostname) AS Hostname latest(mod_model) as Model,latest(modtype_lookup) as "Module-Type", latest(allocated) as "Power Allocated(Watts)", latest(actual_draw) as "Power Drawn(Watts)" ,sparkline(avg(actual_draw)) as "Power Drawn History", latest(modstatus) as Status by Device,"Module Number"\
| table Device,Hostname,"Module Number","Model","Module-Type","Power Allocated(Watts)","Power Drawn(Watts)","Power Drawn History","Status"

[dc_networking_resource_summary]
search_name = DC Networking - Resource Summary
search_author = akhamis
