[dc_networking_vmware_vlan_statistics]
search_name = DC Networking - VMware - VLAN Statistics
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-07-30 00:00:00
date_updated = 2026-07-30 00:00:00
category = Data Center Networking
sub_category = VMware Integration
tags = Cisco DC Networking,Cisco ACI,VMware
dispatch_context = cisco_dc_networking_app_for_splunk
dispatch_context_force = 0
default_viz = splunk.table
description = <p>Reports vlan statistics from the Cisco DC Networking <code>VMware</code> dashboard.</p>
explanation = <p>Runs curated SPL from this app with app-owned index scoping and only the required exported source knowledge objects. Dashboard-only filters are neutralized so the search runs independently.</p>
solution = <p>Use the result to identify affected data-center entities and correlate changes with related operational events.</p>
related_info = <ul><li><b>Provenance</b><br><code>cisco_dc_networking_app_for_splunk</code> / <code>vmware.xml</code>.</li></ul>
search = `index_dc` sourcetype=cisco:dc:aci:class component=fvRsHyper\
| rex field=dn "conn-\[vlan-(?<VlanID>[^\]]+)"\
| rex field=dn "epdefref-(?<mac>[^\/]+)"\
| rex field=dn "ctrlr-\[(?<Controller>[^\]]+)"\
| stats latest(Controller) AS Controller by dn, mac, VlanID\
| join [search `index_dc` sourcetype="cisco:dc:aci:class" component=fvnsEncapBlk | rex field=dn "vlanns-\[(?<VLANPool>[^\]]+)" | rex field=dn "from-\[vlan-(?<FR>[^\]]+)" | rex field=dn "to-\[vlan-(?<TO>[^\]]+)" | table VLANPool,FR,TO | join VLANPool [search `index_dc` sourcetype=cisco:dc:aci:class component=fvnsRtVlanNs | rex field=dn "vlanns-\[(?<VLANPool>[^\]]+)" | rex field=dn "uni\/vmmp-(?<VMM>[^\/]+)" | rex field=dn "\/dom-(?<Controller>[^\]]+)" | table VLANPool,Controller, VMM | search VMM=VMware]]\
| stats dc(VlanID) AS Used by FR,TO,VLANPool,Controller\
| convert num(FR) num(TO)\
| eval TotalVLANs = (TO-FR)+1\
| eval AvailableVLANs = TotalVLANs-Used\
| eval "VLAN Range" = "[".FR." - ".TO."]"\
| table "VLAN Range", VLANPool, Controller, TotalVLANs, AvailableVLANs, Used,FR,TO\
| rename VLANPool AS "Pool", TotalVLANs AS "Total", AvailableVLANs AS "Available"

[dc_networking_vmware_datastore_usage]
search_name = Data Center Networking - Datastore Usage
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-08-04 00:00:00
date_updated = 2026-08-04 00:00:00
category = Data Center Networking
sub_category = VMware Integration
tags = Cisco DC Networking,VMware,vSphere,Storage
dispatch_context = cisco_dc_networking_app_for_splunk
dispatch_context_force = 0
default_viz = splunk.table
description = <p>Reports the current percent-used and a tiered status (OK/WARN/HIGH/CRITICAL/UNKNOWN) for every VMware datastore.</p>
explanation = <p>Reads VMware inventory telemetry (via <code>index_dc</code>), takes the latest capacity/used snapshot per datastore, and derives <code>pct_used</code> with a <code>case()</code> tier: <b>&gt;=95% CRITICAL</b>, <b>&gt;=90% HIGH</b>, <b>&gt;=80% WARN</b>, else <b>OK</b> (or <b>UNKNOWN</b> if capacity is null/zero). This is raw ESXi/vCenter datastore capacity telemetry -- a genuinely new data source for this catalog, whose existing VMware coverage is limited to the ACI-side integration (VLANs, alarms, errored packets), not direct storage capacity.</p>
solution = <p>Any datastore at <b>HIGH</b> or <b>CRITICAL</b> needs capacity remediation (storage vMotion, cleanup, or expansion) before it risks VM provisioning failures or performance degradation from thin-provisioning contention.</p>
related_info = <ul><li><b>Provenance</b><br>Acme Labs demo dashboard, panel &quot;Datastore Usage&quot;.</li><li><b>Ordering not preserved</b><br>The source panel's leading and trailing <code>result ranking</code> stages were removed because house style forbids <code>result ranking</code> in a pipeline that also contains <code>stats</code>; <code>first()</code> was also swapped for <code>latest()</code> so the &quot;most recent snapshot per datastore&quot; semantics survive without needing an explicit presort.</li></ul>
search = `index_dc`\
| rename datastores{}.name as datastore\
| search datastore=*\
| stats latest(storage_capacity) as storage_capacity_b latest(storage_used) as storage_used_b by datastore\
| eval pct_used = round(100*storage_used_b/storage_capacity_b,2)\
| eval status = case(isnull(storage_capacity_b) OR storage_capacity_b=0, "UNKNOWN", pct_used>=95, "CRITICAL", pct_used>=90, "HIGH", pct_used>=80, "WARN", true(), "OK")\
| table datastore pct_used status

[network_intelligence_firewall_nat_translation_hits]
search_name = Network - NAT Translation Hits for the Service
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-08-04 00:00:00
date_updated = 2026-08-04 00:00:00
category = Network
sub_category = Network Intelligence
tags = Cisco Firewall,NAT,Network Address Translation,Operations
dispatch_context = splunk-cisco-dashboards
dispatch_context_force = 1
default_viz = splunk.table
description = <p>Reports NAT translation hit counts by initiator IP, responder IP, and responder port, with the firewall rule(s) responsible for each translation.</p>
explanation = <p>Reads Cisco Secure Firewall eStreamer events (<code>cisco:sfw:estreamer</code>) and counts events by <code>NAT_InitiatorIP</code>/<code>NAT_ResponderIP</code>/<code>NAT_ResponderPort</code>, rolling up the distinct <code>FirewallRule</code>(s) that produced each translation. These NAT-specific fields are new to this catalog -- confirmed by grep that no existing stanza references <code>NAT_Initiator</code> or <code>NAT_Responder</code> fields today, so this is a genuinely new NAT-visibility data point rather than a variant of an existing allow/deny panel.</p>
solution = <p>An initiator/responder/port combination with an unexpectedly high hit count is worth checking against the owning <code>FirewallRule</code> for correctness -- either legitimate high-volume NAT'd traffic or a misconfigured rule translating more than intended.</p>
related_info = <ul><li><b>Provenance</b><br>Acme Labs demo dashboard, panel &quot;NAT translation hits for the service&quot;.</li><li><b>Ranking not preserved</b><br>The source panel's trailing <code>result ranking</code> was removed because house style forbids <code>result ranking</code> in a pipeline that also contains <code>stats</code>.</li></ul>
search = `index_firewall` sourcetype=cisco:sfw:estreamer\
| stats count as hits values(FirewallRule) as rules by NAT_InitiatorIP NAT_ResponderIP NAT_ResponderPort

[catalyst_center_poe_power_consumption]
search_name = Catalyst Center - PoE Power Consumption
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-08-04 00:00:00
date_updated = 2026-08-04 00:00:00
category = Catalyst Center
sub_category = Device & Network Health
tags = Cisco Catalyst Center,DNAC,PoE,Power Budget,Device Health
dispatch_context = cisco-catalyst-app
dispatch_context_force = 0
default_viz = splunk.table
description = <p>Per-device PoE power draw versus maximum power supply, with percentage utilization and remaining watts available.</p>
explanation = <p>Reads powerDrawn and maxPowerSupply from the DNAC device health feed (sourcetype=cisco:dnac:devicehealth) for devices actively drawing PoE power, and computes utilization percentage and headroom in watts per device. Zero PoE content exists anywhere in the catalog today, so this is the first power-budget visibility for PoE switches, which matters for capacity planning before adding more IP phones, APs, or cameras to a switch's power budget.</p>
solution = <p>Devices ranked near the top with poe_pct approaching 100% and low remaining_watts are at risk of PoE budget exhaustion; before deploying additional PoE endpoints to that switch, verify available headroom or plan a power supply upgrade.</p>
related_info = <ul><li>Dropped the $cc_host$ dashboard filter token so results cover all DNAC-managed devices; removed the trailing ranking since the pipeline aggregates with stats.</li></ul>
search = `cisco_catalyst_app_index` sourcetype=cisco:dnac:devicehealth powerDrawn>0\
| stats latest(powerDrawn) as power_watts, latest(maxPowerSupply) as max_watts, latest(DeviceName) as device by DeviceID\
| eval poe_pct=round((power_watts/max_watts)*100,1), remaining_watts=max_watts-power_watts\
| head 30

[secure_networking_meraki_top_switch_ports_by_incidents]
search_name = Security - Meraki Top Switch Ports by Incident Count
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-08-04 00:00:00
date_updated = 2026-08-04 00:00:00
category = Security
sub_category = Secure Infrastructure
tags = Cisco Meraki,Switching,Port Health,Root Cause Analysis
dispatch_context = Splunk_TA_cisco_meraki
dispatch_context_force = 0
default_viz = splunk.bar
description = <p>Ranks switch:port combinations by the number of unresolved Meraki Assurance alerts logged against them.</p>
explanation = <p>Queries the <code>meraki:assurancealerts</code> sourcetype, filters to unresolved alerts scoped to switch-family devices, extracts the switch name and port identifier from the alert's <code>scope.devices</code> field, and counts incidents per switch:port key. This identifies the specific worst-offending port - CRC errors, flaps, loops - rather than just the switch as a whole, giving a direct root-cause starting point.</p>
solution = <p>Treat ports at the top of the list as priority candidates for a cable/transceiver swap or a port shut/no-shut; if the same switch recurs across many different ports, escalate to a hardware/uplink investigation instead of a per-port fix.</p>
related_info = <ul><li>No equivalent switch-port-level ranking existed in the catalog before this stanza; prior switching panels report switch- or network-level counts only.</li></ul>
search = `index_meraki` sourcetype="meraki:assurancealerts"\
| eval org_id=tostring(organizationId)\
| eval network_id=tostring('network.id')\
| eval sev=lower(coalesce(alert_severity,severity,"info"))\
| eval device_type=lower(coalesce(deviceType,""))\
| eval resolved_flag=case(isnull(resolvedAt) OR resolvedAt="" OR resolvedAt="null",0,1=1,1)\
| where resolved_flag=0\
| where match(device_type,"switch")\
| eval switch_name=mvindex('scope.devices{}.name',0)\
| eval port_id=mvindex('scope.devices{}.portIdentifier',0)\
| eval key=switch_name . ":port" . port_id\
| stats count as incidents by key\
| head 10\
| table key incidents

[secure_networking_meraki_top_blocked_destinations]
search_name = Security - Meraki Top Blocked Destinations
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-08-04 00:00:00
date_updated = 2026-08-04 00:00:00
category = Security
sub_category = Secure Infrastructure
tags = Cisco Meraki,MX Security Appliance,Blocklist Triage,Threat Intelligence
dispatch_context = Splunk_TA_cisco_meraki
dispatch_context_force = 0
default_viz = splunk.bar
description = <p>Ranks destinations blocked by the Meraki MX security appliance, broken out by destination, category, and threat classification.</p>
explanation = <p>Queries the <code>meraki:organizationsecurity</code> sourcetype, filters to events where <code>action</code> is "blocked", and counts occurrences grouped by destination (<code>dest</code>/<code>destIp</code>), threat category, and classification. This is a distinct triage angle from the existing threat panels, which group only by category and severity without surfacing the actual destination being blocked.</p>
solution = <p>Cross-reference the top destinations against known-good business services to rule out false positives, then use the category/classification columns to prioritize genuine malicious destinations for a manual blocklist or upstream DNS-sinkhole entry.</p>
related_info = <ul><li>Complements <code>secure_networking_meraki_top_offending_clients</code> (client-side view) and <code>secure_networking_meraki_security_allowed_blocked_trend</code> (time view) for a full triage picture.</li></ul>
search = `index_meraki` sourcetype="meraki:organizationsecurity"\
| eval org_id=tostring(organizationId)\
| eval action=lower(action)\
| where action="blocked"\
| stats count as blocked by dest destIp category classification\
| head 15

