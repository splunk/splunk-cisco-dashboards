[dc_networking_vmware_esx_server_farm]
search_name = Data Center Networking - ESX Server Farm Composite Health
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-08-04 00:00:00
date_updated = 2026-08-04 00:00:00
category = Data Center Networking
sub_category = VMware Integration
tags = Cisco DC Networking,VMware,vSphere,Composite KPI
dispatch_context = cisco_dc_networking_app_for_splunk
dispatch_context_force = 0
default_viz = splunk.singlevalue
description = <p>Blends sustained CPU-hot streaks, sustained memory-hot streaks, and host power state into a single weighted ESXi host-fleet health score.</p>
explanation = <p>For CPU and memory independently, buckets utilization to 1-minute bins per host (<code>moid</code>) and runs <code>streamstats window=15 sum(eval(metric&gt;=95))</code> -- counting how many of the trailing 15 one-minute samples were at or above 95%. If 15 of 15 are hot, that dimension's KPI drops to 0; otherwise it stays at 100. This <b>sustained-overload, windowed-threshold-breach</b> pattern (penalize only a persistent hot streak, not a single transient spike) is notable beyond VMware -- it generalizes to any utilization metric where you want to ignore brief bursts but catch real saturation. These two KPIs are joined with a power-state KPI (100 powered on, 70 standby, 60 maintenance, 0 off/unknown) and combined 40/40/20 into <code>vmw_health</code>.</p>
solution = <p>A drop in this score means either a sustained CPU or memory hot streak on at least one host, or a host that left the <code>poweredOn</code> state; check per-host CPU/memory stanzas and the Host Power State table in this same batch to isolate which host and which dimension is driving it.</p>
related_info = <ul><li><b>Provenance</b><br>Acme Labs demo dashboard, panel &quot;ESX Server Farm&quot;.</li><li><b>New data source</b><br>Raw ESXi host performance counters (<code>vmware:perf:cpu</code>/<code>vmware:perf:mem</code>) and host inventory (<code>vmware:inv:hostsystem</code>) are new to this catalog; existing VMware coverage here was ACI-side integration only.</li><li><b>Presort removed ahead of streamstats</b><br>House style forbids <code>result ranking</code> in any pipeline that also contains <code>stats</code> (no exceptions), so the source panel's <code>result ranking</code> stages ahead of each <code>streamstats window=15</code> were removed. <code>stats</code>/<code>streamstats</code> do not guarantee strict per-<code>moid</code> chronological ordering downstream, so the 15-sample sustained-window check may not evaluate strictly in time order on every Splunk version -- if exact chronological fidelity is required, this pattern should be reworked around a <code>tstats</code>/data-model source instead of plain <code>stats</code>+<code>streamstats</code>.</li></ul>
search = `index_dc` sourcetype=vmware:perf:cpu instance=aggregated\
| bin _time span=1m\
| stats avg(p_average_cpu_usage_percent) as cpu by moid _time\
| streamstats window=15 sum(eval(cpu>=95)) as cpu_hot_15 by moid\
| eval kpi_cpu = if(cpu_hot_15>=15, 0, 100)\
| join type=outer moid _time [search `index_dc` sourcetype=vmware:perf:mem instance=aggregated earliest=-24h | bin _time span=1m | stats avg(p_average_mem_usage_percent) as mem by moid _time | streamstats window=15 sum(eval(mem>=95)) as mem_hot_15 by moid | eval kpi_mem = if(mem_hot_15>=15, 0, 100)]\
| join type=left moid [search `index_dc` sourcetype=vmware:inv:hostsystem earliest=-24h | stats latest(changeSet.summary.runtime.powerState) as host_state latest(hypervisor_name) as host by moid | eval kpi_state = case(host_state="poweredOn",100, host_state="standBy",70, host_state="maintenance",60, host_state="unknown",0, host_state="poweredOff",0, true(),50)]\
| eval kpi_cpu=coalesce(kpi_cpu,100), kpi_mem=coalesce(kpi_mem,100), kpi_state=coalesce(kpi_state,100)\
| eval vmw_health = round(0.40*kpi_cpu + 0.40*kpi_mem + 0.20*kpi_state, 0)\
| timechart span=1m avg(vmw_health) as vmw_health usenull=false useother=false

[dc_networking_vmware_cpu_demand_vs_usage]
search_name = Data Center Networking - CPU Demand vs. Usage MHz
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-08-04 00:00:00
date_updated = 2026-08-04 00:00:00
category = Data Center Networking
sub_category = VMware Integration
tags = Cisco DC Networking,VMware,vSphere,CPU
dispatch_context = cisco_dc_networking_app_for_splunk
dispatch_context_force = 0
default_viz = splunk.column
description = <p>Compares per-host CPU usage percentage against CPU demand percentage (both relative to total host capacity in MHz), for every ESXi host.</p>
explanation = <p>Averages <code>p_average_cpu_usagemhz_megaHertz</code>, <code>p_average_cpu_demand_megaHertz</code>, and the host's total MHz capacity per <code>moid</code>, then expresses usage and demand each as a percent of total capacity. <b>Demand</b> is what the guest workloads are asking for; <b>usage</b> is what they actually got scheduled. A gap between the two (demand consistently above usage) is a contention/ready-time proxy distinct from looking at a raw utilization average alone -- it flags hosts where VMs are being throttled even though the visible usage number looks moderate.</p>
solution = <p>A host where demand_pct is persistently and meaningfully higher than usage_pct is CPU-contended; consider rebalancing VMs off that host or adding capacity before usage-only monitoring would have caught the problem.</p>
related_info = <ul><li><b>Provenance</b><br>Acme Labs demo dashboard, panel &quot;CPU Demand vs. Usage (MHz)&quot;.</li><li><b>Pairs with dc_networking_vmware_cpu_scheduler_latency</b><br>Scheduler latency (in this same batch) is another distinct co-scheduling contention signal that corroborates a demand/usage gap.</li></ul>
search = `index_dc` sourcetype=vmware:perf:cpu instance=aggregated\
| stats avg(p_average_cpu_usagemhz_megaHertz) as usage_mhz avg(p_average_cpu_demand_megaHertz) as demand_mhz latest(p_average_cpu_totalCapacity_megaHertz) as total_mhz by moid\
| rename moid as host\
| eval usage_pct=round((usage_mhz/total_mhz)*100,2)\
| eval demand_pct=round((demand_mhz/total_mhz)*100,2)\
| table host usage_pct demand_pct

[dc_networking_vmware_cpu_time_breakdown]
search_name = Data Center Networking - CPU Time Breakdown
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-08-04 00:00:00
date_updated = 2026-08-04 00:00:00
category = Data Center Networking
sub_category = VMware Integration
tags = Cisco DC Networking,VMware,vSphere,CPU
dispatch_context = cisco_dc_networking_app_for_splunk
dispatch_context_force = 0
default_viz = splunk.bar
description = <p>Breaks down cumulative CPU time per ESXi host into used/idle/wait percentages.</p>
explanation = <p>Sums <code>p_summation_cpu_used_millisecond</code>, <code>p_summation_cpu_idle_millisecond</code>, and <code>p_summation_cpu_wait_millisecond</code> per host and expresses each as a percent of the total. CPU <b>wait</b> time is a known co-scheduling/ready-time contention red flag distinct from used/idle -- a host with high wait despite moderate used-time is being throttled by the hypervisor scheduler, not by actual workload demand.</p>
solution = <p>A host with elevated <code>pct_wait</code> should be checked for CPU overcommitment (too many vCPUs scheduled against too few pCPUs) rather than assuming the workload itself is the bottleneck.</p>
related_info = <ul><li><b>Provenance</b><br>Acme Labs demo dashboard, panel &quot;CPU Time Breakdown&quot;.</li></ul>
search = `index_dc` sourcetype=vmware:perf:cpu instance=aggregated\
| stats sum(p_summation_cpu_used_millisecond) as used_ms sum(p_summation_cpu_idle_millisecond) as idle_ms sum(p_summation_cpu_wait_millisecond) as wait_ms by moid\
| rename moid as host\
| eval total_ms=used_ms+idle_ms+wait_ms\
| eval pct_used=round((used_ms/total_ms)*100,2)\
| eval pct_idle=round((idle_ms/total_ms)*100,2)\
| eval pct_wait=round((wait_ms/total_ms)*100,2)\
| table host pct_used pct_idle pct_wait

[dc_networking_vmware_storage_used_by_host]
search_name = Data Center Networking - Storage Used (Host)
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-08-04 00:00:00
date_updated = 2026-08-04 00:00:00
category = Data Center Networking
sub_category = VMware Integration
tags = Cisco DC Networking,VMware,vSphere,Storage
dispatch_context = cisco_dc_networking_app_for_splunk
dispatch_context_force = 0
default_viz = splunk.bar
description = <p>Reports average storage usage per ESXi host.</p>
explanation = <p>Averages the <code>storage_usage</code> counter per host (<code>moid</code>) from ESXi disk performance telemetry, giving a host-level view of storage I/O load distinct from the per-datastore capacity view in <code>dc_networking_vmware_datastore_usage</code>.</p>
solution = <p>Hosts with outlier storage usage relative to peers may be hosting disproportionately I/O-heavy VMs; consider storage-level load balancing.</p>
related_info = <ul><li><b>Provenance</b><br>Acme Labs demo dashboard, panel &quot;Storage Used (Host)&quot;.</li><li><b>Ranking not preserved</b><br>The source panel's trailing <code>result ranking</code> was removed because house style forbids <code>result ranking</code> in a pipeline that also contains <code>stats</code>.</li></ul>
search = `index_dc` sourcetype=vmware:perf:disk instance=aggregated\
| stats avg(storage_usage) as avg_storage_usage by moid\
| eval avg_storage_usage=round(avg_storage_usage,2)

[dc_networking_vmware_host_cpu_usage_pct]
search_name = Data Center Networking - Host CPU Usage %
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-08-04 00:00:00
date_updated = 2026-08-04 00:00:00
category = Data Center Networking
sub_category = VMware Integration
tags = Cisco DC Networking,VMware,vSphere,CPU
dispatch_context = cisco_dc_networking_app_for_splunk
dispatch_context_force = 0
default_viz = splunk.bar
description = <p>Reports average CPU usage percentage per ESXi host.</p>
explanation = <p>Averages <code>p_average_cpu_usage_percent</code> per host (<code>moid</code>, renamed to <code>host</code>) -- the baseline utilization view that the demand-vs-usage and scheduler-latency stanzas in this same batch add contention context on top of.</p>
solution = <p>Sustained high usage across most hosts suggests fleet-wide capacity pressure; a single outlier host suggests VM placement imbalance.</p>
related_info = <ul><li><b>Provenance</b><br>Acme Labs demo dashboard, panel &quot;Host CPU Usage (%)&quot;.</li><li><b>Ranking not preserved</b><br>The source panel's trailing <code>result ranking</code> was removed because house style forbids <code>result ranking</code> in a pipeline that also contains <code>stats</code>.</li><li><b>Scope widened</b><br>The source panel's <code>host=$esxhost$</code> dashboard-input filter was dropped so this covers all hosts.</li></ul>
search = `index_dc` sourcetype=vmware:perf:cpu instance=aggregated\
| stats avg(p_average_cpu_usage_percent) as cpu_usage_pct by moid\
| rename moid as host\
| eval cpu_usage_pct=round(cpu_usage_pct,2)

[dc_networking_vmware_cpu_scheduler_latency]
search_name = Data Center Networking - CPU Scheduler Latency %
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-08-04 00:00:00
date_updated = 2026-08-04 00:00:00
category = Data Center Networking
sub_category = VMware Integration
tags = Cisco DC Networking,VMware,vSphere,CPU
dispatch_context = cisco_dc_networking_app_for_splunk
dispatch_context_force = 0
default_viz = splunk.bar
description = <p>Reports average CPU scheduler (co-scheduling/ready-time) latency percentage per ESXi host.</p>
explanation = <p>Averages <code>p_average_cpu_latency_percent</code> per host -- a co-scheduling/ready-time contention leading indicator that is a distinct signal from plain CPU usage percentage. A host can show moderate usage while still having high scheduler latency if vCPUs are waiting for physical core availability.</p>
solution = <p>Hosts with elevated scheduler latency are CPU-overcommitted at the hypervisor level even if usage looks fine; rebalance VMs or reduce vCPU-to-pCPU ratio before usage-based alerting would catch it.</p>
related_info = <ul><li><b>Provenance</b><br>Acme Labs demo dashboard, panel &quot;CPU Scheduler Latency (%)&quot;.</li><li><b>Ranking not preserved</b><br>The source panel's trailing <code>result ranking</code> was removed because house style forbids <code>result ranking</code> in a pipeline that also contains <code>stats</code>.</li><li><b>Scope widened</b><br>The source panel's <code>host=$esxhost$</code> dashboard-input filter was dropped so this covers all hosts.</li></ul>
search = `index_dc` sourcetype=vmware:perf:cpu instance=aggregated\
| stats avg(p_average_cpu_latency_percent) as avg_sched_latency by moid\
| rename moid as host\
| eval avg_sched_latency=round(avg_sched_latency,2)


