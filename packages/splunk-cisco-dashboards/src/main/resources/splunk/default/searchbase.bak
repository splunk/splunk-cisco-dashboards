[dc_networking_multi_pod_top_10_affected_leafs_by_health_score]
search_name = DC Networking - Multi Pod - Top 10 Affected Leafs by Health Score
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-07-30 00:00:00
date_updated = 2026-07-30 00:00:00
category = Data Center Networking
sub_category = ACI Fabric Health
tags = Cisco DC Networking,Cisco ACI
dispatch_context = cisco_dc_networking_app_for_splunk
dispatch_context_force = 0
default_viz = splunk.column
description = <p>Reports the 10 leaf switches with the lowest current health scores, bucketed by severity threshold, from the Cisco DC Networking <code>Multi Pod</code> dashboard.</p>
explanation = <p>Runs curated SPL from this app with app-owned index scoping and only the required exported source knowledge objects. Dashboard-only filters are neutralized so the search runs independently.</p>
solution = <p>Use the result to identify affected data-center entities and correlate changes with related operational events.</p>
related_info = <ul><li><b>Provenance</b><br><code>cisco_dc_networking_app_for_splunk</code> / <code>multi-pod.xml</code>.</li><li><b>Customize for sibling entities</b><br>Swap the node="*leaf*" wildcard for node="*spine*" to rank spine switches by health score instead.</li></ul>
search = | `apic-fabric-overview`\
| rex field=dn "topology\/(?<Pod>[^\/]+)"\
| search component=fabricNode node="*leaf*"\
| stats latest(CurrentHealth) AS "Health" by node, apic_host\
| eval "Health < 60" = case(Health < 60, Health)\
| eval "Health < 80" = case(Health >= 60 AND Health <80, Health)\
| eval "Health < 100" = case(Health >=80 AND Health <=100, Health)\
| eval Node= node.":".apic_host\
| table Node,"Health < 60","Health < 80","Health < 100",Health\
| fields - Health

