[dc_networking_power_device_power_current_summary_usage]
search_name = DC Networking - Power - Device Power - Current Summary Usage
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-07-30 00:00:00
date_updated = 2026-07-30 00:00:00
category = Data Center Networking
sub_category = Nexus 9000 Platform
tags = Cisco DC Networking,Cisco Nexus 9000
dispatch_context = cisco_dc_networking_app_for_splunk
dispatch_context_force = 0
default_viz = splunk.table
description = <p>Reports device power - current summary usage from the Cisco DC Networking <code>Power</code> dashboard.</p>
explanation = <p>Runs curated SPL from this app with app-owned index scoping and only the required exported source knowledge objects. Dashboard-only filters are neutralized so the search runs independently.</p>
solution = <p>Use the result to identify affected data-center entities and correlate changes with related operational events.</p>
related_info = <ul><li><b>Provenance</b><br><code>cisco_dc_networking_app_for_splunk</code> / <code>nexus9k_power_details.xml</code>.</li></ul>
search = `power_details`\
| stats latest(Total Power Capacity) AS "Total Power Capacity" latest(Total Power Allocated(budget)) AS "Total Power Allocated(budget)" latest(Total Power Input(actual draw)) AS "Total Power Input(actual draw)" latest(Total Power Output(actual draw)) AS "Total Power Output(actual draw)" latest(Power Supply redundancy mode (configured)) AS "Power Supply redundancy mode (configured)" latest(Power Supply redundancy mode (operational)) AS "Power Supply redundancy mode (operational)" by Hostname,Device

