[dc_networking_microsegmentation_contract_details_of_microsegmented_epgs]
search_name = DC Networking - Microsegmentation - Contract Details of MicroSegmented EPGs
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-07-30 00:00:00
date_updated = 2026-07-30 00:00:00
category = Data Center Networking
sub_category = ACI Tenant & Policy
tags = Cisco DC Networking,Cisco ACI
dispatch_context = cisco_dc_networking_app_for_splunk
dispatch_context_force = 0
default_viz = splunk.table
description = <p>Reports contract details of microsegmented epgs from the Cisco DC Networking <code>Microsegmentation</code> dashboard.</p>
explanation = <p>Runs curated SPL from this app with app-owned index scoping and only the required exported source knowledge objects. Dashboard-only filters are neutralized so the search runs independently.</p>
solution = <p>Use the result to identify affected data-center entities and correlate changes with related operational events.</p>
related_info = <ul><li><b>Provenance</b><br><code>cisco_dc_networking_app_for_splunk</code> / <code>micro_segmentation.xml</code>.</li></ul>
search = `index_dc` sourcetype="cisco:dc:aci:health" isAttrBasedEPg=yes\
| rex field=dn "uni\/tn-(?<Tenant>[^\/]+)"\
| rex field=dn "ap-(?<App>[^\/]+)"\
| rex field=dn "epg-(?<EPG>[^\/]+)"\
| stats count by Tenant, App, EPG\
| fields - count\
| join Tenant, App, EPG [search `index_dc` sourcetype="cisco:dc:aci:class" (component=fvRsCons OR component=fvRsProv) | rex field=dn "uni\/tn-(?<Tenant>[^\/]+)" | rex field=dn "ap-(?<App>[^\/]+)" | rex field=dn "epg-(?<EPG>[^\/]+)" | eval "Contract Type"=if(like(dn,"%rsprov%"),"Provided","Consumed") | stats count by Tenant, App, EPG, tnVzBrCPName, "Contract Type" | fields - count | rename tnVzBrCPName AS "Contract Name"]\
| table Tenant, App, EPG, "Contract Name", "Contract Type"

[dc_networking_microsegmentation_health_details_of_microsegmented_epgs_for_tenant]
search_name = DC Networking - Microsegmentation - Health Details of Microsegmented EPGs for Tenant
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-07-30 00:00:00
date_updated = 2026-07-30 00:00:00
category = Data Center Networking
sub_category = ACI Tenant & Policy
tags = Cisco DC Networking,Cisco ACI
dispatch_context = cisco_dc_networking_app_for_splunk
dispatch_context_force = 0
default_viz = splunk.table
description = <p>Reports health details of microsegmented epgs for tenant from the Cisco DC Networking <code>Microsegmentation</code> dashboard.</p>
explanation = <p>Runs curated SPL from this app with app-owned index scoping and only the required exported source knowledge objects. Dashboard-only filters are neutralized so the search runs independently.</p>
solution = <p>Investigate degraded or high-volume entities and correlate them with recent faults and configuration changes.</p>
related_info = <ul><li><b>Provenance</b><br><code>cisco_dc_networking_app_for_splunk</code> / <code>micro_segmentation.xml</code>.</li></ul>
search = | `apic-tenant-overview`\
| search component = "fvEPg" dn = "*/health"\
| stats values(ApplicationName) AS "App", values(TenantName) AS "Tenant" latest(health) AS "Health Score" sparkline(max(health),15m) AS "Health Trend" latest(EndPointGroupName) AS "EPG" by dn\
| join type=Inner Tenant, App, EPG [search `index_dc` sourcetype="cisco:dc:aci:health" component=fvAEPg isAttrBasedEPg="yes" | rex field=dn "uni\/tn-(?<Tenant>[^\/]+)" | rex field=dn "ap-(?<App>[^\/]+)" | rex field=dn "epg-(?<EPG>[^\/]+)" | stats count by Tenant, App, EPG | fields - count]\
| table Tenant, App, EPG, "Health Score", "Health Trend"

[dc_networking_microsegmentation_microsegmented_domains_vms_and_bare_metal]
search_name = DC Networking - Microsegmentation - Microsegmented Domains (VMs and Bare-Metal)
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-07-30 00:00:00
date_updated = 2026-07-30 00:00:00
category = Data Center Networking
sub_category = ACI Tenant & Policy
tags = Cisco DC Networking,Cisco ACI
dispatch_context = cisco_dc_networking_app_for_splunk
dispatch_context_force = 0
default_viz = splunk.table
description = <p>Reports microsegmented domains (vms and bare-metal) from the Cisco DC Networking <code>Microsegmentation</code> dashboard.</p>
explanation = <p>Runs curated SPL from this app with app-owned index scoping and only the required exported source knowledge objects. Dashboard-only filters are neutralized so the search runs independently.</p>
solution = <p>Use the result to identify affected data-center entities and correlate changes with related operational events.</p>
related_info = <ul><li><b>Provenance</b><br><code>cisco_dc_networking_app_for_splunk</code> / <code>micro_segmentation.xml</code>.</li></ul>
search = `index_dc` sourcetype="cisco:dc:aci:class" component = "fvRsDomAtt"\
| rex field=dn "uni\/tn-(?<Tenant>[^\/]+)"\
| rex field=dn "ap-(?<App>[^\/]+)"\
| rex field=dn "epg-(?<EPG>[^\/]+)"\
| eval domain_row=json_object("instrImedcy",instrImedcy,"resImedcy",resImedcy)\
| stats latest(domain_row) AS domain_row by Tenant, App, EPG, tCl, tDn\
| eval instrImedcy=json_extract(domain_row,"instrImedcy"), resImedcy=json_extract(domain_row,"resImedcy")\
| eval tDn= replace(tDn,"uni/","")\
| rename tCl AS "Domain Type" tDn AS "Domain Profile"\
| join Tenant, App, EPG [search `index_dc` sourcetype="cisco:dc:aci:health" component=fvAEPg isAttrBasedEPg="yes" | rex field=dn "uni\/tn-(?<Tenant>[^\/]+)" | rex field=dn "ap-(?<App>[^\/]+)" | rex field=dn "epg-(?<EPG>[^\/]+)" | stats count by Tenant, App, EPG | fields - count]\
| table Tenant, App, EPG, "Domain Type", "Domain Profile", instrImedcy,resImedcy\
| rename instrImedcy AS "Deploy Immedicay" resImedcy AS " Resolution Immediacy"

[dc_networking_microsegmentation_microsegmented_epg_details]
search_name = DC Networking - Microsegmentation - Microsegmented EPG details
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-07-30 00:00:00
date_updated = 2026-07-30 00:00:00
category = Data Center Networking
sub_category = ACI Tenant & Policy
tags = Cisco DC Networking,Cisco ACI
dispatch_context = cisco_dc_networking_app_for_splunk
dispatch_context_force = 0
default_viz = splunk.table
description = <p>Reports microsegmented epg details from the Cisco DC Networking <code>Microsegmentation</code> dashboard.</p>
explanation = <p>Runs curated SPL from this app with app-owned index scoping and only the required exported source knowledge objects. Dashboard-only filters are neutralized so the search runs independently.</p>
solution = <p>Use the result to identify affected data-center entities and correlate changes with related operational events.</p>
related_info = <ul><li><b>Provenance</b><br><code>cisco_dc_networking_app_for_splunk</code> / <code>micro_segmentation.xml</code>.</li></ul>
search = `index_dc` sourcetype="cisco:dc:aci:class" dn="uni/tn-*/ap-*/epg-*/crtrn/ipattr*" OR dn="uni/tn-*/ap-*/epg-*/crtrn/macattr*" OR dn="uni/tn-*/ap-*/epg-*/crtrn/vmattr-*"\
| rex field=dn "uni\/tn-(?<Tenant>[^\/]+)"\
| rex field=dn "ap-(?<App>[^\/]+)"\
| rex field=dn "epg-(?<EPG>[^\/]+)"\
| eval type=if(like(dn,"%ipattr%"),"IP address", type)\
| eval type=if(like(dn,"%macattr%"),"Mac address", type)\
| eval attrtype=if(like(dn,"%vmattr%"),"VM-based", "Network-based")\
| stats count by dn, Tenant, App, EPG, attrtype, type, name, mac, ip, value\
| fields - count\
| eval output=mvappend(ip,mac,value)\
| rename output AS "Filter Value" name AS "Filter Name" type AS "Filter Type" attrtype AS "Attribute Type"\
| fields - dn,mac,ip,value

[dc_networking_orchestrator_overview_site_location]
search_name = DC Networking - Orchestrator Overview - Site Location
search_author = akhamis
updated_author = akhamis
version = 1.0.0
date_created = 2026-07-30 00:00:00
date_updated = 2026-07-30 00:00:00
category = Data Center Networking
sub_category = Multi-Site Orchestrator
tags = Cisco DC Networking,Sites
dispatch_context = cisco_dc_networking_app_for_splunk
dispatch_context_force = 0
default_viz = splunk.table
description = <p>Reports site location from the Cisco DC Networking <code>Orchestrator Overview</code> dashboard.</p>
explanation = <p>Runs curated SPL from this app with app-owned index scoping and only the required exported source knowledge objects. Dashboard-only filters are neutralized so the search runs independently.</p>
solution = <p>Use the result to identify affected data-center entities and correlate changes with related operational events.</p>
related_info = <ul><li><b>Provenance</b><br><code>cisco_dc_networking_app_for_splunk</code> / <code>mso_overview.xml</code>.</li></ul>
search = `index_dc` sourcetype="cisco:dc:nd:mso" mso_api_endpoint=siteHealth\
| eval selection_key=printf("%020d:%020d:%s",floor(_time),_indextime,coalesce(_cd,""))\
| eventstats max(selection_key) AS winning_key by mso_site_id\
| where selection_key=winning_key\
| geostats latfield=location_lat longfield=location_long count\
| rename count as Count, latitude as Latitude, longitude as Longitude

[dc_networking_orchestrator_syslog_recent_ethernet_related_events]
