version = 1.0.0
date_created = 2026-07-30 00:00:00
date_updated = 2026-07-30 00:00:00
category = Data Center Networking
sub_category = Controller & Site Inventory
tags = Cisco DC Networking,Cisco Nexus 9000
dispatch_context = cisco_dc_networking_app_for_splunk
dispatch_context_force = 0
default_viz = splunk.table
description = <p>Reports power supply from the Cisco DC Networking <code>Physical Inventory</code> dashboard.</p>
explanation = <p>Runs curated SPL from this app with app-owned index scoping and only the required exported source knowledge objects. Dashboard-only filters are neutralized so the search runs independently.</p>
solution = <p>Use the result to identify affected data-center entities and correlate changes with related operational events.</p>
related_info = <ul><li><b>Provenance</b><br><code>cisco_dc_networking_app_for_splunk</code> / <code>inventory.xml</code>.</li><li><b>Customize for sibling entities</b><br>Swap the like(productid,"%-PAC%") filter for like(desc,"%Fan Module%") to inventory fan modules instead of power supplies.</li></ul>
search = `phy_inventory_details`\
| where like(productid,"%-PAC%")\
| table hostname,Device,name,desc,serialnum,productid\
| rename hostname as Hostname desc AS Description serialnum AS "Serial Number" productid AS "Product ID" name AS Name

