        "react-dom": "^19.2.6",
        "react-dnd": "^16.0.1",
        "react-dnd-html5-backend": "^16.0.1",
        "react-leaflet": "^4.2.1",
        "recharts": "^2.12.7",
        "styled-components": "^5.3.10",
        "tailwind-merge": "^2.5.4"
    },
