    "scripts": {
        "build": "node bin/build.js build",
        "clean": "node bin/build.js clean",
        "clean:build": "bash bin/clean_build.sh && node bin/build.js build",
        "package:app": "bash bin/package_app.sh",
        "pack:app": "node bin/build.js pack",
        "link:app": "node bin/build.js link",
        "unlink:app": "node bin/build.js unlink",
        "start": "webpack --watch",
        "typecheck": "tsc --noEmit",
        "eslint": "eslint src --ext \".js,.jsx,.ts,.tsx\"",
        "eslint:fix": "eslint src --ext \".js,.jsx,.ts,.tsx\" --fix",
        "stylelint": "stylelint \"src/**/*.{js,jsx,ts,tsx}\" --config stylelint.config.js",
        "lint": "yarn run eslint && yarn run stylelint && yarn run typecheck"
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^8.0.0",
